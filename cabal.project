packages:
    apps/*/*.cabal
    packages/*/*.cabal

constraints:
    base >= 4.19 && < 5,

package *
    ghc-options:
        -O2
        -rtsopts
        -threaded
        -with-rtsopts=-N
        -Wall

    split-sections: True

package crypton
    flags: +use_target_attributes

source-repository-package
    type:     git
    location: https://github.com/gev/glue.git
    tag:      5b3ba36937ca34205500ce4d11131affcbe2ef32
    subdir:   haskell/glue

source-repository-package
    type:     git
    location: https://github.com/gev/network.git
    tag:      297ea723ec5d2d30ad0512d613575ab8378cc50c
    post-checkout-command:   sh -c "autoreconf -i"

source-repository-package
    type:     git
    location: https://github.com/gev/crypton.git
    tag:      4d6622291383137e3dc5579204d3890e82c55a5f
