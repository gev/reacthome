packages:
    apps/*/*.cabal
    packages/*/*.cabal

constraints:
    base >= 4.19 && < 5,

package *
    ghc-options:
        -O2
        -rtsopts
        -threaded
        -with-rtsopts=-N
        -Wall

    split-sections: True

source-repository-package
    type:     git
    location: https://github.com/gev/glue.git
    tag:      051a444d008711d40e32b580c34b61e306c915fd
    subdir:   haskell/glue

source-repository-package
    type:     git
    location: https://github.com/gev/network.git
    tag:      297ea723ec5d2d30ad0512d613575ab8378cc50c
    post-checkout-command:   sh -c "autoreconf -i"
