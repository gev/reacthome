cabal-version: 3.8
name: reacthome-proxy
version: 0.1.0.0
synopsis: Reacthome Proxy
description: Reacthome Proxy Server between Legacy Daemon and new Reacthome Flow
license: BSD-3-Clause
author: ReactHome Team
maintainer: gazdovsky@gmail.com
category: Web
build-type: Simple

common common-options
  build-depends:
    base,
    stm,
    stm-containers,
    ws,

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    ImplicitParams
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards

library
  import:
    common-options

  -- cabal-gild: discover src
  exposed-modules:
    Reacthome.Proxy.App
    Reacthome.Proxy.Assets
    Reacthome.Proxy.Bridge.Cache
    Reacthome.Proxy.Bridge.Downstream
    Reacthome.Proxy.Bridge.Upstream
    Reacthome.Proxy.Config
    Reacthome.Proxy.Daemon
    Reacthome.Proxy.Daemon.Actions.Decode
    Reacthome.Proxy.Daemon.Actions.Encode
    Reacthome.Proxy.Discovery
    Reacthome.Proxy.Error
    Reacthome.Proxy.Glue.Controller
    Reacthome.Proxy.Glue.Dispatcher
    Reacthome.Proxy.Glue.Env
    Reacthome.Proxy.Glue.Evaluator
    Reacthome.Proxy.Glue.Lib.Actions
    Reacthome.Proxy.Glue.Lib.Actions.Dim
    Reacthome.Proxy.Glue.Lib.Actions.TurnOff
    Reacthome.Proxy.Glue.Lib.Actions.TurnOn
    Reacthome.Proxy.Glue.Lib.Vision
    Reacthome.Proxy.Glue.Lib.Vision.Download
    Reacthome.Proxy.Glue.Lib.Vision.Log
    Reacthome.Proxy.Glue.Lib.Vision.Subscribe
    Reacthome.Proxy.Glue.PubSub.Publisher
    Reacthome.Proxy.Glue.PubSub.Types
    Reacthome.Proxy.Glue.Store
    Reacthome.Proxy.Server
    Reacthome.Proxy.Sink

  build-depends:
    aeson,
    async,
    bytestring,
    containers,
    directory,
    discovery,
    filepath,
    fsnotify,
    glue,
    network,
    pubsub,
    scientific,
    text,
    time,
    unagi-chan,
    uuid,
    vector,

  hs-source-dirs: src

executable reacthome-proxy
  import:
    common-options

  build-depends:
    reacthome-proxy

  hs-source-dirs: app
  main-is: Main.hs
