(module panel.home
    (export home-panel)

    (import lib.data)
    (import layout.site)

    (def (project props)
        (select site-layout props.project)
    )

    (def (daemon args)
        (select project args.id)
    )

    (def (index-route home args)
        (def id (concat "proxy." home.id))
        (route
            :screen (daemon :id id)
        )
    )

    (def (site-panel args)
        (select site-layout args.id)
    )

    (def (site-route args)
        (route
            :screen (site-panel args)
        )
    )

    (def (home-panel home args)
        (navigator
            :routes (
                :index (index-route home)
                :site site-route
            )
        )
    )

)
