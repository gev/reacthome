(module panel.home
    (export home-panel)

    (import panel.daemon)
    (import panel.site)

    (def (daemon-route home args)
        (def id (concat "proxy." home.id))
        (route
            :screen (daemon-panel :id id)
        )
    )

    (def (site-route args)
        (route
            :screen (site-panel args)
        )
    )

    (def (home-panel home args)
        (navigator
            :routes (
                :index (daemon-route home)
                :site site-route
            )
        )
    )

)
