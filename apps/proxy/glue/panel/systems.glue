(module  panel.systems
    (export systems-panel)

    (import lib.i18n)
    (import i18n.dict)
    (import layout.screen)

    (def (systems-panel args)
        (screen-layout
            :body (center
                :child (text
                    :text (select-locale i18n-systems)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )

)
