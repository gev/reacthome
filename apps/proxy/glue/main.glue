(module main
    (export main)

    (import screen.home)
    (import screen.project)
    (import screen.site)
    (import screen.light-dimmer)
    (import screen.curtain)
    (import screen.curtain-demo)

    (def (home-route args)
        (route
            :screen (home-screen :title "Test a Canvas!")
        )
    )

    (def (project-route args)
        (route
            :screen (project-screen 'proxy.b9b35b14-2d39-492c-ae72-48adfef50b8e)
        )
    )

    (def (site-route args)
        (route
            :screen (site-screen args)
        )
    )

    (def (light-dimmer-route args)
        (overlay-route
            :tag args.id
            :screen (light-dimmer-screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def (positioned-curtain-route args)
        (overlay-route
            :tag args.id
            :screen (positioned-curtain-screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def (non-positioned-curtain-route args)
        (overlay-route
            :tag args.id
            :screen (non-positioned-curtain-screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def main
        (app
            :seed-color colors.pink
            :dynamic-scheme-variant dynamic-scheme-variant.fruit-salad
            :routes (
                :home project-route
                :site site-route
                :light-dimmer light-dimmer-route
                :positioned-curtain positioned-curtain-route
                :non-positioned-curtain non-positioned-curtain-route
            )
        )
    )
)
