(module main
    (export main)

    (import lib.navigation)

    (import screen.project)
    (import screen.settings)
    (import screen.camera)
    (import screen.light-regulator)
    (import screen.curtain-regulator)
    (import screen.regulator)

    (def (overlay screen args)
        (overlay-route
            :tag args.id
            :screen (screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def (project-route props args)
        (route
            :screen (project-screen props args)
        )
    )

    (def (settings-route props args)
        (route
            :screen (settings-screen props)
        )
    )

    (def camera-route
        (overlay camera-screen)
    )

    (def light-regulator-route
        (overlay light-regulator-screen)
    )

    (def positioned-curtain-regulator-route
        (overlay positioned-curtain-regulator-screen)
    )

    (def non-positioned-curtain-regulator-route
        (overlay non-positioned-curtain-regulator-screen)
    )

    (def temperature-regulator-route
        (overlay temperature-regulator-screen)
    )

    (def humidity-regulator-route
        (overlay humidity-regulator-screen)
    )

    (def ventilation-regulator-route
        (overlay ventilation-regulator-screen)
    )

    (def (main home)
        (def props (:home home))
        (app
            :navigator-key applet
            :seed-color colors.indigo
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :routes (
                :index (project-route props)
                :settings (settings-route props)
                :camera camera-route
                :light-regulator light-regulator-route
                :positioned-curtain-regulator positioned-curtain-regulator-route
                :non-positioned-curtain-regulator non-positioned-curtain-regulator-route
                :temperature-regulator temperature-regulator-route
                :humidity-regulator humidity-regulator-route
                :ventilation-regulator ventilation-regulator-route
            )
        )
    )
)
