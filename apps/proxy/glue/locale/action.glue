(module locale.action
    (export
        turn-on'
        turn-off'
        close'
        open'
        stop'
    )

    (def turn-on' (
            :en "Turn on"
            :ru "Включить"
        ))

    (def turn-off' (
            :en "Turn off"
            :ru "Выключить"
        ))

    (def open' (
            :en "Open"
            :ru "Открыть"
        ))

    (def close' (
            :en "Close"
            :ru "Закрыть"
        ))

    (def stop' (
            :en "Stop"
            :ru "Остановить"
        ))
)
