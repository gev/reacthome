(module api
    (export
        ring
        candidate
        watch
    )

    (import lib.action)
    (import lib.navigation)

    (def (ring id)
        (push
            :target applet-navigator
            :route 'ring
            :id id
        )
    )

    (def (watch props)
        (await
            (lambda (answer)
                (webrtc-start (
                        :session_id props.session_id
                        :handle_id props.handle_id
                        :jsep answer.description
                    )
                )
                (listen
                    (lambda (candidate)
                        (webrtc-candidate
                            :session_id props.session_id
                            :handle_id props.handle_id
                            :candidate candidate
                        )
                    )
                    answer.candidates
                )
            )
            (webrtc-accept props.url props.jsep)
        )
    )

    (def (candidate props)
        (print props)
        (webrtc-add-candidate props.url props.jsep)
    )
)
