(module api
    (export
        ring
        watch
    )

    (import lib.navigation)

    (def (ring id)
        (push
            :target applet-navigator
            :route 'ring
            :id id
        )
    )

    (def (watch props)
        (await
            (lambda (answer)
                (print answer)
                (webrtc-start
                    :session_id props.session_id
                    :handle_id props.handle_id
                    :offer answer.description
                )
                (listen
                    (lambda (candidate)
                        (webrtc-candidate
                            :session_id props.session_id
                            :handle_id props.handle_id
                            :candidate candidate
                        )
                    )
                    answer.candidates
                )
            )
            (webrtc-accept props.url props.offer)
        )
    )
)
