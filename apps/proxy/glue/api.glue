(module api
    (export
        ring
        candidate
        watch
    )

    (import lib.action)
    (import lib.navigation)

    (def (ring id)
        (push
            :target applet-navigator
            :route 'ring
            :id id
        )
    )

    (def (watch props)
        (await
            (lambda (answer)
                (webrtc-start (
                        :session_id props.session_id
                        :handle_id props.handle_id
                        :jsep answer.description
                    ))
            )
            (webrtc-accept
                :session props.url
                :offer props.jsep
                :on-candidate (lambda (candidate)
                    (webrtc-candidate
                        :session_id props.session_id
                        :handle_id props.handle_id
                        :candidate candidate
                    )
                )
            )
        )
    )

    (def (candidate props)
        (webrtc-add-candidate
            :session props.url
            :candidate props.candidate
        )
    )
)
