(module lib.combinator
    (export Y Z)

    (def Y
        (lambda (f)
            ((lambda (x) (f (x x)))
                (lambda (x) (f (x x))))))

    (def Z
        (lambda (f)
            ((lambda (x) (f (lambda (v) ((x x) v))))
                (lambda (x) (f (lambda (v) ((x x) v)))))))

    (def fact-gen
        (lambda (rec)
            (lambda (n)
                (if (== n 0)
                    1
                    (* n (rec (- n 1)))))))

    (def factorial (Y fact-gen))
)
