                :appearance (whole-day-night weather-theme.heavy-rainy)
            )
            (
                :code 504
                :description i18n-weather-conditions.rain-extreme
                :appearance (whole-day-night weather-theme.heavy-rainy)
            )
            (
                :code 511
                :description i18n-weather-conditions.freezing-rain
                :appearance (whole-day-night weather-theme.heavy-rainy)
            )
            (
                :code 520
                :description i18n-weather-conditions.shower-rain-light
                :appearance (whole-day-night weather-theme.light-rainy)
            )
            (
                :code 521
                :description i18n-weather-conditions.shower-rain
                :appearance (whole-day-night weather-theme.middle-rainy)
            )
            (
                :code 522
                :description i18n-weather-conditions.shower-rain-heavy
                :appearance (whole-day-night weather-theme.heavy-rainy)
            )
            (
                :code 531
