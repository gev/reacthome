    (def (day? time props)
        (&& (> time props.sunrise) (< time props.sunset))
    )

    (def (by-code code condition)
        (== condition.code code)
    )

    (def (weather props)
        (def time (* props.dt 1000))
        (def weather (head props.weather))
        (def condition (find (by-code weather.id) weather-conditions))
        (
            :time time
            :feels-like props.main.feels_like
            :temperature props.main.feels_like
            :humidity props.main.humidity
            :pressure props.main.pressure
            :wind props.wind
            :sunset props.sys.sunset
            :sunrise props.sys.sunrise
            :visibility props.visibility
            :description condition.description
            :type (? (day? time props.sys)
                condition.type.day condition.type.night)
        )
    )
)
