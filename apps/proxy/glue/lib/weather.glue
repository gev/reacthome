            )
            (
                :code 620
                :description i18n-weather-conditions.snow-shower-light
                :appearance (whole-day-night weather-theme.light-snow)
            )
            (
                :code 621
                :description i18n-weather-conditions.snow-shower
                :appearance (whole-day-night weather-theme.middle-snow)
            )
            (
                :code 622
                :description i18n-weather-conditions.snow-shower-heavy
                :appearance (whole-day-night weather-theme.heavy-snow)
            )

            (
                :code 701
                :description i18n-weather-conditions.mist
                :appearance (whole-day-night weather-theme.hazy)
            )
            (
                :code 711
                :description i18n-weather-conditions.smoke
                :appearance (whole-day-night weather-theme.dusty)
            )
            (
                :code 721
                :description i18n-weather-conditions.haze
                :appearance (whole-day-night weather-theme.hazy)
            )
            (
                :code 731
                :description i18n-weather-conditions.dust-whirls
                :appearance (whole-day-night weather-theme.dusty)
            )
            (
                :code 741
                :description i18n-weather-conditions.fog
                :appearance (whole-day-night weather-theme.foggy)
            )
            (
                :code 751
                :description i18n-weather-conditions.sand
                :appearance (whole-day-night weather-theme.dusty)
            )
            (
                :code 761
                :description i18n-weather-conditions.dust
                :appearance (whole-day-night weather-theme.dusty)
            )
            (
                :code 762
                :description i18n-weather-conditions.volcanic-ash
                :appearance (whole-day-night weather-theme.dusty)
            )
            (
                :code 771
                :description i18n-weather-conditions.squalls
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 781
                :description i18n-weather-conditions.tornado
                :appearance (whole-day-night weather-theme.thunder)
            )

            (
                :code 800
                :description i18n-weather-conditions.sky-clear
                :appearance (:day weather-theme.sunny :night weather-theme.sunny-night)
            )

            (
                :code 801
                :description i18n-weather-conditions.clouds-few
                :appearance (:day weather-theme.cloudy :night weather-theme.cloudy-night)
            )
            (
                :code 802
                :description i18n-weather-conditions.clouds-scattered
                :appearance (:day weather-theme.cloudy :night weather-theme.cloudy-night)
            )
            (
                :code 803
                :description i18n-weather-conditions.clouds-broken
                :appearance (:day weather-theme.cloudy :night weather-theme.cloudy-night)
            )
            (
                :code 804
                :description i18n-weather-conditions.clouds-overcast
                :appearance (whole-day-night weather-theme.overcast)
            )
        ))
    
    (def (day? time props)
        (&& (> time props.sunrise) (< time props.sunset))
    )

    (def (by-code code condition)
        (== condition.code code)
    )

    (def (weather props)
        (def time (* props.dt 1000))
        (def weather (head props.weather))
        (def condition (find (by-code weather.id) weather-conditions))
        (
            :time time
            :feels-like props.main.feels_like
            :temperature props.main.feels_like
            :humidity props.main.humidity
            :pressure props.main.pressure
            :wind props.wind
            :sunset props.sys.sunset
            :sunrise props.sys.sunrise
            :visibility props.visibility
            :description condition.description
            :appearance (? (day? time props.sys)
                condition.appearance.day condition.appearance.night)
        )
    )
)
