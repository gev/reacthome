            )
            (
                :code 301
                :description i18n-weather-conditions.drizzle
                :appearance (whole-day-night weather-theme.light-rainy)
            )
            (
                :code 302
                :description i18n-weather-conditions.drizzle-heavy
                :appearance (whole-day-night weather-theme.middle-rainy)
            )
            (
                :code 310
