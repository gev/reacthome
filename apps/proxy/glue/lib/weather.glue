(module  lib.weather
    (export weather)

    (import i18n.weather)

    (def dark colors.black)
    (def light colors.white)

    (def weather-theme (
            :sunny (
                :background weather-type.sunny
                :foreground dark
            )
            :sunny-night (
                :background weather-type.sunny
                :foreground dark
            )
            :cloudy (
                :background weather-type.cloudy
                :foreground dark
            )
            :cloudy-night (
                :background weather-type.cloudy-night
                :foreground light
            )
            :light-rainy (
                :background weather-type.light-rainy
                :foreground light
            )
            :middle-rainy (
                :background weather-type.middle-rainy
                :foreground light
            )
            :heavy-rainy (
                :background weather-type.heavy-rainy
                :foreground light
            )
            :light-snow (
                :background weather-type.light-snow
                :foreground dark
            )
            :middle-snow (
                :background weather-type.middle-snow
                :foreground dark
            )
            :heavy-snow (
                :background weather-type.heavy-snow
                :foreground dark
            )
            :thunder (
                :background weather-type.thunder
                :foreground light
            )
            :overcast (
                :background weather-type.overcast
                :foreground dark
            )
            :foggy (
                :background weather-type.foggy
                :foreground dark
            )
            :hazy (
                :background weather-type.hazy
                :foreground dark
            )
            :dusty (
                :background weather-type.dusty
                :foreground dark
            )
        ))

    (def (whole-day-night theme)
        (:day theme :night theme)
    )

    (def weather-conditions (
            (
                :code 200
                :description i18n-weather-conditions.thunderstorm-light-rain
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 201
                :description i18n-weather-conditions.thunderstorm-rain
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 202
                :description i18n-weather-conditions.thunderstorm-heavy-rain
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 210
                :description i18n-weather-conditions.thunderstorm-light
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 211
                :description i18n-weather-conditions.thunderstorm
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 212
                :description i18n-weather-conditions.thunderstorm-heavy
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 221
                :description i18n-weather-conditions.thunderstorm-ragged
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 230
                :description i18n-weather-conditions.thunderstorm-light-drizzle
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 231
                :description i18n-weather-conditions.thunderstorm-drizzle
                :appearance (whole-day-night weather-theme.thunder)
            )
            (
                :code 232
                :description i18n-weather-conditions.thunderstorm-heavy-drizzle
                :appearance (whole-day-night weather-theme.thunder)
            )

            (
                :code 300
                :description i18n-weather-conditions.drizzle-light
