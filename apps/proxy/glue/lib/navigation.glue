(module lib.navigation
    (export
        applet-navigator
        project-navigator
        back
        back-root
        go
        go-root
        go-site
    )

    (import lib.indexed-screens)

    (def applet-navigator global-key)
    (def project-navigator global-key)

    (def back
        (\ ()
            (pop _)
        )
    )
 
    (def back-root
        (\ ()
            (pop-root _)
        )
    )
 
    (def (go route)
        (\ ()
            (jump-or-push route)
        )
    )

    (def (go-root route)
        (\ ()
            (jump-or-push-root route)
        )
    )

    (def (go-site props)
        (\ ()
            (if (exists? props.parent)
                (jump-or-push
                    :target project-navigator
                    :route 'site
                    :id props.id
                )
                (jump-or-push
                    :target project-navigator
                    :route 'index
                )
            )
            (project-screens.select-screen 1)
        )
    )
)
