(module lib.navigation
    (export
        applet-navigator
        project-navigator
        back
        back-root
        go
        go-root
    )

    (def applet-navigator global-key)
    (def project-navigator global-key)

    (def back
        (\ ()
            (pop _)
        )
    )
 
    (def back-root
        (\ ()
            (pop-root _)
        )
    )
 
    (def (go route)
        (\ ()
            (push route)
        )
    )

    (def (go-root route)
        (\ ()
            (push-root route)
        )
    )
)
