(module lib.conversion
    (export
        to-absolute
        from-absolute
        
        to-percents
        from-percents

        round-to-resolution
    )

    (def (from-absolute val)
        (if (exists? val)
            (round (* val 255))
        )
    )

    (def (to-absolute val)
        (if (exists? val)
            (/ val 255)
        )
    )

    (def (from-percents val)
        (if (exists? val)
            (round (* val 2.55))
        )
    )

    (def (to-percents val)
        (if (exists? val)
            (round (/ val 2.55))
        )
    )

    (def (round-to-resolution val res)
        (if (exists? val)
            (if (> res 0)
                (if (< res 1)
                    (let
                        (def frac (/ 1 res))
                        (/ (round (* val frac)) frac)
                    )
                    (round (* (round (/ val res)) res))
                )
                val
            )
        )
    )
)
