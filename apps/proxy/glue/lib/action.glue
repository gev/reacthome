(module lib.action
    (export
        turn-on
        turn-off
        toggle-on-off
        dim
        set-temperature-setpoint
        set-humidity-setpoint
        set-co2-setpoint
        start
        stop
        toggle-start-stop
        start-cool
        stop-cool
        toggle-cool
        set-cool-intensity
        start-heat
        stop-heat
        toggle-heat
        set-heat-intensity
        start-wet
        stop-wet
        toggle-wet
        start-dry
        stop-dry
        toggle-dry
        start-ventilation
        stop-ventilation
        toggle-ventilation
        set-ventilation-intensity
        set-min-max-setpoint
        set-multiroom-zone-source
        reset-leakage
        run-script
        webrtc-watch
        webrtc-start
        webrtc-candidate
        webrtc-keep-alive
    )

    (def (simple-action action it)
        (post (# action it))
    )

    (def (simple-callback action it)
        (\ ()
            (post (# action it))
        )
    )

    (def (value-callback action uid)
        (\ (value)
            (post (# action uid value))
        )
    )

    (def (toggle-callback true-callback false-callback uid)
        (\ (value)
            (def action (? value true-callback false-callback))
            (post (# action uid))
        )
    )

    (def (min-max-callback action uid)
        (\ (value)
            (post (# action uid (- value 5) (+ value 5)))
        )
    )

    (def turn-on (simple-callback 'turn-on))
    (def turn-off (simple-callback 'turn-off))
    (def toggle-on-off (toggle-callback 'turn-on 'turn-off))

    (def dim (value-callback 'dim))
    
    (def set-temperature-setpoint (value-callback 'set-temperature-setpoint))
    (def set-humidity-setpoint (value-callback 'set-humidity-setpoint))
    (def set-co2-setpoint (value-callback 'set-co2-setpoint))

    (def start-cool (simple-callback 'start-cool))
    (def stop-cool (simple-callback 'stop-cool))
    (def toggle-cool (toggle-callback 'start-cool 'stop-cool))
    (def set-cool-intensity (value-callback 'set-cool-intensity))

    (def start (simple-callback 'start))
    (def stop (simple-callback 'stop))
    (def toggle-start-stop (toggle-callback 'start 'stop))

    (def start-heat (simple-callback 'start-heat))
    (def stop-heat (simple-callback 'stop-heat))
    (def toggle-heat (toggle-callback 'start-heat 'stop-heat))
    (def set-heat-intensity (value-callback 'set-heat-intensity))

    (def start-wet (simple-callback 'start-wet))
    (def stop-wet (simple-callback 'stop-wet))
    (def toggle-wet (toggle-callback 'start-wet 'stop-wet))

    (def start-dry (simple-callback 'start-dry))
    (def stop-dry (simple-callback 'stop-dry))
    (def toggle-dry (toggle-callback 'start-dry 'stop-dry))

    (def start-ventilation (simple-callback 'start-ventilation))
    (def stop-ventilation (simple-callback 'stop-ventilation))
    (def toggle-ventilation (toggle-callback 'start-ventilation 'stop-ventilation))
    (def set-ventilation-intensity (value-callback 'set-ventilation-intensity))

    (def set-min-max-setpoint (min-max-callback 'set-min-max-setpoint))
    (def set-multiroom-zone-source (value-callback 'set-multiroom-zone-source))
    (def reset-leakage (simple-callback 'reset-leakage))
    (def run-script (simple-callback 'run-script))

    (def webrtc-watch (simple-callback 'webrtc-watch))
    (def webrtc-start (simple-action 'webrtc-start))
    (def webrtc-candidate (simple-action 'webrtc-candidate))
    (def webrtc-keep-alive (simple-callback 'webrtc-keep-alive))
)
