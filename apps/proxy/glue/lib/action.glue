(module lib.action
    (export
        turn-on
        turn-off
        toggle-on-off
        dim
        set-temperature-setpoint
        set-humidity-setpoint
        set-co2-setpoint
        start
        stop
        toggle-start-stop
        start-cool
        stop-cool
        toggle-cool
        set-cool-intensity
        start-heat
        stop-heat
        toggle-heat
        set-heat-intensity
        start-wet
        stop-wet
        toggle-wet
        start-dry
        stop-dry
        toggle-dry
        start-ventilation
        stop-ventilation
        toggle-ventilation
        set-ventilation-intensity
        set-min-max-setpoint
        set-multiroom-zone-source
        run-script
    )

    (def (simple-action action uid)
        (\ ()
            (post (# action uid))
        )
    )

    (def (value-action action uid)
        (\ (value)
            (post (# action uid value))
        )
    )

    (def (toggle-action true-action false-action uid)
        (\ (value)
            (def action (? value true-action false-action))
            (post (# action uid))
        )
    )

    (def (min-max-action action uid)
        (\ (value)
            (post (# action uid (- value 5) (+ value 5)))
        )
    )

    (def turn-on (simple-action 'turn-on))
    (def turn-off (simple-action 'turn-off))
    (def toggle-on-off (toggle-action 'turn-on 'turn-off))

    (def dim (value-action 'dim))
    
    (def set-temperature-setpoint (value-action 'set-temperature-setpoint))
    (def set-humidity-setpoint (value-action 'set-humidity-setpoint))
    (def set-co2-setpoint (value-action 'set-co2-setpoint))

    (def start-cool (simple-action 'start-cool))
    (def stop-cool (simple-action 'stop-cool))
    (def toggle-cool (toggle-action 'start-cool 'stop-cool))
    (def set-cool-intensity (value-action 'set-cool-intensity))

    (def start (simple-action 'start))
    (def stop (simple-action 'stop))
    (def toggle-start-stop (toggle-action 'start 'stop))

    (def start-heat (simple-action 'start-heat))
    (def stop-heat (simple-action 'stop-heat))
    (def toggle-heat (toggle-action 'start-heat 'stop-heat))
    (def set-heat-intensity (value-action 'set-heat-intensity))

    (def start-wet (simple-action 'start-wet))
    (def stop-wet (simple-action 'stop-wet))
    (def toggle-wet (toggle-action 'start-wet 'stop-wet))

    (def start-dry (simple-action 'start-dry))
    (def stop-dry (simple-action 'stop-dry))
    (def toggle-dry (toggle-action 'start-dry 'stop-dry))

    (def start-ventilation (simple-action 'start-ventilation))
    (def stop-ventilation (simple-action 'stop-ventilation))
    (def toggle-ventilation (toggle-action 'start-ventilation 'stop-ventilation))
    (def set-ventilation-intensity (value-action 'set-ventilation-intensity))

    (def set-min-max-setpoint (min-max-action 'set-min-max-setpoint))
    (def set-multiroom-zone-source (value-action 'set-multiroom-zone-source))
    (def run-script (simple-action 'run-script))
)
