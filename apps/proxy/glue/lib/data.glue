(module lib.data
    (export
        select
        select-collection
        title
    )

    (def (select go key)
        (def (handle value)
            (if (exists? value)
                (go value)
                (sized-box :width 0 :height 0)
            )
        )
        (listen handle (remote-persistent-state key))
    )

    (def (select-collection go keys)
        (if (exists? keys)
            (map (select go) keys)
        )
    )

    (def (title props)
        (?? props.title props.code)
    )
)
