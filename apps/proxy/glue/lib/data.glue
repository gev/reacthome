(module lib.data
    (export view title)

    (def (view go key)
        (def (handle value)
            (if (is-exist value)
                (go value)
                (sized-box :width 0 :height 0)
            )
        )
        (render handle (remote-persistent-state key))
    )

    (def (title props)
        (?? props.title props.code)
    )
)
