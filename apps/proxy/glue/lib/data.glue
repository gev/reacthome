(module lib.data
    (export
        title
        transform
        view
    )

    (def (title props)
        (?? props.title props.code)
    )

    (def (transform go key)
        (react go (remote-persistent-state key))
    )

    (def (view go key)
        (def (handle value)
            (if (is-exist value)
                (go value)
                (sized-box :width 0 :height 0)
            )
        )
        (render handle (remote-persistent-state key))
    )
)
