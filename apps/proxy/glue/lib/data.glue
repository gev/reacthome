(module lib.data
    (export select-from select select-bind)

    (def (select-from source go key)
        (listen (lookup source key) go)
    )

    (def select
        (select-from store.persistent)
    )

    (def (select-bind go key)
        (def (bind props)
            (select (go props) props.bind)
        )
        (select bind key)
    )
)
