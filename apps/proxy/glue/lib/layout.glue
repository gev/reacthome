(module lib.layout
    (export select-layout)

    (def wc 280)
    (def xs (+ wc wc))
    (def sm (+ xs wc))
    (def md (+ sm wc))
    (def lg (+ md wc))
    (def xl (+ lg wc))

    (def (select-breakpoint breakpoints constraints)
        (def breakpoint
            (if (< constraints.width wc)
                (?? breakpoints.xxs breakpoints.xs)
                (if (< constraints.width xs)
                    breakpoints.xs
                    (if (< constraints.width sm)
                        breakpoints.sm
                        (if (< constraints.width md)
                            breakpoints.md
                            (if (< constraints.width lg)
                                breakpoints.lg
                                (if (< constraints.width xl)
                                    breakpoints.xl
                                    (?? breakpoints.xxl breakpoints.xl)
                                )
                            )
                        )
                    )
                )
            )
        )
        (if (exists? breakpoint)
            (breakpoint constraints)
        )
    )

    (def (select-layout breakpoints)
        (layout
            (select-breakpoint breakpoints)
        )
    )
)
