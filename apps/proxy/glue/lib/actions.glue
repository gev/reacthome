(module lib.actions
    (export
        dim
        dim-curtain
        turn-on
        turn-off
    )

    (import lib.conversions)

    (def (dim uid)
        (\ (value)
            (post ('dim uid (from-percents value)))
        )
    )
    
    (def (dim-curtain uid)
        (\ (value)
            (post ('dim uid (from-absolute value)))
        )
    )
    
    (def (turn-on uid)
        (\ ()
            (post ('on uid))
        )
    )

    (def (turn-off uid)
        (\ ()
            (post ('off uid))
        )
    )

)
