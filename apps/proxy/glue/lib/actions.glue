(module lib.actions
    (export
        dim
        turn-on
        turn-off

        to-percents
        from-percents
    )

    (def (from-percents value) (round (* value 2.55)))
    (def (to-percents value) (round (/ value 2.55)))

    (def (dim uid)
        (\ (value)
            (post ('dim uid (from-percents value)))
        )
    )
    
    (def (turn-on uid)
        (\ ()
            (post ('on uid))
        )
    )

    (def (turn-off uid)
        (\ ()
            (post ('off uid))
        )
    )

)
