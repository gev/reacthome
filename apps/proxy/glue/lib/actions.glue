(module lib.actions
    (export
        turn-on
        turn-off
        toggle-on-off
        dim
        set-temperature-setpoint
        set-humidity-setpoint
        set-co2-setpoint
        start
        stop
        toggle-start-stop
        set-intensity
        start-cool
        stop-cool
        toggle-cool
        set-cool-intensity
        start-heat
        stop-heat
        toggle-heat
        set-heat-intensity
        start-wet
        stop-wet
        toggle-wet
        start-dry
        stop-dry
        toggle-dry
        start-ventilation
        stop-ventilation
        toggle-ventilation
        set-ventilation-intensity
    )

    (def (state-action action uid)
        (\ ()
            (post (# action uid))
        )
    )

    (def (value-action action uid)
        (\ (value)
            (post (# action uid value))
        )
    )

    (def (toggle-action true-action false-action uid)
        (\ (value)
            (post ((if value true-action false-action) uid))
        )
    )

    (def turn-on (state-action 'turn-on))
    (def turn-off (state-action 'turn-off))
    (def toggle-on-off (toggle-action 'turn-on 'turn-off))

    (def dim (value-action 'dim))
    
    (def set-temperature-setpoint (value-action 'set-temperature-setpoint))
    (def set-humidity-setpoint (value-action 'set-humidity-setpoint))
    (def set-co2-setpoint (value-action 'set-co2-setpoint))

    (def start-cool (state-action 'start-cool))
    (def stop-cool (state-action 'stop-cool))
    (def toggle-cool (toggle-action 'start-cool 'stop-cool))
    (def set-cool-intensity (value-action 'set-cool-intensity))

    (def start (state-action 'start))
    (def stop (state-action 'stop))
    (def toggle-start-stop (toggle-action 'start 'stop))

    (def set-intensity (value-action 'set-intensity))

    (def start-heat (state-action 'start-heat))
    (def stop-heat (state-action 'stop-heat))
    (def toggle-heat (toggle-action 'start-heat 'stop-heat))
    (def set-heat-intensity (value-action 'set-heat-intensity))

    (def start-wet (state-action 'start-wet))
    (def stop-wet (state-action 'stop-wet))
    (def toggle-wet (toggle-action 'start-wet 'stop-wet))

    (def start-dry (state-action 'start-dry))
    (def stop-dry (state-action 'stop-dry))
    (def toggle-dry (toggle-action 'start-dry 'stop-dry))

    (def start-ventilation (state-action 'start-ventilation))
    (def stop-ventilation (state-action 'stop-ventilation))
    (def toggle-ventilation (toggle-action 'start-ventilation 'stop-ventilation))
    (def set-ventilation-intensity (value-action 'set-ventilation-intensity))
)
