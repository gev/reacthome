(module lib.property
    (export
        light
        curtains
        temperature
        humidity
        CO2
    )

    (import locale.parameter)

    (def light (
            :property 'value
            :label light'
            :icon 'lightbulb.2
        ))

    (def curtains (
            :property 'curtains
            :label curtains'
            :icon (\ (value)
                (? value 'shades.closed 'shades))
        ))

    (def temperature (
            :property 'temperature
            :label temperature'
            :icon 'thermometer
            :resolution 0.05
            :unit "°C"
        ))

    (def humidity (
            :property 'humidity
            :label humidity'
            :icon 'water.voc
            :resolution 0.2
            :unit "%"
        ))

    (def CO2 (
            :property 'co2
            :label CO2'
            :icon 'co2
            :resolution 10
            :unit "ppm"
        ))
)
