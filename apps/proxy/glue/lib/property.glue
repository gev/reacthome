(module lib.property
    (export
        light
        curtains
        temperature
        humidity
        CO2
    )

    (import i18n.parameter)

    (def light (
            :property 'value
            :label i18n-light
            :icon 'lightbulb.2
        ))

    (def curtains (
            :property 'curtains
            :label i18n-curtains
            :icon (\ (value)
                (? value 'shades.closed 'shades))
        ))

    (def temperature (
            :property 'temperature
            :label i18n-temperature
            :icon 'thermometer
            :resolution 0.1
            :unit "°C"
        ))

    (def humidity (
            :property 'humidity
            :label i18n-humidity
            :icon 'water.voc
            :resolution 1
            :unit "%"
        ))

    (def CO2 (
            :property 'co2
            :label i18n-CO2
            :icon 'co2
            :resolution 10
            :unit "ppm"
        ))
)
