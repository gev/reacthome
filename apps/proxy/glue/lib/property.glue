(module lib.property
    (export
        light
        curtains
        temperature
        humidity
        CO2
        power
        fan
    )

    (import i18n.parameter)

    (def light (
            :property 'value
            :label i18n-light
            :color 'primary
            :icon 'lightbulb.2
            :resolution 1
            :unit "%"
        ))

    (def curtains (
            :property 'curtains
            :label i18n-curtains
            :color 'tertiary
            :icon (
                :closed 'shades.closed
                :opened 'shades
            )
            :resolution 1
            :unit "%"
        ))

    (def temperature (
            :property 'temperature
            :label i18n-temperature
            :color 'secondary
            :icon 'thermometer
            :min 5
            :max 40
            :resolution 0.1
            :unit "°C"
        ))

    (def humidity (
            :property 'humidity
            :label i18n-humidity
            :color 'secondary
            :icon 'water.voc
            :min 20
            :max 80
            :resolution 1
            :unit "%"
        ))

    (def CO2 (
            :property 'co2
            :label i18n-CO2
            :color 'secondary
            :icon 'air
            :min 300
            :max 900
            :resolution 10
            :unit "ppm"
        ))

    (def power (
            :icon 'power
        ))

    (def fan (
            :icon 'mode_fan_2
        ))
)
