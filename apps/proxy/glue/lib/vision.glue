(module lib.vision
    (export back go select select-persistent ??)

    (def back
        (\ () (pop ()))
    )

    (def (go route)
        (\ () (push route))
    )

    (def (select source go key)
        (listen
            (lookup source key ())
            (go key)
        )
    )

    (def select-persistent
        (select store.persistent)
    )

    (def (?? go pred)
        (? pred (go pred))
    )
)
