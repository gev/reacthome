(module lib.system
    (export
        light
        curtains
        cameras
        water

        cooling
        heating
        wetting
        ventilation

        power
        fan

        system
    )

    (import i18n.system)
    (import lib.action)

    (def light (
            :label i18n-light
            :icon (symbol 'lightbulb.2)
        ))

    (def curtains (
            :label i18n-curtains
            :icon (symbol 'curtains)
            :icons (
                :closed (symbol 'curtains.closed)
                :opened (symbol 'curtains)
            )
        ))

    (def cooling (
            :label i18n-cooling
            :icon (symbol 'snowflake)
            
        ))

    (def heating (
            :label i18n-heating
            :icon (symbol 'heat)
        ))

    (def wetting (
            :label i18n-wetting
            :icon (symbol 'water.voc)
        ))

    (def ventilation (
            :label i18n-ventilation
            :icon (symbol 'mode_fan_2)
        ))

    (def cameras (
            :label i18n-cameras
            :icon (symbol 'videocam)
        ))

    (def water (
            :label i18n-water
            :icon (symbol 'water_drop)
        ))


    (def power (
            :icon (symbol 'power_settings_new)
        ))

    (def fan (
            :icon (symbol 'mode_fan_2)
        ))

    (def system _)
)
