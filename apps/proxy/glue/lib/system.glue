(module lib.system
    (export
        light
        curtains

        cooling
        heating
        wetting
        ventilation

        power
        fan

        system
    )

    (import i18n.system)
    (import lib.action)

    (def light (
            :label i18n-light
            :icon "lightbulb.2"
        ))

    (def curtains (
            :label i18n-curtains
            :color 'tertiary
            :icon (
                :closed 'shades.closed
                :opened 'shades
            )
        ))

    (def cooling (
            :label i18n-cooling
            :icon 'snow_flake
            
        ))

    (def heating (
            :label i18n-heating
            :icon 'heat
        ))

    (def wetting (
            :label i18n-wetting
            :icon 'water.voc
        ))

    (def ventilation (
            :label i18n-ventilation
            :icon 'mode_fan_2
        ))

    (def power (
            :icon 'power_settings_new
        ))

    (def fan (
            :icon 'mode_fan_2
        ))

    (def system _)
)
