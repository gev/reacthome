(module lib.system
    (export
        light
        curtains

        power
        fan

        cooling
        heating

        systems
    )

    (import i18n.system)
    (import lib.action)

    (def light (
            :property 'value
            :label i18n-light
            :color 'primary
            :icon 'lightbulb.2
            :resolution 1
            :unit "%"
        ))

    (def curtains (
            :property 'curtains
            :label i18n-curtains
            :color 'tertiary
            :icon (
                :closed 'shades.closed
                :opened 'shades
            )
            :resolution 1
            :unit "%"
        ))

    (def cooling (
            :color colors.blue
            :label i18n-cooling
            :intensity "cool_intensity"
            :on-intensity "onCoolIntensity"
            :set-intensity set-cool-intensity
            :toggle toggle-cool
            :value "cool"
            
        ))

    (def heating (
            :color colors.red
            :label i18n-heating
            :intensity "heat_intensity"
            :on-intensity "onHeatIntensity"
            :set-intensity set-heat-intensity
            :toggle toggle-heat
            :value "heat"
        ))

    (def power (
            :icon 'power_settings_new
        ))

    (def fan (
            :icon 'mode_fan_2
        ))

    (def all-systems (#
            light
            curtains
        ))

    (def systems _)
)
