(module lib.system
    (export
        light
        curtains

        cooling
        heating
        wetting
        ventilation

        power
        fan

        system
    )

    (import i18n.system)
    (import lib.action)

    (def light (
            :label i18n-light
            :icon (symbol 'lightbulb.2)
        ))

    (def curtains (
            :label i18n-curtains
            :color 'tertiary
            :icon (
                :closed (symbol 'shades.closed)
                :opened (symbol 'shades)
            )
        ))

    (def cooling (
            :label i18n-cooling
            :icon (symbol 'snowflake)
            
        ))

    (def heating (
            :label i18n-heating
            :icon (symbol 'heat)
        ))

    (def wetting (
            :label i18n-wetting
            :icon (symbol 'water.voc)
        ))

    (def ventilation (
            :label i18n-ventilation
            :icon (symbol 'mode_fan_2)
        ))

    (def power (
            :icon (symbol 'power_settings_new)
        ))

    (def fan (
            :icon (symbol 'mode_fan_2)
        ))

    (def system _)
)
