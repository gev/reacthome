(module lib.system
    (export
        light
        curtains

        cooling
        heating
        wetting
        ventilation

        power
        fan

        system
    )

    (import i18n.system)
    (import lib.action)

    (def light (
            :label i18n-light
            :color 'primary
            :icon 'lightbulb.2
        ))

    (def curtains (
            :label i18n-curtains
            :color 'tertiary
            :icon (
                :closed 'shades.closed
                :opened 'shades
            )
        ))

    (def cooling (
            :color colors.blue
            :label i18n-cooling
            :icon 'snow_flake
            :intensity "cool_intensity"
            :on-intensity "onCoolIntensity"
            :set-intensity set-cool-intensity
            :toggle toggle-cool
            :value "cool"
            
        ))

    (def heating (
            :color colors.red
            :label i18n-heating
            :icon 'heat
            :intensity "heat_intensity"
            :on-intensity "onHeatIntensity"
            :set-intensity set-heat-intensity
            :toggle toggle-heat
            :value "heat"
        ))

    (def wetting (
            :label i18n-wetting
            :icon 'water.voc
        ))

    (def ventilation (
            :label i18n-ventilation
            :icon 'mode_fan_2
        ))

    (def power (
            :icon 'power_settings_new
        ))

    (def fan (
            :icon 'mode_fan_2
        ))

    (def system _)
)
