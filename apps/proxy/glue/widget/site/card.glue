(module widget.site.card
    (export site-card)

    (import widget.title)

    (def (site-card props)
        (card
            :child (column
                :spacing 32
                :children (
                    (column :spacing 16 :children (
                            (text :content props.type)
                            (title props)
                        )
                    )
                )
            )
        )
    )
)
