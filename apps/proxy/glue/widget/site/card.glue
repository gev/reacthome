(module widget.site.card
    (export site-card)

    (import widget.title)
    (import lib.vision)

    (def (site-card id props)
        (card
            :clip-behavior clip.anti-alias
            :child (column
                :cross-axis-alignment cross-axis-alignment.stretch
                :children (
                    (? props.image
                        (aspect-ratio
                            :aspect-ratio 1.7778
                            :child (image
                                :src props.image
                                :fit box-fit.fit-width
                            )
                        )
                    )
                    (padding
                        :padding (edge-insets-all 16)
                        :child (filled-button
                            :child (title props)
                            :on-pressed (go :route 'site :id id)
                        )
                    )
                )
            )
        )
    )
)
