(module widget.site.card
    (export site-card)

    (def (site-card props)
        (card
            :child (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :spacing 32
                    :children (
                        (column :spacing 16 :children (
                                (text :content props.type)
                                (text :content props.code)
                                (text :content props.title)
                            )
                        )
                    )
                )
            )
        )
    )
)
