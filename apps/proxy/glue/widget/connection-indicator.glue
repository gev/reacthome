(module widget.connection-indicator
    (export connection-indicator)

    (def (indicator props)
        (animated-positioned
            :top props.position
            :left 20
            :right 20
            :duration (duration :milliseconds 300)
            :child (center
                :child (card
                    :color props.color
                    :elevation 6
                    :child (padding
                        :padding (edge-insets-symmetric :vertical 8 :horizontal 16)
                        :child props.child
                    )
                )
            )
        )
    )

    (def (connection-indicator props)
        (def (monitor status)
            (if (== status connection-status.connected)
                (indicator
                    :position props.connected-position
                    :color current-theme.color-scheme.surface-container
                    :child (text
                        :text "Connected"
                        :style (text-style
                            :color current-theme.color-scheme.on-surface
                        )
                    )
                )
                (indicator
                    :position props.disconnected-position
                    :color current-theme.color-scheme.error
                    :child (row
                        :spacing 16
                        :main-axis-size main-axis-size.min
                        :children (
                            (text
                                :text "Connecting"
                                :style (text-style
                                    :color current-theme.color-scheme.on-error
                                )
                            )
                            (sized-box
                                :width 16
                                :height 16
                                :child (activity
                                    :stroke-width 2
                                    :color current-theme.color-scheme.error
                                    :background-color current-theme.color-scheme.on-error
                                )
                            )
                        )
                    )
                )
            )
        )
        (listen monitor direct-connection-monitor)
    )
)
