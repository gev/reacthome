(module widget.regulator-mode
    (export regulator-mode)


    (import lib.i18n)
    (import widget.regulator-theme)

    (def (segment i)
        (button-segment
            :label (text :content (select-locale i.label))
            :value i
        )
    )

    (def (segments props)
        (map segment props.modes)
    )

    (def (regulator-mode props)
        (def color-scheme (regulator-color-scheme current-theme))
        (def (on-changed set) (props.on-changed (@ set 0)))
        (segmented-button
            :selected (# props.mode)
            :segments (segments props)
            :show-selected-icon false
            :empty-selection-allowed false
            :on-selection-changed on-changed
            :style (segmented-button-style
                :elevation 4
                :foreground-color color-scheme.on-surface
                :side (border-side
                    :color color-scheme.variant
                )
            )
        )
    )
)
