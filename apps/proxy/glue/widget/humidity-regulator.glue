(module widget.humidity-regulator
    (export
        humidity-regulator-color
        humidity-regulator
    )

    (import lib.actions)
    (import lib.property)

    (import widget.regulator-modal)
    (import widget.regulator-toggle)
    (import widget.setpoint-slider)

    (def humidity-regulator-color colors.cyan)

    (def (setpoint regulator)
        (setpoint-slider
            :value regulator.setpoint
            :param humidity
            :action (set-humidity-setpoint regulator.id)
        )
    )

    (def (toggle regulator)
        (regulator-toggle
            :value regulator.humidity
            :on-changed (toggle-wet regulator.id)
        )
    )
    
    (def (regulator-body regulator)
        (column
            :children (
                (setpoint regulator)
                (toggle regulator)
            )
        )
    )

    (def (humidity-regulator site regulator)
        (with-seed-color
            :seed-color humidity-regulator-color
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-modal
                :site site
                :regulator regulator
                :param humidity
                :body (regulator-body regulator)
            )
        )
    )
)
