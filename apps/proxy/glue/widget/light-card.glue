(module widget.light-card
    (export light-card)

    (import lib.actions)
    (import lib.data)
    (import lib.log)
    (import lib.navigation)

    (import locale.action)

    (import iconic.light)

    (import widget.cards)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (light props small)
        (row
            :main-axis-alignment main-axis-alignment.space-between
            :children (
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (text
                            :content props.label
                            :style (text-style
                                :font-size theme.text-theme.label-large.font-size
                                :color theme.color-scheme.on-surface-variant
                                :font-weight font-weight.w400
                            )
                        )
                        (text
                            :content props.status
                            :style (text-style
                                :color props.color
                                :font-size (if small
                                    theme.text-theme.title-medium.font-size
                                    theme.text-theme.title-large.font-size
                                )
                                :font-weight font-weight.w600
                            )
                        )
                    )
                )
                (iconic
                    :icon iconic-lamp
                    :color props.icon-color
                    :size 40
                )
            )
        )
    )
    

    (def (light-dimmable props bind)
        (if (bind.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light
                    :id props.id
                    :label (title props)
                    :status (to-percents bind.value)
                    :icon-color theme.color-scheme.primary
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light
                    :id props.id
                    :label (title props)
                    :status (@ turn-on' locale.language-code)
                    :icon-color theme.color-scheme.outline-variant
                )
            )
        )
    )

    (def (light-non-dimmable props bind)
        (if (bind.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light
                    :id props.id
                    :label (title props)
                    :status (@ turn-off' locale.language-code)
                    :icon-color theme.color-scheme.primary
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light
                    :id props.id
                    :label (title props)
                    :status (@ turn-on' locale.language-code)
                    :icon-color theme.color-scheme.outline-variant
                )
            )
        )
    )

    (def (light-bound props bind)
        (if (bind.dimmable)
            (light-dimmable props bind)
            (light-non-dimmable props bind)
        )
    )

    (def (light-card props)
        (if (is-exist props.bind)
            (select (light-bound props) props.bind)
            (inactive-card
                :key props.id
                :color theme.color-scheme.on-surface-variant
                :card-color theme.color-scheme.surface-variant
                :icon-color theme.color-scheme.outline-variant
                :elevation elevation-unbound
                :child (light
                    :id props.id
                    :label (title props)
                    :status (@ not-available' locale.language-code)
                )
            )
            
        )
    )
)
