(module widget.light-card
    (export light-card)

    (import lib.actions)
    (import lib.data)
    (import lib.log)
    (import lib.navigation)

    (import locale.status)

    (import iconic.light)

    (import widget.cards)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (light props)
        (row
            :spacing 8
            :children (
                (icon
                    :icon (symbol 'lightbulb.2)
                    :color (? props.bound
                        theme.color-scheme.primary
                        theme.color-scheme.outline-variant
                    )
                    :fill (? props.value 1 0)
                    :size 32
                )
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (text
                            :content props.label
                            :style (text-style
                                :font-size theme.text-theme.label-medium.font-size
                                :color theme.color-scheme.on-surface-variant
                                :font-weight font-weight.w400
                            )
                        )
                        (text
                            :content props.status
                            :style (text-style
                                :color props.color
                                :font-size theme.text-theme.title-medium.font-size
                                :font-weight font-weight.w600
                            )
                        )
                    )
                )
            )
        )
    )
    

    (def (light-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (to-percents props.value)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ off' locale.language-code)
                )
            )
        )
    )

    (def (light-non-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ on' locale.language-code)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ off' locale.language-code)
                )
            )
        )
    )

    (def (light-bound props bind)
        (def card
            (if bind.dimmable
                light-dimmable
                light-non-dimmable
            )
        )
        (card
            :id props.id
            :label (title props)
            :value (if (is-exist bind.brightness)
                (? bind.value bind.brightness 0)
                bind.value
            )
        )
    )

    (def (light-card props)
        (if (is-exist props.bind)
            (view (light-bound props) props.bind)
            (inactive-card
                :key props.id
                :color theme.color-scheme.on-surface-variant
                :card-color theme.color-scheme.surface-variant
                :elevation elevation-unbound
                :child (light
                    :id props.id
                    :value 0
                    :bound false
                    :label (title props)
                    :status (@ not-available' locale.language-code)
                )
            )
            
        )
    )
)
