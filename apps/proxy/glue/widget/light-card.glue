(module widget.light-card
    (export light-card)

    (import i18n.status)

    (import iconic.light)

    (import lib.actions)
    (import lib.conversion)
    (import lib.data)
    (import lib.i18n)
    (import lib.navigation)
    (import lib.property)

    (import widget.card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (light-tile props)
        (entity-tile
            :icon (
                :symbol light.icon
                :color (@ current-theme.color-scheme light.color)
                :fill (? props.value 1 0)
            )
            :label (:text props.label)
            :status (:text props.status)
        )
    )
    
    (def (dimmable-light-card props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light-tile
                    :value props.brightness
                    :label props.label
                    :status (to-percents props.brightness)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :on-long-press (go :route 'light-dimmer :id props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light-tile
                    :value props.brightness
                    :label props.label
                    :status (select-locale i18n-off)
                )
            )
        )
    )

    (def (non-dimmable-light-card props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-on)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-off)
                )
            )
        )
    )

    (def (bound-light-card props bind)
        (def card
            (if bind.dimmable
                dimmable-light-card
                non-dimmable-light-card
            )
        )
        (card
            :id props.id
            :label (title props)
            :value props.value
            :brightness (if (is-exist bind.brightness)
                (? bind.value bind.brightness 0)
                bind.value
            )
        )
    )

    (def (unbound-light-card props)
        (inactive-card
            :key props.id
            :card-color current-theme.color-scheme.surface-variant
            :elevation elevation-unbound
            :child (disabled-entity-tile
                :icon (:symbol light.icon)
                :label (:text (title props))
                :status (:text (select-locale i18n-not-available))
            )
        )
    )

    (def (light-card props)
        (if (is-exist props.bind)
            (select (bound-light-card props) props.bind)
            (unbound-light-card props)
        )
    )
)
