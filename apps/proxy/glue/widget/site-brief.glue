(module widget.site-brief
    (export site-brief)

    (import widget.site-aggregate)

    (def (site-brief-container props)
        (row
            :spacing 16
            :children props.children)
    )

    (def (site-brief-parameter props)
        (row
            :spacing 4
            :children (
                (icon
                    :icon (symbol props.icon.symbol)
                    :color current-theme.color-scheme.on-surface-variant
                    :fill props.icon.fill
                    :size 16
                )
                (if (exists? props.value)
                    (text
                        :content props.value
                        :style current-theme.text-theme.title-small
                    )
                )
                (if (exists? props.unit)
                    (text
                        :content props.unit
                        :style (text-style
                            :font-style current-theme.text-theme.title-small.font-size
                            :color current-theme.color-scheme.on-surface-variant
                        )
                    )
                )
            )
        )
    )

    (def (site-brief props)
        (site-aggregate
            :container site-brief-container
            :parameter site-brief-parameter
            :sites (# props.site)
            :acc ()
        )
    )
)
