(module widget.site-brief
    (export site-brief)

    (import widget.site-aggregate)

    (def (tile-icon props)
        (icon
            :icon (symbol props.icon.symbol)
            :color current-theme.color-scheme.on-surface-variant
            :fill props.icon.fill
            :size 16
        )
    )

    (def (tile-value value)
        (text
            :text value
            :style current-theme.text-theme.title-small
        )
    )

    (def (tile-unit unit)
        (text
            :text unit
            :style (text-style
                :font-style current-theme.text-theme.title-small.font-size
                :color current-theme.color-scheme.on-surface-variant
            )
        )
    )

    (def (tile props)
        (row
            :spacing 4
            :children (
                (tile-icon props)
                (?> tile-value props.value)
                (?> tile-unit props.unit)
            )
        )
    )

    (def (info props)
        (row
            :spacing 16
            :children props.children
        )
    )

    (def (site-brief props)
        (site-aggregate
            :container info
            :parameter tile
            :sites (# props.site)
            :acc ()
        )
    )
)
