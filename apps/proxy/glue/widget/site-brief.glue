(module widget.site-brief
    (export site-brief)

    (import widget.site-aggregate)

    (def (site-brief-container props)
        (card
            :child (padding
                :padding (edge-insets-all 16)
                :child (row
                    :spacing 16
                    :children props.children)
            )
        )
    )

    (def (site-brief-parameter props)
        (row
            :spacing 4
            :children (
                (icon
                    :icon (symbol props.icon.symbol)
                    :color theme.color-scheme.on-surface
                    :fill props.icon.fill
                )
                (text
                    :content props.value
                    :style theme.text-theme.title-medium
                )
            )
        )
    )

    (def (site-brief props)
        (site-aggregate
            :container site-brief-container
            :parameter site-brief-parameter
            :sites (# props.site)
            :acc ()
        )
    )
)
