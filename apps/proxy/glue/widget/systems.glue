(module widget.systems
    (export systems)

    (import lib.i18n)
    (import lib.navigation)
    (import lib.indexed-screens)

    (import widget.site-breadcrumbs)

    (def (no-system i18n-system)
        (center
            :child (text
                :text (select-locale i18n-system)
                :style current-theme.text-theme.display-medium
            )
        )
    )

    (def (system show props)
        (column
            :spacing 16
            :cross-axis-alignment cross-axis-alignment.start
            :children (
                (single-child-scroll-view
                    :scroll-direction axis.horizontal
                    :child (site-breadcrumbs
                        :site props.id
                        :action go-site
                    )
                )
                (show props)
            )
        )
    )

    (def (systems i18n-system show props)
        (if (empty? props)
            (no-system i18n-system)
            (single-child-scroll-view
                :child (column
                    :spacing 32
                    :cross-axis-alignment cross-axis-alignment.stretch
                    :children (map (system show) props)
                )
            )
        )
    )
)
