(module widget.curtain-card
    (export curtain-card)

    (import i18n.status)

    (import lib.data)
    (import lib.i18n)
    (import lib.navigation)
    (import lib.property)

    (import iconic.curtain)

    (import widget.entity-card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (curtain-tile props)
        (entity-tile
            :icon (
                :symbol (? props.value curtains.icon.closed curtains.icon.opened)
                :color (@ current-theme.color-scheme curtains.color)
                :fill 1
            )
            :label (:text props.label)
            :status (:text props.status)
        )
    )
    

    (def (positioned-curtain-card props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (go :route 'positioned-curtain :id props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-closed)
                )
            )
            (active-card
                :key props.id
                :on-pressed (go :route 'positioned-curtain :id props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-opened)
                )
            )
        )
    )

    (def (non-positioned-curtain-card props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (go :route 'non-positioned-curtain :id props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-closed)
                )
            )
            (active-card
                :key props.id
                :on-pressed (go :route 'non-positioned-curtain :id props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-opened)
                )
            )
        )
    )

    (def (bound-curtain-card props bind)
        (def card
            (if bind.positioned
                positioned-curtain-card
                non-positioned-curtain-card
            )
        )
        (card
            :id props.id
            :label (title props)
            :value props.value
        )
    )

    (def (unbound-curtain-card props)
        (inactive-card
            :key props.id
            :card-color current-theme.color-scheme.surface-variant
            :elevation elevation-unbound
            :child (disabled-entity-tile
                :icon (:symbol (curtains.icon.opened))
                :label (:text (title props))
                :status (:text (select-locale i18n-not-available))
            )
        )
    )

    (def (curtain-card props)
        (if (is-exist props.bind)
            (select (bound-curtain-card props) props.bind)
            (unbound-curtain-card props)
        )
    )
)
