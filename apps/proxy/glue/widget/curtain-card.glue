(module widget.curtain-card
    (export curtain-card)

    (import lib.actions)
    (import lib.data)
    (import lib.log)
    (import lib.navigation)

    (import locale.action)

    (import iconic.curtain)

    (import widget.cards)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (curtain props)
        (row
            :spacing 8
            :children (
                (icon
                    :icon (symbol
                        (? (< props.value 128)
                            'shades
                            'shades.closed
                        )
                    )
                    :color (? props.bound
                        theme.color-scheme.primary
                        theme.color-scheme.outline-variant
                    )
                    :fill 1
                    :size 32
                )
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (text
                            :content props.label
                            :style (text-style
                                :font-size theme.text-theme.label-medium.font-size
                                :color theme.color-scheme.on-surface-variant
                                :font-weight font-weight.w400
                            )
                        )
                        (text
                            :content props.status
                            :style (text-style
                                :color props.color
                                :font-size theme.text-theme.title-medium.font-size
                                :font-weight font-weight.w600
                            )
                        )
                    )
                )
            )
        )
    )
    

    (def (curtain-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :on-long-press (go :route 'curtain :id props.id)
                :color theme.color-scheme.on-surface
                :card-color (if (< props.value 128)
                    theme.color-scheme.surface-bright
                    theme.color-scheme.surface-dim
                )
                :elevation elevation-on
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (if (> props.value 254)
                        (@ closed' locale.language-code)
                        (to-percents props.value))
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :on-long-press (go :route 'curtain :id props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ opened' locale.language-code)
                )
            )
        )
    )

    (def (curtain-non-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ closed' locale.language-code)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :color theme.color-scheme.on-surface
                :card-color theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ opened' locale.language-code)
                )
            )
        )
    )

    (def (curtain-bound props bind)
        (def card
            (if bind.dimmable
                curtain-dimmable
                curtain-non-dimmable
            )
        )
        (card
            :id props.id
            :label (title props)
            :value (if (is-exist bind.brightness)
                (? bind.value bind.brightness 0)
                bind.value
            )
        )
    )

    (def (curtain-card props)
        (if (is-exist props.bind)
            (select (curtain-bound props) props.bind)
            (inactive-card
                :key props.id
                :color theme.color-scheme.on-surface-variant
                :card-color theme.color-scheme.surface-variant
                :elevation elevation-unbound
                :child (curtain
                    :id props.id
                    :value 0
                    :bound false
                    :label (title props)
                    :status (@ not-available' locale.language-code)
                )
            )
        )
    )
)
