(module widget.curtain-card
    (export curtain-card)

    (import lib.data)
    (import lib.navigation)
    (import lib.property)

    (import i18n.status)

    (import iconic.curtain)

    (import widget.cards)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (curtain props)
        (row
            :spacing 8
            :children (
                (icon
                    :icon (symbol (curtains.icon props.value))
                    :color (? props.bound
                        current-theme.color-scheme.primary
                        current-theme.color-scheme.outline-variant
                    )
                    :fill 1
                    :size 32
                )
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (text
                            :content props.label
                            :style (text-style
                                :font-size current-theme.text-theme.label-medium.font-size
                                :color current-theme.color-scheme.on-surface-variant
                                :font-weight font-weight.w400
                            )
                        )
                        (text
                            :content props.status
                            :style (text-style
                                :color props.color
                                :font-size current-theme.text-theme.title-medium.font-size
                                :font-weight font-weight.w600
                            )
                        )
                    )
                )
            )
        )
    )
    

    (def (curtain-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (go :route 'curtain :id props.id)
                :color current-theme.color-scheme.on-surface
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ i18n-closed locale.language-code)
                )
            )
            (active-card
                :key props.id
                :on-pressed (go :route 'curtain :id props.id)
                :color current-theme.color-scheme.on-surface
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ i18n-opened locale.language-code)
                )
            )
        )
    )

    (def (curtain-non-dimmable props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (go :route 'curtain :id props.id)
                :color current-theme.color-scheme.on-surface
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ i18n-closed locale.language-code)
                )
            )
            (active-card
                :key props.id
                :on-pressed (go :route 'curtain :id props.id)
                :color current-theme.color-scheme.on-surface
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain
                    :id props.id
                    :value props.value
                    :label props.label
                    :bound true
                    :status (@ i18n-opened locale.language-code)
                )
            )
        )
    )

    (def (curtain-bound props bind)
        (def card
            (if bind.dimmable
                curtain-dimmable
                curtain-non-dimmable
            )
        )
        (card
            :id props.id
            :label (title props)
            :value props.value
        )
    )

    (def (curtain-card props)
        (if (is-exist props.bind)
            (select (curtain-bound props) props.bind)
            (inactive-card
                :key props.id
                :color current-theme.color-scheme.on-surface-variant
                :card-color current-theme.color-scheme.surface-variant
                :elevation elevation-unbound
                :child (curtain
                    :id props.id
                    :value 0
                    :bound false
                    :label (title props)
                    :status (@ i18n-not-available locale.language-code)
                )
            )
        )
    )
)
