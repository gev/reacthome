(module widget.entity-tile
    (export
        entity-tile
        disabled-entity-tile
        primary-entity-tile
        secondary-entity-tile
        tertiary-entity-tile
    )

    (import widget.tile)

    (def (entity-tile props)
        (tile
            :icon (
                :symbol props.icon.symbol
                :fill props.icon.fill
                :color (?? props.icon.color
                    current-theme.color-scheme.on-surface)
            )
            :label (
                :text props.label.text
                :color (?? props.label.color
                    current-theme.color-scheme.on-surface-variant)
            )
            :status (
                :text props.status.text
                :color (?? props.status.color
                    current-theme.color-scheme.on-surface)
            )
            :details (
                :text props.details.text
                :color (?? props.details.color
                    current-theme.color-scheme.on-surface-variant)
            )
        )
    )

    (def (disabled-entity-tile props)
        (tile
            :icon (
                :symbol props.icon.symbol
                :fill 0
                :color current-theme.color-scheme.outline-variant
            )
            :label (
                :text props.label.text
                :color current-theme.color-scheme.outline-variant
            )
            :status (
                :text props.status.text
                :color current-theme.color-scheme.outline-variant
            )
            :details (
                :text props.details.text
                :color current-theme.color-scheme.outline-variant
            )
        )
    )

    (def (primary-entity-tile props)
        (tile
            :icon (
                :symbol props.icon.symbol
                :fill props.icon.fill
                :color current-theme.color-scheme.primary
            )
            :label (
                :text props.label.text
                :color current-theme.color-scheme.on-surface-variant
            )
            :status (
                :text props.status.text
                :color current-theme.color-scheme.on-surface
            )
            :details (
                :text props.details.text
                :color current-theme.color-scheme.on-surface-variant
            )
        )
    )

    (def (secondary-entity-tile props)
        (tile
            :icon (
                :symbol props.icon.symbol
                :fill props.icon.fill
                :color current-theme.color-scheme.secondary
            )
            :label (
                :text props.label.text
                :color current-theme.color-scheme.on-surface-variant
            )
            :status (
                :text props.status.text
                :color current-theme.color-scheme.on-surface
            )
            :details (
                :text props.details.text
                :color current-theme.color-scheme.on-surface-variant
            )
        )
    )

    (def (tertiary-entity-tile props)
        (tile
            :icon (
                :symbol props.icon.symbol
                :fill props.icon.fill
                :color current-theme.color-scheme.tertiary
            )
            :label (
                :text props.label.text
                :color current-theme.color-scheme.on-surface-variant
            )
            :status (
                :text props.status.text
                :color current-theme.color-scheme.on-surface
            )
            :details (
                :text props.details.text
                :color current-theme.color-scheme.on-surface-variant
            )
        )
    )
)
