(module widget.app-bar-button
    (export app-bar-button)

    (def (selected-style props)
        (button-style
            :elevation 1
            :background-color (
                ?? props.selected-color
                current-theme.color-scheme.secondary-container
            )
        )
    )

    (def (unselected-style props)
        (button-style
            :elevation 0
            :background-color (
                ?? props.unselected-color
                colors.transparent)
        )
    )

    (def (app-bar-button props)
        (def style (? props.selected selected-style unselected-style))
        (button
            :on-pressed props.on-pressed
            :style (style props)
            :child (if (exists? props.label)
                (row
                    :spacing 8
                    :main-axis-size main-axis-size.min
                    :cross-axis-alignment cross-axis-alignment.center
                    :children (
                        (icon
                            :fill (? props.selected 1 0)
                            :icon props.icon
                        )
                        (text :text props.label)
                    )
                )
                (icon
                    :fill (? props.selected 1 0)
                    :icon props.icon
                )
            )
        )
    )
)
