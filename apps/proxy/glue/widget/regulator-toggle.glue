(module widget.regulator-toggle
    (export regulator-toggle)

    (import i18n.status)
    (import i18n.parameter)

    (import lib.i18n)
    (import lib.property)

    (import widget.optimistic)
    (import widget.regulator-theme)

    (def (regulator-toggle props)
        (def color-scheme (regulator-color-scheme current-theme))
        (def state
            (optimistic
                :value props.value
                :on-changed props.on-changed
            )
        )
        (def (tile value)
            (list-tile
                :leading (icon
                    :icon (symbol power.icon)
                    :color color-scheme.on-surface
                )
                :title (text
                    :content (select-locale (? value i18n-on i18n-off))
                    :style (text-style
                        :color color-scheme.on-surface
                    )
                )
                :trailing (switch
                    :value value
                    :on-changed state.set-value
                )
            )
        )
        (listen tile state.value)
    )

)
