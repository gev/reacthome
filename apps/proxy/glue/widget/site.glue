(module widget.site
    (export site)

    (import lib.navigation)
    (import widget.site.list)
    (import widget.title)

    (def (site props)
        (list-view
            :children (
                (if (is-exist props.image)
                    (image
                        :src props.image
                        :fit box-fit.fit-width
                    )
                )
                (padding
                    :padding (edge-insets-all 16)
                    :child (title
                        :of props
                        :style theme.text-theme.headline-large
                    )
                )
                (maybe site-list props.site)
            )
        )
    )
)
