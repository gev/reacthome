(module widget.site
    (export site)

    (import lib.log)
    (import lib.data)
    (import lib.navigation)

    (import widget.containers)
    (import widget.site-card)
    (import widget.site-breadcrumbs)
    (import widget.light-card)
    (import widget.curtain-card)

    (def (site props)
        (single-child-scroll-view
            :child (column
                :spacing 16
                :cross-axis-alignment cross-axis-alignment.start
                :children (
                    (if (is-exist props.image)
                        (image
                            :src props.image
                            :fit box-fit.fit-width
                        )
                    )
                    (wrap
                        :spacing 16
                        :run-spacing 8
                        :cross-axis-alignment wrap-cross-alignment.center
                        :children (
                            (text
                                :content (title props)
                                :style theme.text-theme.headline-large
                            )
                            (site-breadcrumbs
                                :site props.parent
                                :action (\ (id) (go :route 'site :id id)))
                        )
                    )
                    (select-in-wrap light-card props.light_220)
                    (select-in-wrap light-card props.light_LED)
                    (select-in-wrap curtain-card props.curtains)
                    (select-in-column site-card props.site)
                )
            )
        )
    )
)
