(module widget.site
    (export site)

    (import lib.log)
    (import lib.data)
    (import lib.navigation)

    (import widget.screen)
    (import widget.containers)
    (import widget.site-breadcrumbs)
    (import widget.site-info)
    (import widget.site-card)
    (import widget.light-card)
    (import widget.curtain-card)
    (import widget.temperature-regulator-card)
    (import widget.humidity-regulator-card)
    (import widget.ventilation-regulator-card)

    (def (site-screen props)
        (screen
            :body (single-child-scroll-view
                :padding (edge-insets-only :bottom 128)
                :child (column
                    :spacing 16
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (if (is-exist props.image)
                            (image
                                :image (load-image :src props.image)
                                :fit box-fit.fit-width
                            )
                        )
                        (padding
                            :padding (edge-insets-symmetric :horizontal 16)
                            :child (wrap
                                :spacing 16
                                :run-spacing 8
                                :cross-axis-alignment wrap-cross-alignment.center
                                :children (
                                    (text
                                        :content (title props)
                                        :style current-theme.text-theme.headline-large
                                    )
                                    (site-breadcrumbs
                                        :site props.parent
                                        :action (\ (id) (go :route 'site :id id))
                                    )
                                )
                            )
                        )
                        (site-info :site props.id)
                        (select-in-grid light-card props.light_220)
                        (select-in-grid light-card props.light_LED)
                        (single-child-scroll-view
                            :scroll-direction axis.horizontal
                            :child (row
                                :spacing 16
                                :children (
                                    (select-in-row (temperature-regulator-card props) props.thermostat)
                                    (select-in-row (humidity-regulator-card props) props.hygrostat)
                                    (select-in-row (ventilation-regulator-card props) props.co2_stat)
                                )
                            )
                        )
                        (select-in-grid curtain-card props.curtains)
                        (select-in-column site-card props.site)
                    )
                )
            )
        )
    )

    (def (site-with-theme props)
        (def color-scheme
            (seed-color-scheme
                :seed props.palette.vibrant
                :brightness current-theme.color-scheme.brightness
                :dynamic-scheme-variant dynamic-scheme-variant.content
            )
        )
        (with-theme
            :data (theme :color-scheme color-scheme)
            :child (site-screen props)
        )

    )

    (def (site props)
        (if (is-exist props.palette.vibrant)
            (site-with-theme props)
            (site-screen props)
        )
    )
)
