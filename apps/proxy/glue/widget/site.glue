(module widget.site
    (export site)

    (import widget.site.list)
    (import widget.title)
    (import lib.vision)

    (def (site id props)
        (list-view
            :children (
                (if (is-exist props.image)
                    (image
                        :src props.image
                        :fit box-fit.fit-width
                    )
                )
                (padding
                    :padding (edge-insets-all 16)
                    :child (title props)
                )
                (maybe site-list props.site)
            )
        )
    )
)
