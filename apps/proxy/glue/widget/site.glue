(module widget.site
    (export site)

    (import lib.data)
    (import lib.navigation)
    (import widget.containers)
    (import widget.card.site)
    (import widget.card.light)
    (import widget.title)

    (def (site props)
        (list-view
            :children (
                (if (is-exist props.image)
                    (image
                        :src props.image
                        :fit box-fit.fit-width
                    )
                )
                (padding
                    :padding (edge-insets-all 16)
                    :child (title
                        :of props
                        :style theme.text-theme.headline-large
                    )
                )
                (column
                    :spacing 16
                    :children (
                        (column
                            :children (
                                (select-in-row light-card props.light_220)
                                (select-in-row light-card props.light_LED)
                            )
                        )
                        (select-in-column site-card props.site)
                    )
                )
            )
        )
    )
)
