(module widget.site
    (export site)

    (import lib.log)
    (import lib.data)
    (import lib.navigation)
    (import widget.containers)
    (import widget.card.site)
    (import widget.card.light)

    (def (site props)
        (list-view
            :children (
                (if (is-exist props.image)
                    (image
                        :src props.image
                        :fit box-fit.fit-width
                    )
                )
                (padding
                    :padding (edge-insets-all 16)
                    :child (text
                        :content (title props)
                        :style theme.text-theme.headline-large
                    )
                )
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :spacing 16
                    :children (
                        (vertical-slider
                            :value 50
                            :min 0
                            :max 100
                            :jump-to-tap false
                            :display-value false
                            :on-changed (\ (value) (log-info value))
                        )
                        (select-in-wrap light-card props.light_220)
                        (select-in-wrap light-card props.light_LED)
                        (select-in-column site-card props.site)
                    )
                )
            )
        )
    )
)
