(module widget.setpoint--slider
    (export regulator-slider)

    (import lib.conversion)
    
    (import widget.modal)
    (import widget.site-breadcrumbs)

    (def (slider on-changed param value)
        (def color current-theme.color-scheme.on-primary)
        (def color-variant (color.with :a 0.5))
        (stack
            :alignment alignment.center
            :children (
                (circular-slider
                    :value value
                    :min param.min
                    :max param.max
                    :diameter 240
                    :width 16
                    :focused-width 24
                    :active-color color
                    :inactive-color color-variant
                    :on-changed on-changed
                )
                (column
                    :children(
                        (text
                            :content (round-to-resolution value param.resolution)
                            :style (text-style
                                :font-size current-theme.text-theme.display-medium.font-size
                                :color color
                            )
                        )
                        (text
                            :content param.unit
                            :style (text-style
                                :font-size current-theme.text-theme.title-large.font-size
                                :color color
                            )
                        )
                    )
                )
            )
        )
    )


    (def (regulator-slider props)
        (def value (local-state props.value))
        (def (on-changed v)
            (write value v)
            (props.action v)
        )
        (listen (slider on-changed props.param) value)
    )
)
