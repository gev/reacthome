(module widget.nav-bar
    (export nav-bar)

    (import i18n.nav-bar)
    (import lib.i18n)
    (import widget.floating-bar)

    (def (nav-bar props)
        (floating-bar
            :child (navigation-bar
                :selected-index 1
                :background-color colors.transparent
                :destinations (
                    (navigation-destination
                        :icon (icon :icon (symbol 'weather.mix))
                        :label (select-locale i18n-weather)
                    )
                    (navigation-destination
                        :icon (icon :icon (symbol 'home) :fill 1)
                        :label (select-locale i18n-home)
                    )
                    (navigation-destination
                        :icon (icon :icon (symbol 'dashboard))
                        :label (select-locale i18n-systems)
                    )
                    (navigation-destination
                        :icon (icon :icon (symbol 'settings))
                        :label (select-locale i18n-settings)
                    )
                )
            )
        )
    )
)
