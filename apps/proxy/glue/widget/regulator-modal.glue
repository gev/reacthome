(module widget.regulator-modal
    (export
        regulator-color-scheme
        regulator-modal
    )

    (import lib.conversion)
    (import lib.i18n)
    (import widget.modal)
    (import widget.site-breadcrumbs)

    (def (regulator-color-scheme theme)
        (def color-scheme (theme.color-scheme))
        (
            :surface color-scheme.primary
            :on-surface color-scheme.on-primary
            :variant (color-scheme.on-primary.with :a 0.4)
        )
    )

    (def (regulator-modal props)
        (def color-scheme (regulator-color-scheme current-theme))
        (def value (@ props.site props.param.property))
        (def title-style
            (text-style
                :font-size current-theme.text-theme.title-large.font-size
                :color color-scheme.on-surface
                :font-weight font-weight.w400
            )
        )
        (modal
            :color color-scheme.surface
            :child (column
                :spacing 16
                :main-axis-size main-axis-size.min
                :children (
                    (row
                        :spacing 8
                        :main-axis-size main-axis-size.min
                        :children (
                            (text
                                :content (select-locale props.param.label)
                                :style title-style
                            )
                            (text
                                :content (round-to-resolution value props.param.resolution)
                                :style title-style
                            )
                            (text
                                :content props.param.unit
                                :style title-style

                            )
                        )
                    )
                    (site-breadcrumbs
                        :site props.site.id
                        :color color-scheme.variant
                    )
                    (props.body)
                )
            )
        )
    )
)
