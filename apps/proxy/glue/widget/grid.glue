(module widget.grid
    (export grid)
    
    (import lib.log)

    (def min-w 144)
    (def max-w 196)
    (def gap 16)

    (def (grid props)
        (def spacing (?? props.spacing gap))

        (def (adopt child)
            (def screen-width (+ media-query.width gap))
            (def n (max 1 (floor (/ screen-width (+ min-w gap)))))
            (def width (- (/ screen-width n) (* 1.5 gap)))
            (log-info (# media-query.width n width))
            (container
                :width width
                :constraints (box-constraints
                    :min-width min-w
                    :max-width max-w
                )
                :child child
            )
        )

        (wrap
            :spacing spacing
            :run-spacing spacing
            :children (map adopt props.children)
        )
    )
)
