(module widget.grid
    (export grid)
    
    (def min-width 144)
    (def max-width 196)
    (def grid-spacing 16)

    (def (grid props)
        (def spacing (?? props.spacing grid-spacing))
        (def min-w (?? props.min-width min-width))
        (def max-w (?? props.max-width max-width))
        
        (def screen-width (+ media-query.width grid-spacing))
        (def n (min (max 1 (floor (/ screen-width (+ min-w grid-spacing)))) (length props.children)))
        (def width (- (/ screen-width n) grid-spacing))

        (def (adopt child)
            (container
                :width width
                :constraints (box-constraints
                    :min-width min-w
                    :max-width max-w
                )
                :child child
            )
        )

        (wrap
            :spacing spacing
            :run-spacing spacing
            :children (map adopt props.children)
        )
    )
)
