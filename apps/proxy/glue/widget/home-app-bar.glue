(module widget.home-app-bar
    (export home-app-bar)

    (import lib.data)
    (import lib.navigation)

    (import widget.app-bar)
    (import widget.site-breadcrumbs)

    (def (site-title props)
        (icon-button
            :child (single-child-scroll-view
                :scroll-direction axis.horizontal
                :child (row
                    :spacing 8
                    :cross-axis-alignment cross-axis-alignment.center
                    :children (
                        (icon
                            :icon (symbol 'home)
                        )
                        (text
                            :text (title props.site)
                            :style current-theme.text-theme.title-large
                        )
                        (site-breadcrumbs
                            :site props.site.parent
                            :action (\ (id) (go :route 'site :id id))
                        )
                    )
                )
            )
        )
    )
    
    (def (home-app-bar props)
        (app-bar
            :leading (
                (icon-button
                    :child (icon :icon (symbol 'weather.mix))
                    :on-pressed (go :route 'weather)
                )
                (site-title props)
                (icon-button
                    :child (icon :icon (symbol 'dashboard))
                    :on-pressed (go :route 'systems)
                )
            )
            :trailing (
                (icon-button
                    :child (icon :icon (symbol 'settings))
                    :on-pressed (go :route 'settings)
                )
            )
        )
    )

)
