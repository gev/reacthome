(module widget.site-info
    (export site-info)

    (import lib.i18n)
    (import widget.site-aggregate)

    (def (site-info-container props)
        (filled-card
            :child (column
                :children props.children)
        )
    )

    (def (site-info-parameter props)
        (list-tile
            :leading (icon
                :icon (symbol props.icon.symbol)
                :color current-theme.color-scheme.on-surface
                :fill props.icon.fill
            )
            :title (text
                :content (select-locale props.label)
            )
            :trailing (row
                :spacing 4
                :main-axis-size main-axis-size.min
                :children (
                    (if (is-exist props.description)
                        (text
                            :content (select-locale props.description)
                            :style (text-style
                                :font-size current-theme.text-theme.title-medium.font-size
                                :color current-theme.color-scheme.on-surface-variant
                            )
                        )
                    )
                    (if (is-exist props.value)
                        (text
                            :content props.value
                            :style current-theme.text-theme.title-medium
                        )
                    )
                    (if (is-exist props.unit)
                        (text
                            :content props.unit
                            :style (text-style
                                :font-size current-theme.text-theme.title-medium.font-size
                                :color current-theme.color-scheme.on-surface-variant
                            )
                        )
                    )
                )
            )
        )
    )

    (def (site-info props)
        (site-aggregate
            :container site-info-container
            :parameter site-info-parameter
            :sites (# props.site)
            :acc ()
        )
    )
)
    
