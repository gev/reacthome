(module widget.site-info
    (export site-info)

    (import lib.combinator)
    (import lib.data)

    (def (site s)
        (text :content (title s))
    )

    (def (combine sites)
        (column
            :children (map site (flatten sites))
        )
    )

    (def (info-gen rec site)
        (def (handle i)
            (def is (site i))
            (if (is-exist i.site)
                (read (react (append is) (map rec i.site)))
                is
            )
        )
        (select handle site)
    )

    (def (site-info props)
        (def go (Z info-gen))
        (listen combine (go props.site))
    )
)
