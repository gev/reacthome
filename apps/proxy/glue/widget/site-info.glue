(module widget.site-info
    (export site-info)

    (import lib.combinator)
    (import locale.parameter)

    (def (fixed value)
        (/ (round (* value 10)) 10)
    )

    (def (empty value)
        (:value value :count 0 :total 0)
    )

    (def (monoid op prop acc val)
        (def value (@ val prop))
        (if (is-exist value)
            (
                :value (op acc.value value)
                :count (? value (+ acc.count 1) acc.count)
                :total (+ acc.total 1)
            )
            (acc)
        )
    )

    (def (state prop site)
        (def keys (@ site prop))
        (if (is-exist keys)
            (map remote-persistent-state keys)
            ()
        )
    )

    (def (states prop sites)
        (map (state prop) sites)
    )

    (def (site-parameter props)
        (row
            :spacing 16
            :children (
                (icon
                    :icon (symbol props.icon.symbol)
                    :color theme.color-scheme.on-surface
                    :fill props.icon.fill
                    :size 16
                )
                (text :content (@ props.label locale.language-code))
                (text :content props.value)
            )
        )
    )

    (def (aggregate-lights lights)
        (def acc (foldl (monoid || 'value) (empty false) lights))
        (if (> acc.total 0)
            (site-parameter
                :label light'
                :icon (
                    :symbol 'lightbulb.2
                    :fill (? acc.value 1 0)
                )
                :value acc.count
            )
            ()
        )
    )

    (def (aggregate-sensors props)
        (def acc (foldl (monoid + props.prop) (empty 0) props.sites))
        (if (> acc.total 0)
            (site-parameter
                :label props.label
                :icon (
                    :symbol (props.icon)
                    :fill false
                )
                :value (fixed acc.value)
            )
            ()
        )
    )

    (def (aggregate sites)
        (def lights_220 (states 'light_220 sites))
        (def lights_LED (states 'light_LED sites))
        (def lights_all (flatten (# lights_220 lights_LED)))
        (def children (flatten
                (#
                    (if (is-exist lights_all)
                        (listen aggregate-lights lights_all)
                        ()
                    )
                    (aggregate-sensors
                        :label temperature'
                        :icon 'lightbulb.2
                        :prop 'temperature
                        :sites sites
                    )
                    (aggregate-sensors
                        :label humidity'
                        :icon 'lightbulb.2
                        :prop 'humidity
                        :sites sites
                    )
                    (aggregate-sensors
                        :label CO2'
                        :icon 'lightbulb.2
                        :prop 'co2
                        :sites sites
                    )
                )
            )
        )
        (if (is-exist children)
            (filled-card
                :child (padding
                    :padding (edge-insets-all 16)
                    :child (column
                        :children children
                    )
                )
            )
            (sized-box :width 0 :height 0)
        )
    )

    (def (has-children site)
        (is-exist site.site)
    )

    (def (get-children site)
        (site.site)
    )

    (def (info-gen rec props)
        (def (go sites)
            (def sites-with-children (filter has-children sites))
            (def children (map get-children sites-with-children))
            (rec
                :sites (flatten children)
                :acc (concat props.acc sites)
            )
        )
        (if (is-empty props.sites)
            (aggregate props.acc)
            (listen go (map remote-persistent-state props.sites))
        )
    )

    (def info (Z info-gen))

    (def (site-info props)
        (info
            :sites (# props.site)
            :acc ()
        )
    )
)
    
