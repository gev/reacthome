(module widget.site-info
    (export site-info)

    (import lib.combinator)
    (import lib.data)

    (def (info props)
        (text :content (title props))
    )

    (def (combine sites)
        (column
            :children (map info sites)
        )
    )

    (def (has-children site)
        (is-exist site.site)
    )

    (def (get-children site)
        (site.site)
    )

    (def (info-gen rec props)
        (def (go i)
            (def sites-with-children (filter has-children i))
            (def children (map get-children sites-with-children))
            (def acc (append props.acc i))
            (rec :sites (flatten children) :acc acc)
        )
        (if (is-empty props.sites)
            (combine props.acc)
            (listen go (map remote-persistent-state props.sites))
        )
    )

    (def (site-info props)
        (def go (Z info-gen))
        (go :sites (# props.site) :acc ())
    )
)
