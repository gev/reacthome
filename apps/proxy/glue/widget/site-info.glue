(module widget.site-info
    (export site-info)

    (import lib.combinator)

    (def (fixed value)
        (/ (round (* value 10)) 10)
    )

    (def (empty value)
        (:value value :count 0 :total 0)
    )

    (def (monoid op prop acc val)
        (def value (@ val prop))
        (if (is-exist value)
            (
                :value (op acc.value value)
                :count (? acc.value (+ acc.count 1) acc.count)
                :total (+ acc.total 1)
            )
            (acc)
        )
    )

    (def (state prop site)
        (def keys (@ site prop))
        (if (is-exist keys)
            (map remote-persistent-state keys)
            ()
        )
    )

    (def (states prop sites)
        (map (state prop) sites)
    )

    (def (site-light lights)
        (def acc (foldl (monoid || 'value) (empty false) lights))
        (if (> acc.total 0)
            (text :content (? acc.value 1 0))
            ()
        )
    )

    (def (site-sensor prop sites)
        (def acc (foldl (monoid + prop) (empty 0) sites))
        (if (> acc.total 0)
            (text :content (fixed (/ acc.value acc.total)))
            ()
        )
    )

    (def (aggregate sites)
        (def light_220 (states 'light_220 sites))
        (def light_LED (states 'light_LED sites))
        (def light_all (flatten (# light_220 light_LED)))
        (def children (flatten (#
                    (if (is-exist light_all)
                        (listen site-light light_all)
                        ()
                    )
                    (site-sensor 'temperature sites)
                    (site-sensor 'humidity sites)
                    (site-sensor 'co2 sites)
                )))
        (if (is-exist children)
            (column
                :children children
            )
        )
    )

    (def (has-children site)
        (is-exist site.site)
    )

    (def (get-children site)
        (site.site)
    )

    (def (info-gen rec props)
        (def (go i)
            (def sites-with-children (filter has-children i))
            (def children (map get-children sites-with-children))
            (rec
                :sites (flatten children)
                :acc (concat props.acc i)
            )
        )
        (if (is-empty props.sites)
            (aggregate props.acc)
            (listen go (map remote-persistent-state props.sites))
        )
    )

    (def info (Z info-gen))

    (def (site-info props)
        (print props)
        (info
            :sites (# props.site)
            :acc ()
        )
    )
)
    
