(module widget.site-info
    (export site-info)

    (import widget.site-aggregate)

    (def (site-info-container props)
        (filled-card
            :child (column
                :children props.children)
        )
    )

    (def (site-info-parameter props)
        (list-tile
            :leading (icon
                :icon (symbol props.icon.symbol)
                :color current-theme.color-scheme.on-surface
                :fill props.icon.fill
            )
            :title (text
                :content (@ props.label locale.language-code)
            )
            :trailing (text
                :content props.value
                :style current-theme.text-theme.title-medium
            )
        )
    )

    (def (site-info props)
        (site-aggregate
            :container site-info-container
            :parameter site-info-parameter
            :sites (# props.site)
            :acc ()
        )
    )
)
    
