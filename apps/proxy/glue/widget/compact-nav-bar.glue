(module widget.compact-nav-bar
    (export nav-bar)

    (import lib.navigation)

    (import widget.floating-bar)
    (import widget.selected-button)

    (def (nav-bar props)
        (row
            :main-axis-alignment main-axis-alignment.center
            :spacing 16
            :children (
                (floating-bar
                    :child (padding
                        :padding (edge-insets-all 8)
                        :child (row
                            :spacing 16
                            :children (
                                (selected-button
                                    :icon (symbol 'weather.mix)
                                    :selected (== props.current-screen 0)
                                    :on-select (props.select-screen 0)
                                )
                                (selected-button
                                    :icon (symbol 'home)
                                    :selected (== props.current-screen 1)
                                    :on-select (props.select-screen 1)
                                )
                                (selected-button
                                    :icon (symbol 'dashboard)
                                    :selected (== props.current-screen 2)
                                    :on-select (props.select-screen 2)
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
