(module widget.compact-nav-bar
    (export nav-bar)

    (import lib.navigation)

    (import screen.home)
    (import screen.dashboard)
    (import screen.weather)

    (import widget.floating-bar)

    (def (nav-bar-button props)
        (button
            :on-pressed props.on-pressed
            :style (button-style
                :elevation (? props.selected 1 0)
                :background-color (
                    ? props.selected
                    current-theme.color-scheme.secondary-container
                    colors.transparent
                )
                :foreground-color (
                    ? props.selected
                    current-theme.color-scheme.on-secondary-container
                    current-theme.color-scheme.on-surface-variant
                )
            )
            :child (icon
                :fill (? props.selected 1 0)
                :icon (symbol props.symbol)
            )
        )
    )

    (def (show screen)

    )

    (def (nav-bar props)
        (def index (local-state 1))
        (row
            :main-axis-alignment main-axis-alignment.center
            :spacing 16
            :children (
                (floating-bar
                    :child (padding
                        :padding (edge-insets-all 8)
                        :child (row
                            :spacing 16
                            :children (
                                (nav-bar-button
                                    :symbol 'weather.mix
                                    :selected false
                                )
                                (nav-bar-button
                                    :symbol 'home
                                    :selected true
                                )
                                (nav-bar-button
                                    :symbol 'dashboard
                                    :selected false
                                )
                            )
                        )
                    )
                )
                (floating-bar
                    :child (padding
                        :padding (edge-insets-all 8)
                        :child (icon-button
                            :child (icon :icon (symbol 'settings))
                            :on-pressed (go :route 'settings)
                        )
                    )
                )
            )
        )
    )
)
