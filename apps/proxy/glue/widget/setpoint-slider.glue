(module widget.setpoint-slider
    (export setpoint-slider)

    (import lib.conversion)
    (import lib.optimistic)

    (import widget.modal)
    (import widget.regulator-theme)
    (import widget.site-breadcrumbs)

    (def (slider on-changed param value)
        (def color-scheme (regulator-color-scheme current-theme))
        (stack
            :alignment alignment.center
            :children (
                (circular-slider
                    :value value
                    :min param.min
                    :max param.max
                    :diameter 256
                    :width 24
                    :focused-width 32
                    :active-color color-scheme.on-surface
                    :inactive-color color-scheme.dimmed
                    :on-changed on-changed
                )
                (column
                    :children(
                        (text
                            :content (round-to-resolution value param.resolution)
                            :style (text-style
                                :font-size current-theme.text-theme.display-medium.font-size
                                :color color-scheme.on-surface
                            )
                        )
                        (text
                            :content param.unit
                            :style (text-style
                                :font-size current-theme.text-theme.display-small.font-size
                                :color color-scheme.variant
                            )
                        )
                    )
                )
            )
        )
    )

    (def throttle-200
        (throttle (duration :milliseconds 200))
    )
    
    (def (setpoint-slider props)
        (def state
            (optimistic
                :value props.value
                :on-changed (\ (value)
                    (throttle-200 (props.action value))
                )
            )
        )
        (listen (slider state.set-value props.param) state.value)
    )
)
