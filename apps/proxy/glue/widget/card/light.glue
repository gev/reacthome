(module widget.card.light
    (export light-card)

    (import lib.data)
    (import widget.iconic)
    (import iconic.light)

    (def (light label status)
        (padding
            :padding (edge-insets-symmetric :horizontal 16 :vertical 8)
            :child (row
                :spacing 16
                :children (
                    (column
                        :cross-axis-alignment cross-axis-alignment.start
                        :children (
                            (text
                                :content label
                                :style theme.text-theme-label-medium
                            )
                            (text
                                :content status
                                :style theme.text-theme.title-large
                            )
                        )
                    )
                    (iconic :icon iconic-lamp :size 40)
                )
            )
        )
    )

    (def (show container status props)
        (container
            :key props.id
            :clip-behavior clip.anti-alias
            :child (light status props)
        )
    )

    (def (run action) (\ () (post action)))
    (def (turn-on uid) (run ('on uid)))
    (def (turn-off uid) (run ('off uid)))
    (def (convert value) (round (* (/ value 255) 100)))


    (def (show-dimmable container action status props)
        (container
            :key props.id
            :clip-behavior clip.anti-alias
            :child (ink-well
                :on-tap (action props.id)
                :child (light (title props) status)
            )
        )
    )

    (def (show-non-dimmable container action status props)
        (container
            :key props.id
            :clip-behavior clip.anti-alias
            :child (ink-well
                :on-tap (action props.id)
                :child (light (title props) status)
            )
        )
    )

    (def (light-dimmable props bind)
        (if (bind.value)
            (show-dimmable filled-card turn-off (convert bind.value) props)
            (show-dimmable outlined-card turn-on "OFF" props)
        )
    )

    (def (light-non-dimmable props bind)
        (if (bind.value)
            (show-non-dimmable filled-card turn-off "ON" props)
            (show-non-dimmable outlined-card turn-on "OFF" props)
        )
    )

    (def (light-bound props bind)
        (if (bind.dimmable)
            (light-dimmable props bind)
            (light-non-dimmable props bind)
        )
    )

    (def (light-card props)
        (if (is-exist props.bind)
            (select (light-bound props) props.bind)
            (show outlined-card "N/A" props)
        )
    )
)
