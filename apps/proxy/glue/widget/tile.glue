(module widget.tile
    (export
        tile
        tile-leading
        tile-label
        tile-status
        tile-details
    )

    (def (tile-leading props)
        (icon
            :icon (symbol props.symbol)
            :color props.color
            :fill (?? props.fill 0)
            :size 32
        )
    )


    (def (tile-label props)
        (text
            :content props.text
            :style (text-style
                :color props.color
                :font-size current-theme.text-theme.label-medium.font-size
                :font-weight font-weight.w400
            )
        )
    )

    (def (tile-status props)
        (text
            :content props.text
            :style (text-style
                :color props.color
                :font-size current-theme.text-theme.title-medium.font-size
                :font-weight font-weight.w600
            )
        )
    )

    (def (tile-details props)
        (text
            :content props.text
            :style (text-style
                :color props.color
                :font-size current-theme.text-theme.title-medium.font-size
                :font-weight font-weight.w400
            )
        )
    )

    (def (tile props)
        (row
            :spacing 8
            :children (
                (tile-leading props.icon)
                (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (tile-label props.label)
                        (row
                            :spacing 4
                            :children (
                                (tile-status props.status)
                                (? (is-exist props.details)
                                    (tile-details props.details))
                            )
                        )
                    )
                )
            )
        )
    )
)
