(module widget.regulator-intensity
    (export regulator-intensity)

    (import i18n.parameter)

    (import lib.i18n)
    (import lib.property)

    (import lib.optimistic)
    (import widget.regulator-theme)

    (def (segment i)
        (button-segment
            :label (text :content i)
            :value i
        )
    )

    (def (segments props)
        (map segment (range props.min props.max))
    )

    (def (regulator-intensity props)
        (def color-scheme (regulator-color-scheme current-theme))
        (def state
            (optimistic
                :value props.value
                :on-changed props.on-changed
            )
        )
        (def (tile value)
            (column
                :children (
                    (list-tile
                        :leading (icon
                            :icon (symbol fan.icon)
                            :color color-scheme.on-surface
                        )
                        :title (text
                            :content (select-locale i18n-speed)
                            :style (text-style
                                :color color-scheme.on-surface
                            )
                        )
                        :trailing (text
                            :content (round value)
                            :style (text-style
                                :font-size current-theme.text-theme.title-medium.font-size
                                :color color-scheme.on-surface
                            )
                        )
                    )
                    (slider
                        :min 0
                        :max (- props.max 1)
                        :divisions (- props.max 1)
                        :value value
                        :on-changed state.set-value
                        :thumb-color color-scheme.on-surface
                        :active-color color-scheme.on-surface
                        :inactive-color color-scheme.dimmed

                    )
                )
            )
        )
        (listen tile state.value)
    )
)
