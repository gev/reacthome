(module widget.curtain-regulator
    (export
        positioned-curtain-regulator
        non-positioned-curtain-regulator
    )

    (import i18n.action)
    (import i18n.status)

    (import lib.action)
    (import lib.data)
    (import lib.i18n)
    (import lib.parameter)
    (import lib.system)

    (import widget.entity-modal)

    (def (positioned-curtain-regulator props bind)
        (def state (local-state 0.5))
        (def background-color
            (if bind.value
                current-theme.color-scheme.surface-dim
                current-theme.color-scheme.surface-bright
            )
        )
        (entity-modal
            :site props.site
            :background-color background-color
            :title (title props)
            :display (select-locale (? bind.value i18n-closed i18n-opened))
            :unit position.unit
            :body (listen
                (\ (value)
                    (double-curtain
                        :active-color current-theme.color-scheme.tertiary
                        :jump-to-tap false
                        :value value
                        :on-changed (\ (value) (write state value))
                    )
                )
                state
            )
        )
    )

    (def (non-positioned-curtain-regulator props bind)
        (def state (local-state 0.5))
        (def background-color
            (if bind.value
                current-theme.color-scheme.surface-dim
                current-theme.color-scheme.surface-bright
            )
        )
        (entity-modal
            :site props.site
            :background-color background-color
            :title (title props)
            :display (select-locale (? bind.value i18n-closed i18n-opened))
            :body (listen
                (\ (value)
                    (double-curtain
                        :active-color current-theme.color-scheme.tertiary
                        :jump-to-tap false
                        :value value
                        :on-changed (\ (value) (write state value))
                    )
                )
                state
            )
        )
    )
)
