(module widget.site-theme
    (export site-theme)

    (def (apply-palette site palette props constraints)
        (with-seed-color
            :seed-color palette.seed-color
            :dynamic-scheme-variant palette.dynamic-scheme-variant
            :child (site palette props constraints)
        )
    )

    (def (site-theme site props constraints)
        (if (exists? props.site.palette.vibrant)
            (let
                (def palette (
                        :seed-color props.site.palette.vibrant
                        :dynamic-scheme-variant dynamic-scheme-variant.content
                    )
                )
                (apply-palette site palette props constraints)
            )
            (site _ props constraints)
        )
    )
)
