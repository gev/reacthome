(module widget.entity-modal
    (export entity-modal)

    (import widget.modal)
    (import widget.site-breadcrumbs)

    (def (title value)
        (text
            :content value
            :style (text-style
                :font-size current-theme.text-theme.title-large.font-size
                :color current-theme.color-scheme.on-surface-variant
                :font-weight font-weight.w400
            )
        )
    )

    (def (display value)
        (text
            :content value
            :style (text-style
                :font-size current-theme.text-theme.headline-large.font-size
                :color current-theme.color-scheme.on-surface
                :font-weight font-weight.w600
            )
        )
    )

    (def (entity-modal props)
        (modal
            :color (?? props.background-color
                current-theme.color-scheme.surface-container)
            :child (column
                :spacing 16
                :main-axis-size main-axis-size.min
                :children (
                    (title props.title)
                    (site-breadcrumbs :site props.site)
                    (row
                        :spacing 8
                        :main-axis-size main-axis-size.min
                        :children (
                            (?> display props.display)
                            (?> display props.value)
                            (?> display props.unit)
                        )
                    )
                    (props.body)
                )
            )
        )
    )
)
