(module widget.curtain
    (export curtain)

    (import lib.actions)
    (import lib.data)

    (import i18n.action)
    (import i18n.status)

    (import widget.modal)
    (import widget.site-breadcrumbs)

    (def (curtain props bind)
        (def color
            (if bind.value
                current-theme.color-scheme.surface-dim
                current-theme.color-scheme.surface-bright
            )
        )
        (modal
            :color color
            :child (column
                :spacing 16
                :main-axis-size main-axis-size.min
                :children (
                    (text
                        :content (title props)
                        :style (text-style
                            :font-size current-theme.text-theme.title-large.font-size
                            :color current-theme.color-scheme.on-surface-variant
                            :font-weight font-weight.w400
                        )
                    )
                    (site-breadcrumbs :site props.site)
                    (text
                        :content (@ (? bind.value i18n-closed i18n-opened) locale.language-code)
                        :style (text-style
                            :font-size current-theme.text-theme.display-medium.font-size
                            :color current-theme.color-scheme.on-surface
                            :font-weight font-weight.w600
                        )
                    )
                    (double-curtain
                        :jump-to-tap false
                    )
                    (wrap
                        :spacing 16
                        :run-spacing 8
                        :main-axis-alignment main-axis-alignment.center
                        :children (
                            (button
                                :child (text
                                    :content (@ i18n-open locale.language-code)
                                )
                            )
                            (button
                                :child (text
                                    :content (@ i18n-stop locale.language-code)
                                )
                            )
                            (button
                                :child (text
                                    :content (@ i18n-close locale.language-code)
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
