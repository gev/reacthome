(module widget.temperature-regulator
    (export
        temperature-regulator-mode
        temperature-regulator-color
        temperature-regulator
    )

    (import lib.actions)
    (import lib.property)

    (import widget.regulator-modal)
    (import widget.regulator-mode)
    (import widget.regulator-toggle)
    (import widget.regulator-intensity)
    (import widget.setpoint-slider)

    (def (temperature-regulator-mode mode)
        (if (== mode "cool")
            cooling
            (if (== mode "heat")
                heating
                void
            )
        )
    )

    (def (temperature-regulator-color mode)
        (?? mode.color colors.grey)
    )

    (def (select-mode regulator mode on-changed)
        (padding
            :padding (edge-insets-symmetric :vertical 16)
            :child (regulator-mode
                :mode mode
                :modes (# cooling heating)
                :on-changed on-changed
            )
        )
    )

    (def (setpoint regulator)
        (setpoint-slider
            :value regulator.setpoint
            :param temperature
            :action (set-temperature-setpoint regulator.id)
        )
    )

    (def (toggle regulator)
        (regulator-toggle
            :value regulator.cool
            :on-changed (toggle-cool regulator.id)
        )
    )

    (def (intensity regulator)
        (regulator-intensity
            :value regulator.cool_intensity
            :min 0
            :max (length regulator.onCoolIntensity)
            :on-changed (set-cool-intensity regulator.id)
        )
    )

    (def (regulator-body regulator mode on-changed)
        (column
            :children (
                (select-mode regulator mode on-changed)
                (setpoint regulator)
                (toggle regulator)
                (intensity regulator)
            )
        )
    )

    (def (temperature-regulator mode site regulator)
        (def state
            (local-state mode)
        )
        (def (on-changed mode)
            (write state mode)
        )
        (def (regulator-mode mode)
            (with-seed-color
                :seed-color (temperature-regulator-color mode)
                :dynamic-scheme-variant dynamic-scheme-variant.content
                :child (regulator-modal
                    :site site
                    :regulator regulator
                    :param temperature
                    :body (regulator-body regulator mode on-changed)
                )
            )
        )
        (listen regulator-mode state)
    )
)
