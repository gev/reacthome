(module widget.heater-regulator
    (export heater-regulator)

    (import i18n.status)

    (import lib.action)
    (import lib.conversion)
    (import lib.data)
    (import lib.optimistic)
    (import lib.parameter)

    (import widget.entity-modal)
    
    (def (regulator-modal props on-changed setpoint sensor)
        (def background-color
            (if props.value
                current-theme.color-scheme.surface-bright
                current-theme.color-scheme.surface-dim
            )
        )
        (entity-modal
            :site props.site
            :background-color background-color
            :title (title props)
            :value (round-to-resolution setpoint temperature.resolution)
            :unit temperature.unit
            :body (vertical-slider
                :value setpoint
                :min 10
                :max 35
                :width 60
                :height 200
                :focused-width 90
                :border-radius 30
                :active-color current-theme.color-scheme.secondary
                :on-changed on-changed
            )
        )
    )

    (def throttle-200
        (throttle (duration :milliseconds 200))
    )
    
    (def (heater-regulator props bind)
        (def dim-heater (set-min-max-setpoint props.id))
        (def setpoint (/ (+ (?? props.min 5) (?? props.max 5)) 2))
        (def state
            (optimistic
                :value setpoint
                :on-changed (\ (value)
                    (throttle-200 (dim-heater value))
                )
            )
        )
        (def sensor (remote-persistent-state props.sensor))
        (listen (regulator-modal props state.set-value) state.value sensor)
    )
)
