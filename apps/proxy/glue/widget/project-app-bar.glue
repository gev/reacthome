(module widget.project-app-bar
    (export project-app-bar)

    (import i18n.dict)
    (import i18n.system)
    (import i18n.weather)

    (import lib.i18n)
    (import lib.data)
    (import lib.navigation)
    
    (import widget.app-bar)

    (def (label props)
        (text
            :text props.text
            :style current-theme.text-theme.title-medium
        )
    )
    
    (def (app-bar-button props)
        (button
            :on-pressed props.on-pressed
            :style (button-style
                :elevation (? props.selected 1 0)
                :background-color (
                    ? props.selected
                    current-theme.color-scheme.secondary-container
                    colors.transparent
                )
                :foreground-color (
                    ? props.selected
                    current-theme.color-scheme.on-secondary-container
                    current-theme.color-scheme.on-surface-variant
                )
            )
            :child (if (exists? props.title)
                (row
                    :spacing 8
                    :main-axis-size main-axis-size.min
                    :cross-axis-alignment cross-axis-alignment.center
                    :children (
                        (icon
                            :fill (? props.selected 1 0)
                            :icon props.symbol
                        )
                        (text :text props.title)
                    )
                )
                (icon
                    :fill (? props.selected 1 0)
                    :icon props.symbol
                )
            )
        )
    )

    (def (project-app-bar props)
        (app-bar
            :title (padding
                :padding (edge-insets-all 4)
                :child (row
                    :spacing 4
                    :children (
                        (app-bar-button
                            :symbol 'home
                            :title (select-locale i18n-home)
                            :selected (== props.current-screen 1)
                            :on-pressed (props.select-screen 1)
                        )
                        (app-bar-button
                            :symbol 'dashboard
                            :title (select-locale i18n-systems)
                            :selected (== props.current-screen 2)
                            :on-pressed (props.select-screen 2)
                        )
                        (app-bar-button
                            :symbol 'weather.mix
                            :title (select-locale i18n-weather)
                            :selected (== props.current-screen 0)
                            :on-pressed (props.select-screen 0)
                        )
                    )
                )
            )
            :trailing (
                (icon-button
                    :child (icon :icon (symbol 'settings))
                    :on-pressed (go :route 'settings :target applet)
                )
            )
        )
    )
)
