(module widget.selected-list-tile
    (export selected-list-tile)

    (def (selected-list-tile props)
        (ink-well
            :on-tap props.on-select
            :child (list-tile
                :leading (icon
                    :fill (? props.selected 1 0)
                    :icon props.icon
                )
                :title (text :text props.label)
                :selected props.selected
                :selected-tile-color current-theme.color-scheme.primary-container
            )
        )
    )
)
