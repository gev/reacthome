(module widget.site-card
    (export site-card)

    (import lib.data)
    (import lib.navigation)

    (def (site-card props)
        (card
            :key props.id
            :clip-behavior clip.anti-alias
            :child (column
                :cross-axis-alignment cross-axis-alignment.stretch
                :children (
                    (if (is-exist props.image)
                        (aspect-ratio
                            :aspect-ratio 1.7778
                            :child (image
                                :fit box-fit.fit-width
                                :src props.image
                            )
                        )
                    )
                    (padding
                        :padding (edge-insets-all 16)
                        :child (outlined-button
                            :child (text :content (title props))
                            :on-pressed (go :route 'site :id props.id)
                        )
                    )
                )
            )
        )
    )
)
