(module widget.site-card
    (export site-card)

    (import lib.data)
    (import lib.navigation)
    (import widget.site-brief)

    (def (gradient start end)
        (box-decoration
            :gradient (linear-gradient
                :begin alignment.bottom-center
                :end alignment.top-center
                :colors (# start end)
                :stops (0 1)
            )
        )
    )

    (def (site-image props)
        (aspect-ratio
            :aspect-ratio 1.7778
            :child (image
                :image props.image
                :fit box-fit.cover
            )
        )
    )

    (def (site-title props)
        (row
            :children (text
                :content (title props)
                :style (text-style
                    :color colors.white
                    :font-size current-theme.text-theme.headline-medium.font-size
                    :font-weight font-weight.w400
                )
            )
        )
    )

    (def (site-ink-well props)
        (def color current-theme.color-scheme.primary-container)
        (def color1 (color.with :a 0.9))
        (def color2 (color.with :a 0.6))
        (def color3 (color.with :a 0.0))
        (ink-well
            :on-tap (go :route 'site :id props.id)
            :child
            (column
                :cross-axis-alignment cross-axis-alignment.stretch
                :main-axis-alignment main-axis-alignment.end
                :children (
                    (expanded
                        :child (container
                            :decoration (gradient color2 color3)
                        )
                    )
                    (column
                        :cross-axis-alignment cross-axis-alignment.start
                        :children (
                            (container
                                :padding (edge-insets-only :left 16 :right 16)
                                :decoration (gradient color1 color2)
                                :child (site-title props)
                            )
                            (container
                                :padding (edge-insets-only :left 16 :right 16 :bottom 8)
                                :color color1
                                :child (site-brief :site props.id)
                            )
                        )
                    )
                )
            )
        )
    )

    (def (site-stack props)
        (stack
            :children (
                (site-image :image (load-image :src props.image))
                (positioned
                    :top 0 :bottom 0 :left 0 :right 0
                    :child (material
                        :color colors.transparent
                        :child (site-ink-well props)
                    )
                )
            )
        )
    )
    
    (def (site-with-theme props)
        (def color-scheme
            (seed-color-scheme
                :seed props.palette.vibrant
                :brightness brightness.dark
            )
        )
        (with-theme
            :data (theme :color-scheme color-scheme)
            :child (site-stack props)
        )
    )

    (def (site-with-image props)
        (if (is-exist props.palette.vibrant)
            (site-with-theme props)
            (site-stack props)
        )
    )

    (def (site-card props)
        (card
            :key props.id
            :clip-behavior clip.anti-alias
            :child (if (is-exist props.image)
                (site-with-image props)
                (site-ink-well props)
            )
        )
    )
)
