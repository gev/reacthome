(module widget.optimistic
    (export optimistic)

    (def (optimistic props)
        (def state (optimistic-state (duration :seconds 1) props.value))
        (def (set-value value)
            (write state value)
            (props.on-changed value)
        )
        (
            :value state
            :set-value set-value
        )
    )

)
