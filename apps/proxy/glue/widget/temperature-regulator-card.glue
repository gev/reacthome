(module widget.temperature-regulator-card
    (export temperature-regulator-card)

    (import i18n.status)

    (import iconic.light)

    (import lib.actions)
    (import lib.data)
    (import lib.i18n)
    (import lib.navigation)
    (import lib.property)

    (import widget.cards)
    (import widget.entity-tile)
    (import widget.iconic)

    (def (temperature-regulator-tile props)
        (entity-tile
            :icon (
                :symbol temperature.icon
                :color (@ current-theme.color-scheme temperature.color)
                :fill (? props.value 1 0)
            )
            :label (:text (select-locale temperature.label))
            :status (:text props.temperature)
        )
    )
    
    (def (temperature-regulator-card temperature props)
        (print props)
        (active-card
            :key props.id
            :on-pressed (go :route 'light-dimmer :id props.id)
            :child (temperature-regulator-tile :temperature temperature)
        )
    )
)
