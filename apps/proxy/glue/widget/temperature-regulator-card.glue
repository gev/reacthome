(module widget.temperature-regulator-card
    (export temperature-regulator-card)

    (import i18n.status)

    (import iconic.light)

    (import lib.actions)
    (import lib.conversion)
    (import lib.data)
    (import lib.i18n)
    (import lib.navigation)
    (import lib.property)

    (import widget.entity-card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def (temperature-regulator-tile props)
        (entity-tile
            :icon (
                :symbol temperature.icon
                :color current-theme.color-scheme.on-primary
                :fill (? props.value 1 0)
            )
            :label (
                :text (select-locale temperature.label)
                :color current-theme.color-scheme.on-primary
            )
            :status (
                :text (round-to-resolution props.temperature temperature.resolution)
                :color current-theme.color-scheme.on-primary
            )
            :details (
                :text temperature.unit
                :color current-theme.color-scheme.on-primary
            )
            
        )
    )
    
    (def (temperature-regulator-card temperature props)
        (print props)
        (def color-scheme
            (seed-color-scheme
                :seed colors.blue
                :dynamic-scheme-variant dynamic-scheme-variant.content
                :brightness current-theme.color-scheme.brightness
            )
        )
        (with-theme
            :data (theme :color-scheme color-scheme)
            :child (active-card
                :key props.id
                :card-color current-theme.color-scheme.primary
                :on-pressed (go :route 'temperature-regulator :id props.id)
                :child (temperature-regulator-tile
                    :temperature temperature
                )
            )
        )
    )
)
