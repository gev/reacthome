(module widget.temperature-regulator-card
    (export temperature-regulator-card)

    (import lib.property)

    (import widget.regulator-card)
    (import widget.temperature-regulator)

    (def (temperature-regulator-card site regulator)
        (def mode (temperature-regulator-mode regulator.mode))
        (with-seed-color
            :key regulator.id
            :seed-color (temperature-regulator-color mode)
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-card
                :site site
                :regulator regulator
                :route 'temperature-regulator
                :param temperature
            )
        )
    )
)
