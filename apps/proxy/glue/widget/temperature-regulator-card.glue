(module widget.temperature-regulator-card
    (export temperature-regulator-card)

    (import iconic.light)

    (import lib.actions)
    (import lib.conversion)
    (import lib.data)
    (import lib.i18n)
    (import lib.navigation)
    (import lib.property)

    (import widget.card)
    (import widget.regulator-tile)
    (import widget.iconic)

    (def (temperature-regulator-card site regulator)
        (def color
            (if (== regulator.mode "cool")
                colors.blue
                (if (== regulator.mode "heat")
                    colors.red
                    colors.grey
                )

            )
        )
        (def color-scheme
            (seed-color-scheme
                :seed color
                :dynamic-scheme-variant dynamic-scheme-variant.content
                :brightness current-theme.color-scheme.brightness
            )
        )
        (with-theme
            :key regulator.id
            :data (theme :color-scheme color-scheme)
            :child (active-card
                :tag regulator.id
                :card-color current-theme.color-scheme.primary
                :on-pressed (go
                    :route 'temperature-regulator
                    :id regulator.id
                    :site site.id
                    :mode regulator.mode
                )
                :child (regulator-tile
                    :param temperature
                    :value site.temperature
                    :setpoint (
                        :value regulator.setpoint
                        :color current-theme.color-scheme.on-primary
                    )
                )
            )
        )
    )
)
