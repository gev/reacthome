(module widget.site-body
    (export site-body)

    (import lib.data)
    (import lib.navigation)

    (import widget.grid)
    (import widget.site-breadcrumbs)
    (import widget.site-info)
    (import widget.site-card)
    (import widget.light-card)
    (import widget.curtain-card)
    (import widget.camera-card)
    (import widget.temperature-regulator-card)
    (import widget.humidity-regulator-card)
    (import widget.ventilation-regulator-card)

    (def (scroll-row props)
        (single-child-scroll-view
            :scroll-direction axis.horizontal
            :children (row props)
        )
    )

    (def (select-in container go items)
        (if (exists? items)
            (container
                :spacing 16
                :children (select-collection go items)
            )
        )
    )

    (def (site-body palette props)
        (column
            :spacing 16
            :cross-axis-alignment cross-axis-alignment.start
            :children (
                (select-in grid (light-card palette) props.light_220)
                (select-in grid (light-card palette) props.light_LED)
                (scroll-row
                    :spacing 16
                    :children (
                        (select-in row (temperature-regulator-card props) props.thermostat)
                        (select-in row (humidity-regulator-card props) props.hygrostat)
                        (select-in row (ventilation-regulator-card props) props.co2_stat)
                    )
                )
                (select-in grid (curtain-card palette) props.curtains)
                (select-in scroll-row (camera-card palette) props.camera)
                (select-in grid site-card props.site)
            )
        )
    )
)
