(module widget.cards
    (export
        active-card
        inactive-card
    )

    (import lib.log)

    (def min-w 144)
    (def max-w 196)
    (def gap 16)

    (def (adopt child)
        (def screen-width (+ media-query.width gap))
        (def n (max 1 (floor (/ screen-width (+ min-w gap)))))
        (def width (- (/ screen-width n) (* 1.5 gap)))
        (log-info (# media-query.width n width))
        (container
            :width width
            :constraints (box-constraints
                :min-width min-w
                :max-width max-w
            )
            :child (padding
                :padding (edge-insets-symmetric :horizontal 8 :vertical 8)
                :child child
            )
        )
    )

    (def (inactive-card props)
        (card
            :key props.key
            :clip-behavior clip.anti-alias
            :color props.card-color
            :elevation props.elevation
            :child (adopt props.child)
        )
    )

    (def (active-card props)
        (hero
            :tag props.key
            :key props.key
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :child (ink-well
                    :on-tap props.on-pressed
                    :on-long-press props.on-long-press
                    :child (adopt props.child)
                )
            )
        )
    )
)
