(module widget.cards
    (export
        active-card
        inactive-card
    )

    (def (adopt-width child)
        (def screen-width media-query.width)
        (def n (floor (/ screen-width 160)))
        (def space (* n 16))
        (def width (/ (- screen-width space) n))
        (container
            :width width
            :constraints (box-constraints
                :min-width 180
                :max-width 360
            )
            :child (padding
                :padding (edge-insets-symmetric :horizontal 16 :vertical 8)
                :child child
            )
        )
    )

    (def (inactive-card props)
        (card
            :key props.key
            :clip-behavior clip.anti-alias
            :color props.card-color
            :elevation props.elevation
            :child (adopt-width props.child)
        )
    )

    (def (active-card props)
        (hero
            :tag props.key
            :key props.key
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :child (ink-well
                    :on-tap props.on-pressed
                    :on-long-press props.on-long-press
                    :child (adopt-width props.child)
                )
            )
        )
    )
)
