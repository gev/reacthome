(module widget.cards
    (export
        active-card
        inactive-card
    )

    (def (adopt child)
        (def screen-width (+ media-query.width 16))
        (def n (floor (/ screen-width 160)))
        (def width (- (? (> n 1) (/ screen-width n) screen-width) 16))
        (container
            :width width
            :constraints (box-constraints
                :min-width 144
                :max-width 196
            )
            :child (padding
                :padding (edge-insets-symmetric :horizontal 16 :vertical 8)
                :child child
            )
        )
    )

    (def (inactive-card props)
        (card
            :key props.key
            :clip-behavior clip.anti-alias
            :color props.card-color
            :elevation props.elevation
            :child (adopt props.child)
        )
    )

    (def (active-card props)
        (hero
            :tag props.key
            :key props.key
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :child (ink-well
                    :on-tap props.on-pressed
                    :on-long-press props.on-long-press
                    :child (adopt props.child)
                )
            )
        )
    )
)
