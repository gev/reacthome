(module widget.ventilation-regulator-active-card
    (export ventilation-regulator-active-card)

    (import lib.property)

    (import widget.regulator-title)
    (import widget.regulator-active-card)
    (import widget.ventilation-regulator)

    (def (ventilation-regulator-active-card site regulator)
        (with-seed-color
            :key regulator.id
            :seed-color ventilation-regulator-color
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-active-card
                :title (regulator-title
                    :param CO2
                    :value (@ site CO2.property)
                )
                :body (ventilation-regulator regulator)
            )
        )
    )
)
