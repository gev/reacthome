(module widget.curtain-regulator-active-card
    (export curtain-regulator-active-card)

    (import i18n.action)
    (import i18n.status)

    (import lib.data)
    (import lib.i18n)
    (import lib.property)

    (import iconic.curtain)

    (import widget.card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def (curtain-tile props)
        (row
            :cross-axis-alignment cross-axis-alignment.start
            :main-axis-size main-axis-size.max
            :spacing 8
            :children (
                (expanded
                    :flex 1
                    :child (column
                        :spacing 8
                        :cross-axis-alignment cross-axis-alignment.stretch
                        :children (
                            (entity-tile
                                :icon (
                                    :symbol (? props.value curtains.icon.closed curtains.icon.opened)
                                    :color (@ current-theme.color-scheme curtains.color)
                                    :fill 1
                                )
                                :label (:text props.label)
                                :status (:text props.status)
                            )
                            (button
                                :child (text
                                    :text (select-locale i18n-open)
                                )
                            )
                            (button
                                :child (text
                                    :text (select-locale i18n-stop)
                                )
                            )
                            (button
                                :child (text
                                    :text (select-locale i18n-close)
                                )
                            )
                        )
                    )
                )
                (expanded
                    :flex 2
                    :child (double-curtain
                        :height 172
                        :active-color (@ current-theme.color-scheme curtains.color)
                        :jump-to-tap false
                    )
                )
            )
        )
    )

    (def (positioned-curtain-regulator-card props)
        (if (props.value)
            (inactive-card
                :key props.id
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-closed)
                )
            )
            (inactive-card
                :key props.id
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-opened)
                )
            )
        )
    )

    (def (non-positioned-curtain-regulator-card props)
        (if (props.value)
            (inactive-card
                :key props.id
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-on
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-closed)
                )
            )
            (inactive-card
                :key props.id
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-off
                :child (curtain-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-opened)
                )
            )
        )
    )

    (def (bound-curtain-regulator-card props bind)
        (def card
            (if bind.positioned
                positioned-curtain-regulator-card
                non-positioned-curtain-regulator-card
            )
        )
        (card
            :id props.id
            :label (title props)
            :value props.value
        )
    )

    (def (unbound-curtain-regulator-card props)
        (inactive-card
            :key props.id
            :card-color current-theme.color-scheme.surface-variant
            :elevation elevation-unbound
            :child (disabled-entity-tile
                :icon (:symbol (curtains.icon.opened))
                :label (:text (title props))
                :status (:text (select-locale i18n-not-available))
            )
        )
    )

    (def (curtain-regulator-active-card props)
        (if (exists? props.bind)
            (select (bound-curtain-regulator-card props) props.bind)
            (unbound-curtain-regulator-card props)
        )
    )
)
