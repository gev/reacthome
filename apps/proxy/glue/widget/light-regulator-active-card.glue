(module widget.light-regulator-active-card
    (export light-regulator-active-card)

    (import i18n.status)

    (import iconic.light)

    (import lib.actions)
    (import lib.conversion)
    (import lib.data)
    (import lib.i18n)
    (import lib.optimistic)
    (import lib.property)

    (import widget.card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def throttle-200
        (throttle (duration :milliseconds 200))
    )

    (def (light-tile props)
        (entity-tile
            :icon (
                :symbol light.icon
                :color (@ current-theme.color-scheme light.color)
                :fill (? props.value 1 0)
            )
            :label (:text props.label)
            :status (:text props.status)
        )
    )

    (def (dimmable-light-tile props)
        (column
            :spacing 8
            :children (
                (light-tile props)
                (horizontal-slider
                    :value props.value
                    :min 0
                    :max 100
                    :width 255
                    :height 24
                    :focused-width 48
                    :border-radius 8
                    :active-color (@ current-theme.color-scheme light.color)
                    :on-changed props.on-changed
                )
            )
        )
    )

    (def (regulator props on-changed value)
        (if (value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (dimmable-light-tile
                    :value value
                    :label props.label
                    :status (round-to-resolution value light.resolution)
                    :on-changed on-changed
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (dimmable-light-tile
                    :value props.brightness
                    :label props.label
                    :status (select-locale i18n-off)
                    :on-changed on-changed
                )
            )
        )
    )
    
    (def (dimmable-light-regulator-card props)
        (def dim-light (dim props.id))
        (def state
            (optimistic
                :value (to-percents props.brightness)
                :on-changed (\ (value)
                    (throttle-200 (dim-light (from-percents value)))
                )
            )
        )
        (listen (regulator props state.set-value) state.value)
    )

    (def (non-dimmable-light-regulator-card props)
        (if (props.value)
            (active-card
                :key props.id
                :on-pressed (turn-off props.id)
                :card-color current-theme.color-scheme.surface-bright
                :elevation elevation-on
                :child (light-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-on)
                )
            )
            (active-card
                :key props.id
                :on-pressed (turn-on props.id)
                :card-color current-theme.color-scheme.surface-dim
                :elevation elevation-off
                :child (light-tile
                    :value props.value
                    :label props.label
                    :status (select-locale i18n-off)
                )
            )
        )
    )

    (def (bound-light-regulator-card props bind)
        (def card
            (if bind.dimmable
                dimmable-light-regulator-card
                non-dimmable-light-regulator-card
            )
        )
        (card
            :id props.id
            :label (title props)
            :value props.value
            :brightness (if (exists? bind.brightness)
                (? bind.value bind.brightness 0)
                bind.value
            )
        )
    )

    (def (unbound-light-regulator-card props)
        (inactive-card
            :key props.id
            :card-color current-theme.color-scheme.surface-variant
            :elevation elevation-unbound
            :child (disabled-entity-tile
                :icon (:symbol light.icon)
                :label (:text (title props))
                :status (:text (select-locale i18n-not-available))
            )
        )
    )

    (def (light-regulator-active-card props)
        (if (exists? props.bind)
            (select (bound-light-regulator-card props) props.bind)
            (unbound-light-regulator-card props)
        )
    )
)
