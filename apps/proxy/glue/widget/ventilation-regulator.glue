(module widget.ventilation-regulator
    (export
        ventilation-regulator-color
        ventilation-regulator-modal
        ventilation-regulator-system
        ventilation-regulator
    )

    (import lib.action)
    (import lib.parameter)

    (import widget.regulator-modal)
    (import widget.regulator-toggle)
    (import widget.regulator-intensity)
    (import widget.setpoint-slider)

    (def ventilation-regulator-color colors.light-green)

    (def (setpoint regulator)
        (setpoint-slider
            :value regulator.setpoint
            :param CO2
            :action (set-co2-setpoint regulator.id)
        )
    )

    (def (toggle regulator)
        (regulator-toggle
            :value regulator.ventilation
            :on-changed (toggle-ventilation regulator.id)
        )
    )

    (def (intensity regulator)
        (regulator-intensity
            :value regulator.ventilation_intensity
            :min 0
            :max (length regulator.onVentilationIntensity)
            :on-changed (set-ventilation-intensity regulator.id)
        )
    )

    (def (ventilation-regulator-system regulator)
        (row
            :children (
                (expanded
                    :child (setpoint regulator)
                )
                (expanded
                    :child (column
                        :children (
                            (toggle regulator)
                            (intensity regulator)
                        )
                    )
                )
            )
        )
    )

    (def (ventilation-regulator regulator)
        (column
            :children (
                (setpoint regulator)
                (toggle regulator)
                (intensity regulator)
            )
        )
    )

    (def (ventilation-regulator-modal site regulator)
        (with-seed-color
            :seed-color ventilation-regulator-color
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-modal
                :site site
                :regulator regulator
                :param CO2
                :body (ventilation-regulator regulator)
            )
        )
    )
)
