(module widget.ventilation-regulator
    (export
        ventilation-regulator-color
        ventilation-regulator
    )

    (import i18n.status)

    (import lib.actions)
    (import lib.i18n)
    (import lib.property)

    (import widget.optimistic)
    (import widget.regulator-modal)
    (import widget.setpoint-slider)

    (def ventilation-regulator-color colors.light-green)

    (def (setpoint regulator)
        (setpoint-slider
            :value regulator.setpoint
            :param CO2
            :action (set-co2-setpoint regulator.id)
        )
    )

    (def (toggle regulator)
        (def state
            (optimistic
                :value regulator.ventilation
                :on-changed (toggle-ventilation regulator.id)
            )
        )
        (def (tile value)
            (list-tile
                :leading (icon
                    :icon (symbol 'power_settings_new)
                    :color current-theme.color-scheme.on-primary
                )
                :title (text
                    :content (select-locale (? value i18n-on i18n-off))
                    :style (text-style
                        :color current-theme.color-scheme.on-primary
                    )
                )
                :trailing (switch
                    :value value
                    :on-changed state.set-value
                )
            )
        )
        (listen tile state.value)
    )

    (def (segment i)
        (button-segment
            :label (text :content i)
            :value i)
    )

    (def (segments regulator)
        (map segment (range (length regulator.onVentilationIntensity)))
    )

    (def (intensity regulator)
        (def color current-theme.color-scheme.on-primary)
        (def color-variant (color.with :a 0.4))
        (def set-intensity (set-ventilation-intensity regulator.id))
        (def state
            (optimistic
                :value (# regulator.ventilation_intensity)
                :on-changed (\ (set) (set-intensity (@ set 0)))
            )
        )
        (def (tile value)
            (list-tile
                :leading (icon
                    :icon (symbol 'mode_fan_2)
                    :color current-theme.color-scheme.on-primary
                )
                :title (text
                    :content "Speed"
                    :style (text-style
                        :color current-theme.color-scheme.on-primary
                    )
                )
                :trailing (segmented-button
                    :selected value
                    :segments (segments regulator)
                    :empty-selection-allowed (is-empty value)
                    :on-selection-changed state.set-value
                    :style (segmented-button-style
                        :foreground-color color
                        :side (border-side
                            :color color-variant
                        )
                    )
                )
            )
        )
        (listen tile state.value)
    )

    (def (regulator-body regulator)
        (column
            :children (
                (setpoint regulator)
                (toggle regulator)
                (intensity regulator)
            )
        )
    )

    (def (ventilation-regulator site regulator)
        (with-seed-color
            :seed-color ventilation-regulator-color
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-modal
                :site site
                :regulator regulator
                :param CO2
                :body (regulator-body regulator)
            )
        )
    )
)
