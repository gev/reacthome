(module widget.multiroom-regulator-card
    (export multiroom-regulator-card)

    (import i18n.status)

    (import lib.action)
    (import lib.conversion)
    (import lib.data)
    (import lib.i18n)
    (import lib.optimistic)
    (import lib.navigation)
    (import lib.parameter)
    (import lib.system)

    (import widget.card)
    (import widget.entity-tile)
    (import widget.iconic)

    (def elevation-unbound 0)
    (def elevation-off 1)
    (def elevation-on 2)

    (def throttle-200
        (throttle (duration :milliseconds 200))
    )

    (def (multiroom-title props)
        (sized-box
            :width 180
            :child (entity-tile
                :icon (
                    :symbol multiroom.icon
                    :color current-theme.color-scheme.primary
                    :fill (? props.volume 1 0)
                )
                :label (:text props.label)
                :status (:text (round (?? props.status 0)))
            )
        )
    )

    (def (regulator props titles index on-changed volume)
        (inactive-card
            :key (concat props.id (concat "/" index))
            :elevation 1
            :card-color current-theme.color-scheme.surface
            :child (column
                :spacing 8
                :children (
                    (multiroom-title
                        :label (@ titles index)
                        :status volume
                    )
                    (horizontal-slider
                        :value volume
                        :min 0
                        :max 100
                        :width 168
                        :height 24
                        :focused-width 48
                        :border-radius 8
                        :active-color current-theme.color-scheme.primary
                        :on-changed on-changed
                    )
                )
            )
        )
    )

    (def (multiroom-tile props on-changed titles source index)
        (if source.active
            (let
                (def state
                    (optimistic
                        :value (to-percents source.volume)
                        :on-changed (\ (volume)
                            (throttle-200 (on-changed index (from-percents volume)))
                        )
                    )
                )
                (listen (regulator props titles index state.set-value) state.value)
            )
        )
    )

    (def (set-volume index volume i zone)
        (if (== index i)
            (
                :active zone.active
                :volume volume
            )
            zone
        )
    )
    
    (def (bound-multiroom-regulator-card props zone lanamp)
        (def set-source (set-multiroom-zone-source zone.id))
        (def (set-volume index volume)
            (def source
                (zip-with
                    (set-volume index volume)
                    (range (length zone.source))
                    zone.source
                )
            )
            (set-source source)
        )
        (wrap
            :spacing 8
            :run-spacing 8
            :children (zip-with
                (multiroom-tile props set-volume lanamp.source)
                zone.source
                (range (length zone.source))
            )
        )
    )

    (def (unbound-multiroom-regulator-card props)
        (inactive-card
            :key props.id
            :tag props.id
            :card-color current-theme.color-scheme.surface-variant
            :elevation elevation-unbound
            :child (disabled-entity-tile
                :icon (:symbol multiroom.icon)
                :label (:text (title props))
                :status (:text (select-locale i18n-not-available))
            )
        )
    )

    (def (multiroom-regulator-card props)
        (if (exists? props.bind)
            (let
                (def zone (remote-persistent-state props.bind))
                (def lanamp (remote-persistent-state (take 23 props.bind)))
                (listen (bound-multiroom-regulator-card props) zone lanamp)
            )
            (unbound-multiroom-regulator-card props)
        )
    )
)
