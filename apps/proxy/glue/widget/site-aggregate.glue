(module widget.site-aggregate
    (export site-aggregate)

    (import lib.combinator)
    (import lib.property)

    (def (fixed value)
        (/ (round (* value 10)) 10)
    )

    (def (empty value)
        (:value value :count 0 :total 0)
    )

    (def (monoid op prop acc val)
        (def value (@ val prop))
        (if (is-exist value)
            (
                :value (op acc.value value)
                :count (? value (+ acc.count 1) acc.count)
                :total (+ acc.total 1)
            )
            (acc)
        )
    )

    (def (state prop site)
        (def keys (@ site prop))
        (if (is-exist keys)
            (map remote-persistent-state keys)
            ()
        )
    )

    (def (states prop sites)
        (map (state prop) sites)
    )

    (def (aggregate-lights props lights)
        (def acc (foldl (monoid || light.property) (empty false) lights))
        (if (> acc.total 0)
            (props.parameter
                :label light.label
                :icon (
                    :symbol light.icon
                    :fill (? acc.value 1 0)
                )
                :value acc.count
            )
            ()
        )
    )

    (def (aggregate-sensors props param)
        (def acc (foldl (monoid + param.property) (empty 0) props.acc))
        (if (> acc.total 0)
            (props.parameter
                :label param.label
                :icon (
                    :symbol (param.icon)
                    :fill false
                )
                :value (fixed acc.value)
            )
            ()
        )
    )

    (def (aggregate props)
        (def lights_220 (states 'light_220 props.acc))
        (def lights_LED (states 'light_LED props.acc))
        (def lights_all (flatten (# lights_220 lights_LED)))
        (def children (flatten
                (#
                    (if (is-exist lights_all)
                        (listen (aggregate-lights props) lights_all)
                        ()
                    )
                    (aggregate-sensors props temperature)
                    (aggregate-sensors props humidity)
                    (aggregate-sensors props CO2)
                )
            )
        )
        (if (is-exist children)
            (props.container :children children)
            (sized-box :width 0 :height 0)
        )
    )

    (def (has-children site)
        (is-exist site.site)
    )

    (def (get-children site)
        (site.site)
    )

    (def (aggregate-gen rec props)
        (def (go sites)
            (def sites-with-children (filter has-children sites))
            (def children (map get-children sites-with-children))
            (rec
                :container props.container
                :parameter props.parameter
                :sites (flatten children)
                :acc (concat props.acc sites)
            )
        )
        (if (is-empty props.sites)
            (aggregate props)
            (listen go (map remote-persistent-state props.sites))
        )
    )

    (def site-aggregate (Z aggregate-gen))
)
