(module widget.video-player
    (export video-player)

    (import lib.action)

    (def ice-servers (
            (ice-server :urls "stun:gate.reacthome.net")
            (ice-server
                :urls "turn:gate.reacthome.net"
                :username "react"
                :credential "home"
            )
        ))

    (def (video-player props)
        (webrtc-video-player
            :session-id props.url
            :width props.width
            :height props.height
            :fit props.fit
            :ice-transport-policy ice-transport-policy.all
            :on-start (webrtc-watch :url props.url)
        )
    )
)
 