(module widget.video-player
    (export video-player)

    (import lib.action)

    (def (video-player props)
        (webrtc-video-player
            :session-id props.url
            :width props.width
            :height props.height
            :fit props.fit
            :on-start (webrtc-watch props.url)
        )
    )
)
 