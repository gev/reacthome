(module widget.site-header
    (export site-header)

    (import lib.data)
    (import lib.navigation)

    (import widget.floating-bar)
    (import widget.site-breadcrumbs)
    (import widget.site-info)

    (def (site-image props)
        (if (exists? props.image)
            (image
                :height props.height
                :width props.width
                :fit box-fit.cover
                :image (load-image :src props.image)
            )
            (sized-box :height (+ media-query.padding.top 48))
        )
    )

    (def (site-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props)
                :style current-theme.text-theme.headline-large
            )
        )
    )

    (def (site-description props)
        (column
            :spacing 16
            :main-axis-size main-axis-size.max
            :main-axis-alignment main-axis-alignment.end
            :cross-axis-alignment cross-axis-alignment.start
            :children (
                (site-title props)
                (site-breadcrumbs
                    :site props.parent
                    :action (\ (id) (go :route 'site :id id))
                )
                (site-info :site props.id)
            )
        )
    )

    (def (site-header props)
        (sized-box
            :width props.width
            :height props.height
            :child (stack
                :children(
                    (site-image props)
                    (padding
                        :padding (edge-insets-only
                            :top (+ media-query.padding.top 96)
                            :left 8
                            :right 8
                            :bottom 16
                        )
                        :child (site-description props)
                    )
                )
            )
        )
    )
)
