(module widget.light-regulator
    (export light-regulator)

    (import i18n.status)

    (import lib.actions)
    (import lib.conversion)
    (import lib.data)
    (import lib.property)

    (import widget.entity-modal)

    (def (regulator-modal props on-changed value)
        (def background-color
            (if value
                current-theme.color-scheme.surface-bright
                current-theme.color-scheme.surface-dim
            )
        )
        (entity-modal
            :site props.site
            :background-color background-color
            :title (title props)
            :display (round-to-resolution value light.resolution)
            :body (vertical-slider
                :value value
                :min 0
                :max 100
                :width 60
                :height 200
                :focused-width 90
                :border-radius 30
                :active-color (@ current-theme.color-scheme light.color)
                :on-changed on-changed
            )
        )
    )

    (def (light-regulator props bind)
        (def dim-light (dim props.id))
        (def value (local-state (to-percents bind.value)))
        (def (on-changed v)
            (write value v)
            (dim-light v)
        )
        (listen (regulator-modal props on-changed) value)
    )
)
