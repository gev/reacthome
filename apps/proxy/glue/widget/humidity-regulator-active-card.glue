(module widget.humidity-regulator-active-card
    (export humidity-regulator-active-card)

    (import lib.parameter)

    (import widget.regulator-title)
    (import widget.regulator-active-card)
    (import widget.humidity-regulator)

    (def (humidity-regulator-active-card site regulator)
        (with-seed-color
            :key regulator.id
            :seed-color humidity-regulator-color
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-active-card
                :tag regulator.id
                :title (regulator-title
                    :param humidity
                    :value (@ site humidity.property)
                )
                :body (humidity-regulator regulator)
            )
        )
    )
)
