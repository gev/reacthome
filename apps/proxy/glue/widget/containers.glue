(module widget.containers
    (export
        select-in-column
        select-in-row
        select-in-grid
    )

    (import lib.data)
    (import widget.grid)

    (def (select-in-column go items)
        (if (is-exist items)
            (column
                :spacing 16
                :children (map (select go) items)
            )
        )
    )

    (def (select-in-row go items)
        (if (is-exist items)
            (row
                :spacing 16
                :children (map (select go) items)
            )
        )
    )

    (def (select-in-grid go items)
        (if (is-exist items)
            (grid
                :spacing 16
                :children (map (select go) items)
            )
        )
    )
)
