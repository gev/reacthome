(module widget.containers
    (export
        select-in-column
        select-in-row
        select-in-wrap
    )

    (import lib.data)

    (def (select-in-column go items)
        (if (is-exist items)
            (column
                :spacing 16
                :children (map (select go) items)
            )
        )
    )

    (def (select-in-row go items)
        (if (is-exist items)
            (row
                :spacing 16
                :children (map (select go) items)
            )
        )
    )

    (def (select-in-wrap go items)
        (if (is-exist items)
            (wrap
                :spacing 16
                :run-spacing 16
                :children (map (select go) items)
            )
        )
    )
)
