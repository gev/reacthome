(module widget.screen
    (export screen)

    (import widget.app-bar)
    (import widget.screen-size)

    (def (screen props)
        (material
            :color current-theme.color-scheme.surface-container
            :child (stack
                :children (
                    (props.background)
                    (props.body)
                    (positioned
                        :top (+ media-query.padding.top 16)
                        :left 16
                        :right 16
                        :child (app-bar
                            :title props.title
                            :trailing ((screen-size _))
                        )
                    )
                )
            )
        )
    )
)
