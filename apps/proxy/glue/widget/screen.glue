(module widget.screen
    (export screen)

    (import widget.app-bar)

    (def (screen props)
        (print media-query.padding)
        (material
            :color current-theme.color-scheme.surface-container
            :child (container
                :child (stack
                    :children (
                        (props.body)
                        (positioned
                            :top 16
                            :left 16
                            :right 16
                            :child (app-bar _)
                        )
                    )
                )
            )
        )
    )
)
