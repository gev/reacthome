(module widget.screen
    (export screen)

    (import widget.app-bar)
    (import widget.compact-nav-bar)
    (import widget.session)

    (def (screen props)
        (material
            :color theme.color-scheme.secondary-container
            :child (stack
                :children (
                    (props.body)
                    (session-status
                        :connected-position -48
                        :disconnected-position 12
                    )
                    (positioned
                        :top 16
                        :left 16
                        :right 16
                        :child (app-bar _)
                    )
                    (positioned
                        :bottom 16
                        :left 16
                        :right 16
                        :child (container
                            :alignment alignment.center
                            :child (container :child(nav-bar _))
                        )
                    )
                )
            )
        )
    )
)
