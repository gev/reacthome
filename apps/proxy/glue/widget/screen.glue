(module widget.screen
    (export screen)

    (import widget.app-bar)
    (import widget.connection-indicator)

    (def (screen props)
        (material
            :color current-theme.color-scheme.surface-container
            :child (stack
                :children (
                    (props.background)
                    (props.body)
                    (if (exists? props.app-bar)
                        (positioned
                            :top (+ media-query.padding.top 16)
                            :left 16
                            :right 16
                            :child props.app-bar
                        )
                    )
                    (if (exists? props.nav-bar)

                        (positioned
                            :bottom 16
                            :left 16
                            :right 16
                            :child (container
                                :alignment alignment.center
                                :child props.nav-bar
                            )
                        )
                    )
                    (connection-indicator
                        :connected-position -48
                        :disconnected-position (+ media-query.padding.top 12)
                    )
                )
            )
        )
    )
)
