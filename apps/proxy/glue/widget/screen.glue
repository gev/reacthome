(module widget.screen
    (export screen)

    (import widget.session)

    (def (screen props)
        (material
            :color theme.color-scheme.surface-container
            :child (stack
                :children (
                    (props.body)
                    (session-status
                        :connected-position -32
                        :disconnected-position 32
                    )
                )
            )
        )
    )
)
