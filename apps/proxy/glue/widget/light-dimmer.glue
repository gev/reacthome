(module widget.light-dimmer
    (export show-light-dimmer)

    (import lib.log)

    (def (light-dimmer-dialog props)
        (alert-dialog
            :content (vertical-slider
                :value props.value
                :min 0
                :max 100
                :jump-to-tap false
                :display-value false
                :on-changed (\ (value) (log-info value))
            )
        )
    )

    (def (show-light-dimmer props)
        (\ ()
            (show-dialog (light-dimmer-dialog props))
        )
    )

)
