(module widget.light-dimmer
    (export show-light-dimmer)

    (import lib.actions)
    (import lib.data)
    (import lib.log)

    (def (light-dimmer props bind)
        (vertical-slider
            :value (to-percents bind.value)
            :min 0
            :max 100
            :on-changed (dim props.id)
            :jump-to-tap false
            :display-value false
        )
    )

    (def (light-dimmer-bottom-sheet props)
        (bottom-sheet
            :content (select (light-dimmer props) props.bind)
        )
    )

    (def (light-dimmer-dialog props)
        (alert-dialog
            :content (select (light-dimmer props) props.bind)
        )
    )

    (def (show-light-dimmer id)
        (\ ()
            (show-dialog
                :child (select light-dimmer-dialog id)
            )
            
        )
    )
)
