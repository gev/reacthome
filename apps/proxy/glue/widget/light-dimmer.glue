(module widget.light-dimmer
    (export show-light-dimmer)

    (import lib.log)

    (def (light-dimmer-dialog id)
        (alert-dialog
            :content (vertical-slider
                :value 50
                :min 0
                :max 100
                :jump-to-tap false
                :display-value false
                :on-changed (\ (value) (log-info value))
            )
        )
    )

    (def (show-light-dimmer id)
        (\ ()
            (show-dialog
                :dialog (light-dimmer-dialog id
                )
            )
        )
    )

)
