(module widget.app-bar
    (export app-bar)

    (import lib.navigation)
    (import widget.floating-bar)

    (def (app-bar props)
        (row
            :main-axis-size main-axis-size.min
            :children (
                (? (can-pop)
                    (floating-bar
                        :child (back-button _)
                    )
                )
            )
        )
    )
)
