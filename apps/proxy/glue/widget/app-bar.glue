(module widget.app-bar
    (export app-bar)

    (import lib.navigation)
    (import widget.floating-bar)

    (def (section child)
        (floating-bar
            :child child
        )
    )

    (def (app-bar props)
        (row
            :spacing 16
            :cross-axis-alignment cross-axis-alignment.center
            :main-axis-alignment main-axis-alignment.space-between
            :children (flatten
                (
                    (if (can-pop? _)
                        (floating-bar
                            :child (back-button :on-pressed back)
                        )
                        (sized-box :width 48)
                    )
                    (?> (map section) props.leading)
                    (?> section props.title)
                    (?> (map section) props.trailing)
                )
            )
        )
    )
)
