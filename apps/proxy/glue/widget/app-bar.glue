(module widget.app-bar
    (export app-bar)

    (import lib.navigation)
    (import widget.floating-bar)
    (import widget.screen-size)

    (def (section child)
        (floating-bar
            :child child
        )
    )

    (def (app-bar props)
        (row
            :spacing 4
            :main-axis-alignment main-axis-alignment.space-between
            :cross-axis-alignment cross-axis-alignment.center
            :children (
                (row
                    :spacing 4
                    :main-axis-size main-axis-size.min
                    :cross-axis-alignment cross-axis-alignment.center
                    :children (flatten
                        (
                            (if (can-pop? _)
                                (floating-bar
                                    :child (back-button :on-pressed back)
                                )
                            )
                            (single-child-scroll-view
                                :scroll-direction axis.horizontal
                                :child (row
                                    :spacing 4
                                    :main-axis-size main-axis-size.min
                                    :cross-axis-alignment cross-axis-alignment.center
                                    :children (?> (map section) props.leading)
                                )
                            )
                        )
                    )
                )
                (row
                    :spacing 16
                    :cross-axis-alignment cross-axis-alignment.center
                    :children (flatten
                        (
                            (?> (map section) props.trailing)
                            (section (screen-size _))
                        )
                    )
                )
            )
        )
    )
)
