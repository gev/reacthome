(module widget.site-breadcrumbs
    (export site-breadcrumbs)

    (import lib.data)

    (def (passive-segment props)
        (outlined-button
            :child (text
                :content (title props)
            )
        )
    )

    (def (active-segment action props)
        (outlined-button
            :style (button-style
                :foreground-color theme.color-scheme.on-surface-variant
            )
            :on-pressed (action props.id)
            :child (text
                :content (title props)
            )
        )
    )

    (def (combine items)
        (wrap
            :spacing 4
            :children items
        )
    )

    (def (parent3 segment item1 item2 props)
        (def item3 (segment props))
        (if (is-exist props.parent)
            (combine (# item1 item2 item3 (segment :title "...")))
            (combine (# item1 item2 item3))
        )
    )

    (def (parent2 segment item1 props)
        (def item2 (segment props))
        (if (is-exist props.parent)
            (select (parent3 segment item1 item2) props.parent)
            (combine (# item1 item2))
        )
    )

    (def (parent1 segment props)
        (def item1 (segment props))
        (if (is-exist props.parent)
            (select (parent2 segment item1) props.parent)
            (combine (# item1))
        )
    )

    (def (site-breadcrumbs props)
        (def segment
            (if (is-exist props.action)
                (active-segment props.action)
                (passive-segment)
            )
        )
        (if (is-exist props.site)
            (select (parent1 segment) props.site)
        )
    )
)
