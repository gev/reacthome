(module widget.site-breadcrumbs
    (export site-breadcrumbs)

    (import lib.combinator)
    (import lib.data)

    (def (passive-segment color props)
        (outlined-button
            :style (button-style
                :side (border-side
                    :color (?? color
                        current-theme.color-scheme.outline)
                )
                :foreground-color (?? color
                    current-theme.color-scheme.on-surface-variant)
            )
            :child (text
                :content (title props)
            )
        )
    )

    (def (active-segment action color props)
        (outlined-button
            :style (button-style
                :foreground-color (?? color
                    current-theme.color-scheme.on-surface-variant)
            )
            :on-pressed (action props.id)
            :child (text
                :content (title props)
            )
        )
    )

    (def (combine items)
        (wrap
            :alignment wrap-alignment.center
            :spacing 4
            :run-spacing 8
            :children items
        )
    )

    (def (breadcrumbs-gen rec props)
        (def (go i)
            (rec
                :segment props.segment
                :site i.parent
                :acc (append props.acc i)
            )
        )
        (if (is-exist props.site)
            (let
                (def site (remote-persistent-state props.site))
                (listen go site)
            )
            (if (not (is-empty props.acc))
                (combine (map props.segment props.acc))
            )
        )
    )

    (def breadcrumbs (Z breadcrumbs-gen))

    (def (site-breadcrumbs props)
        (def segment
            (if (is-exist props.action)
                (active-segment props.action props.color)
                (passive-segment props.color)
            )
        )
        (breadcrumbs
            :segment segment
            :site props.site
            :acc ()
        )
    )
)
