(module widget.site-breadcrumbs
    (export site-breadcrumbs)

    (import lib.combinator)
    (import lib.data)

    (def (passive-segment props)
        (outlined-button
            :child (text
                :content (title props)
            )
        )
    )

    (def (active-segment action props)
        (outlined-button
            :style (button-style
                :foreground-color theme.color-scheme.on-surface-variant
            )
            :on-pressed (action props.id)
            :child (text
                :content (title props)
            )
        )
    )

    (def (combine items)
        (wrap
            :spacing 4
            :children items
        )
    )

    (def (breadcrumbs-gen segment rec props)
        (def (go i)
            (def item (segment i))
            (def acc (append props.acc (# item)))
            (if (is-exist i.parent)
                (rec :site i.parent :acc acc)
                (combine acc)
            )
        )
        (maybe (view go) props.site)
    )

    (def (site-breadcrumbs props)
        (def segment
            (if (is-exist props.action)
                (active-segment props.action)
                (passive-segment)
            )
        )
        (def go (Z (breadcrumbs-gen segment)))
        (go :site props.site :acc ())
    )
)
