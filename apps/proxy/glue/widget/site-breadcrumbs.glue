(module widget.site-breadcrumbs
    (export site-breadcrumbs)

    (import lib.combinator)
    (import lib.data)

    (def (passive-segment props)
        (outlined-button
            :child (text
                :content (title props)
            )
        )
    )

    (def (active-segment action props)
        (outlined-button
            :style (button-style
                :foreground-color theme.color-scheme.on-surface-variant
            )
            :on-pressed (action props.id)
            :child (text
                :content (title props)
            )
        )
    )

    (def (combine items)
        (wrap
            :spacing 4
            :children items
        )
    )

    (def (breadcrumbs-gen rec props)
        (def (go i)
            (rec
                :segment props.segment
                :site i.parent
                :acc (append props.acc (# i))
            )
        )
        (if (is-exist props.site)
            (let (:site (remote-persistent-state props.site))
                (select go props.site)
            )
            (if (not (is-empty props.acc))
                (combine (map props.segment props.acc))
            )
        )
    )

    (def breadcrumbs (Z breadcrumbs-gen))

    (def (site-breadcrumbs props)
        (def segment
            (if (is-exist props.action)
                (active-segment props.action)
                (passive-segment)
            )
        )
        (breadcrumbs
            :segment segment
            :site props.site
            :acc ()
        )
    )
)
