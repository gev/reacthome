(module widget.cooling-regulator-system-card
    (export cooling-regulator-system-card)

    (import lib.mode)
    (import lib.parameter)

    (import widget.regulator-title)
    (import widget.regulator-system-card)
    (import widget.temperature-regulator)

    (def (cooling-regulator-system-card site regulator)
        (with-seed-color
            :key regulator.id
            :seed-color (temperature-regulator-color cooling-mode)
            :dynamic-scheme-variant dynamic-scheme-variant.content
            :child (regulator-system-card
                :tag regulator.id
                :title (regulator-title
                    :param temperature
                    :value (@ site temperature.property)
                )
                :body (cooling-regulator-system regulator)
            )
        )
    )
)
