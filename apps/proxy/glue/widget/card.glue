(module widget.card
    (export
        active-card
        inactive-card
    )

    (def (adopt child)
        (padding
            :padding (edge-insets-symmetric :horizontal 4 :vertical 4)
            :child child
        )
    )

    (def (inactive-card props)
        (hero
            :key props.key
            :tag props.tag
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :elevation props.elevation
                :child (adopt props.child)
            )
        )
    )

    (def (active-card props)
        (hero
            :key props.key
            :tag props.tag
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :child (ink-well
                    :on-tap props.on-pressed
                    :on-long-press props.on-long-press
                    :elevation props.elevation
                    :child (adopt props.child)
                )
            )
        )
    )
)
