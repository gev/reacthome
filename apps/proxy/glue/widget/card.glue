(module widget.card
    (export
        active-card
        inactive-card
    )

    (def (adopt child)
        (padding
            :padding (edge-insets-symmetric :horizontal 8 :vertical 8)
            :child child
        )
    )

    (def (inactive-card props)
        (card
            :key props.key
            :clip-behavior clip.anti-alias
            :color props.card-color
            :elevation props.elevation
            :child (adopt props.child)
        )
    )

    (def (active-card props)
        (hero
            :tag props.key
            :key props.key
            :child (card
                :clip-behavior clip.anti-alias
                :color props.card-color
                :child (ink-well
                    :on-tap props.on-pressed
                    :on-long-press props.on-long-press
                    :child (adopt props.child)
                )
            )
        )
    )
)
