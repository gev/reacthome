(module widget.regulator-tile
    (export regulator-tile)

    (import lib.conversion)
    (import lib.i18n)
    (import widget.tile)

    (def (setpoint props)
        (stack
            :alignment alignment.center
            :children (
                (circular-slider
                    :min (?? props.min 0)
                    :max (?? props.max 100)
                    :value props.value
                    :active-color (props.color.with :a 0.5)
                    :inactive-color (props.color.with :a 0.25)
                    :diameter 128
                    :width 4
                    :focused-width 4
                )
                (column
                    :children(
                        (text
                            :content props.value
                            :style (text-style
                                :font-size current-theme.text-theme.title-large.font-size
                                :color props.color
                            )
                        )
                        (text
                            :content props.unit
                            :style (text-style
                                :font-size current-theme.text-theme.title-small.font-size
                                :color props.color
                            )
                        )
                    )
                )
            )
        )
    )

    (def (regulator-tile props)
        (column
            :cross-axis-alignment cross-axis-alignment.start
            :children (
                (setpoint
                    :min props.param.min
                    :max props.param.max
                    :value (round-to-resolution props.setpoint.value props.param.resolution)
                    :color (?? props.setpoint.color
                        current-theme.color-scheme.on-surface-variant)
                    :unit props.param.unit
                )
                (tile
                    :icon (
                        :symbol props.param.icon
                        :color current-theme.color-scheme.on-primary
                    )
                    :label (
                        :text (select-locale props.param.label)
                        :color current-theme.color-scheme.on-primary
                    )
                    :status (
                        :text (round-to-resolution props.value props.param.resolution)
                        :color current-theme.color-scheme.on-primary
                    )
                    :details (
                        :text props.param.unit
                        :color current-theme.color-scheme.on-primary
                    )
                )
            )
        )
    )
)
