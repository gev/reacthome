(module iconic.bar
    (export iconic-horizontal-bar iconic-vertical-bar)

    (def weight 0.8)
    (def k-bar-length 0.5)
    (def k-bar-gap 0.35)

    (def (adjust props)
        (def size (* props.size weight))
        (def bar-length (* size k-bar-length))
        (def bar-gap (* size k-bar-gap))
        (
            :dx props.dx
            :dy props.dy
            :size size
            :bar-length bar-length
            :bar-gap bar-gap
        )
    )

    (def (iconic-horizontal-bar props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x (- p.dx p.bar-length)
                :y (- p.dy p.bar-gap)
            )
            (relative-line-to
                :dx p.size
                :dy 0
            )
            (relative-move-to
                :dx (- 0 p.size)
                :dy p.bar-gap
            )
            (relative-line-to
                :dx p.size
                :dy 0
            )
            (relative-move-to
                :dx (- 0 p.size)
                :dy p.bar-gap
            )
            (relative-line-to
                :dx p.size
                :dy 0
            )
        )
    )

    (def (iconic-vertical-bar props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x (- p.dx p.bar-gap)
                :y (- p.dy p.bar-length)
            )
            (relative-line-to
                :dx 0
                :dy p.size
            )
            (relative-move-to
                :dx p.bar-gap
                :dy (- 0 p.size)
            )
            (relative-line-to
                :dx 0
                :dy p.size
            )
            (relative-move-to
                :dx p.bar-gap
                :dy (- 0 p.size)
            )
            (relative-line-to
                :dx 0
                :dy p.size
            )
        )
    )
)
  