(module iconic.bar
    (export iconic-horizontal-bar iconic-vertical-bar)

    (def weight 0.8)
    (def k-bar-length 0.5)
    (def k-bar-gap 0.35)

    (def size (* props.size weight))
    (def bar-length (* size k-bar-length))
    (def bar-gap (* size k-bar-gap))
   

    (def (iconic-horizontal-bar props)
        (path props.style
            (move-to (- props.dx bar-length) (- props.dy bar-gap))
            (relative-line-to size 0)
            (relative-move-to (- 0 size) bar-gap)
            (relative-line-to size 0)
            (relative-move-to (- 0 size) bar-gap)
            (relative-line-to size 0)
        )
    )

    (def (iconic-vertical-bar)
        (path props.style
            (move-to (- props.dx bar-gap) (- props.dy bar-length))
            (relative-line-to 0 size)
            (relative-move-to bar-gap (- 0 size))
            (relative-line-to 0 size)
            (relative-move-to bar-gap (- 0 size))
            (relative-line-to 0 size)
        )
    )

  