(module iconic.plus
    (export iconic-plus iconic-cross)

    (def (iconic-plus props)
        (group
            (path props.style
                (move-to (- props.dx props.size) props.dy)
                (line-to (+ props.dx props.size) props.dy)
            )
            (path props.style
                (move-to props.dx (- props.dy props.size))
                (line-to props.dx (+ props.dy (* 1 props.size)))
            )
        )
    )

    (def (iconic-cross props)
        (path props.style
            (move-to (- props.dx props.size) (- props.dy props.size))
            (line-to (+ props.dx props.size) (+ props.dy props.size))
            (move-to (- props.dx props.size) (+ props.dy props.size))
            (line-to (+ props.dx props.size) (- props.dy props.size))
        )
    )
)
