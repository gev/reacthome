(module iconic.sign
    (export iconic-plus iconic-cross)

    (def (iconic-plus props)
        (def size (* props.size 0.5))
        (path props.style
            (move-to (- props.dx size) props.dy)
            (line-to (+ props.dx size) props.dy)
            (move-to props.dx (- props.dy size))
            (line-to props.dx (+ props.dy size))
        )
    )

    (def (iconic-cross props)
        (def size (* props.size 0.44))
        (path props.style
            (move-to (- props.dx size) (- props.dy size))
            (line-to (+ props.dx size) (+ props.dy size))
            (move-to (- props.dx size) (+ props.dy size))
            (line-to (+ props.dx size) (- props.dy size))
        )
    )
)
