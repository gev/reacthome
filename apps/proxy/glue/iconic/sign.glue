(module iconic.sign
    (export iconic-plus iconic-cross)

    (def (iconic-plus props)
        (def size (* props.size 0.5))
        (path props.style
            (move-to
                :x (- props.dx size)
                :y props.dy
            )
            (line-to
                :x (+ props.dx size)
                :y props.dy
            )
            (move-to
                :x props.dx
                :y (- props.dy size)
            )
            (line-to
                :x props.dx
                :y (+ props.dy size)
            )
        )
    )

    (def (iconic-cross props)
        (def size (* props.size 0.44))
        (path props.style
            (move-to
                :x (- props.dx size)
                :y (- props.dy size)
            )
            (line-to
                :x (+ props.dx size)
                :y (+ props.dy size)
            )
            (move-to
                :x (- props.dx size)
                :y (+ props.dy size)
            )
            (line-to
                :x (+ props.dx size)
                :y (- props.dy size)
            )
        )
    )
)
