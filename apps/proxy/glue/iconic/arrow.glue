(module iconic.arrow
    (export
        iconic-right-arrow
        iconic-left-arrow
        iconic-up-arrow
        iconic-down-arrow
    )


    (def (adjust props)
        (def weight 0.8)
        (def k-arrow-length 0.5)
        (def size (* props.size weight))
        (
            :dx props.dx
            :dy props.dy
            :size size
            :arrow-length (* size k-arrow-length)
        )
    )
    
    (def (iconic-right-arrow props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x (- p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x (+ p.dx p.arrow-length)
                :y p.dy
            )
            (move-to
                :x p.dx
                :y (- p.dy p.arrow-length)
            )
            (line-to
                :x (+ p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x p.dx
                :y (+ p.dy p.arrow-length)
            )
        )
    )

    (def (iconic-left-arrow props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x (+ p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x (- p.dx p.arrow-length)
                :y p.dy
            )
            (move-to
                :x p.dx
                :y (- p.dy p.arrow-length)
            )
            (line-to
                :x (- p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x p.dx
                :y (+ p.dy p.arrow-length)
            )
        )
    )

    (def (iconic-up-arrow props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x p.dx
                :y (+ p.dy p.arrow-length)
            )
            (line-to
                :x p.dx
                :y (- p.dy p.arrow-length)
            )
            (move-to
                :x (- p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x p.dx
                :y (- p.dy p.arrow-length)
            )
            (line-to
                :x (+ p.dx p.arrow-length)
                :y p.dy
            )
        )
    )

    (def (iconic-down-arrow props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x p.dx
                :y (- p.dy p.arrow-length)
            )
            (line-to
                :x p.dx
                :y (+ p.dy p.arrow-length)
            )
            (move-to
                :x (- p.dx p.arrow-length)
                :y p.dy
            )
            (line-to
                :x p.dx
                :y (+ p.dy p.arrow-length)
            )
            (line-to
                :x (+ p.dx p.arrow-length)
                :y p.dy
            )
        )
    )
)
