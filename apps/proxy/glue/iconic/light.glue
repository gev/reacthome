(module iconic.light
    (export iconic-lamp)

    (def (iconic-lamp props)
        (def size (* props.size 0.5))
        (path props.style
            (move-to
                :x (- props.dx size)
                :y props.dy
            )
            (line-to
                :x (+ props.dx size)
                :y props.dy
            )
            (move-to
                :x props.dx
                :y (- props.dy size)
            )
            (line-to
                :x props.dx
                :y (+ props.dy size)
            )
        )
    )
)
