(module iconic.curtain
    (export iconic-curtain)

    (def (iconic-curtain props)
        (def size (* props.size 0.44))
        (path props.style
            (move-to
                :x (- props.dx size)
                :y (- props.dy size)
            )
            (line-to
                :x (+ props.dx size)
                :y (+ props.dy size)
            )
            (move-to
                :x (- props.dx size)
                :y (+ props.dy size)
            )
            (line-to
                :x (+ props.dx size)
                :y (- props.dy size)
            )
        )
    )

)
