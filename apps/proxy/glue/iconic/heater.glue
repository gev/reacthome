(module iconic.heater
    (export iconic-heater)

    (def weight 0.9)
    (def k-heater-height 0.4)
    (def k-arc-radius (/ k-heater-height 2))

    (def (iconic-heater props)
        (def size (* props.size weight))
        (def heater-height (* size k-heater-height))
        (def arc-radius (* size k-arc-radius))
        (path props.style
            (move-to
                :x (+ props.dx (/ size 2))
                :y (- props.dy heater-height)
            )
            (relative-line-to
                :dx (- arc-radius size)
                :dy 0
            )
            (relative-arc-to-point
                :arc-end-delta (offset 0 heater-height)
                :radius (radius arc-radius)
                :clockwise false
            )
            (relative-line-to
                :dx (- size (* arc-radius 2))
                :dy 0
            )
            (relative-arc-to-point
                :arc-end-delta (offset 0 heater-height)
                :radius (radius arc-radius)
                :clockwise true
            )
            (relative-line-to
                :dx (- arc-radius size)
                :dy 0
            )
        )
    )
)
