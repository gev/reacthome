(module iconic.delay
    (export iconic-delay)

    (def weight 0.75)
    (def k-delay-position 0.1)
    (def k-delay-height 0.2)

    (def (adjust props)
        (def size (* props.size weight))
        (def delay-position (* size k-delay-position))
        (def delay-height (* size k-delay-height))
        (
            :dx props.dx
            :dy props.dy
            :size size
            :delay-position delay-position
            :delay-height delay-height
        )
    )

    (def (iconic-delay props)
        (def p (adjust props))
        (path props.style
            (move-to
                :x (- p.dx (/ p.size 2))
                :y (+ p.dy p.delay-position)
            )
            (relative-line-to
                :dx p.size
                :dy 0
            )
            (relative-line-to
                :dx 0
                :dy (- 0 p.delay-height)
            )
        )
    )
)

  