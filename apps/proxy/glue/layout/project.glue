(module layout.project
    (export project-layout)

    (import lib.layout)

    (def (xs-layout props constraints)
        (import layout.project-xs)
        (xs-project-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.project-md)
        (md-project-layout props constraints)
    )

    (def (project-layout home select panel)
        (def props (
                :home home
                :select-panel select
                :current-panel panel
            )
        )
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )
)
