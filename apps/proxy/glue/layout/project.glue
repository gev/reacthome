(module layout.project
    (export project-layout)

    (import lib.layout)

    (import screen.home)
    (import screen.systems)
    (import screen.weather)

    (def (xs-layout props constraints)
        (import layout.project-xs)
        (xs-project-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.project-md)
        (md-project-layout props constraints)
    )

    (def (project-layout props current-screen)
        (def props
            (concat props (
                    :current-screen current-screen
                    :screens (indexed-stack
                        :index current-screen
                        :children (
                            (weather-screen props)
                            (home-screen props)
                            (systems-screen props)
                        )
                    )
                )
            )
        )
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )
)
