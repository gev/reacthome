(module layout.project
    (export project-layout)

    (import lib.layout)

    (def (xs-layout home select-panel screen constraints)
        (import layout.project-xs)
        (xs-project-layout home select-panel screen constraints)
    )

    (def (md-layout home select-panel screen constraints)
        (import layout.project-md)
        (md-project-layout home select-panel screen constraints)
    )

    (def (project-layout home select-panel screen)
        (select-layout
            :xs (xs-layout home select-panel screen)
            :sm (xs-layout home select-panel screen)
            :md (md-layout home select-panel screen)
            :lg (md-layout home select-panel screen)
            :xl (md-layout home select-panel screen)
        )
    )
)
