(module layout.screen-md
    (export screen-layout-md)

    (import widget.screen)

    (def (screen-layout-md props)
        (screen
            :body (row
                :cross-axis-alignment cross-axis-alignment.stretch
                :children (
                    (expanded
                        :flex 1
                        :child props.header
                    )
                    (expanded
                        :flex 2
                        :child props.body
                    )
                )
            )
        )
    )
)
