(module  layout.weather-xs
    (export xs-weather-layout)

    (import lib.i18n)
    (import i18n.dict)
    (import widget.screen)

    (def (xs-weather-layout props constraints)
        (screen
            :body (center
                :child (text
                    :text (select-locale i18n-weather)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )
)
