(module  layout.systems-md
    (export md-systems-layout)

    (import i18n.dict)

    (import lib.i18n)
    (import lib.data)

    (import layout.screen-md)

    (def (site-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props)
                :style (text-style
                    :font-size current-theme.text-theme.headline-large.font-size
                    :color current-theme.color-scheme.on-primary-container
                )
            )
        )
    )

    (def (head props)
        (single-child-scroll-view
            :scroll-direction axis.horizontal
            :child (row
                :spacing 32
                :children (
                    (site-title props)
                )
            )
        )
    )

    (def (md-systems-layout props constraints)
        (md-screen-layout
            :header (head props)
            :body (center
                :child (text
                    :text (select-locale i18n-systems)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )
)
