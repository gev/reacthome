(module  layout.systems-md
    (export md-systems-layout)

    (import i18n.dict)
    (import i18n.system)

    (import lib.i18n)
    (import lib.data)
    (import lib.system)

    (import layout.screen-md)

    (import widget.selected-button)

    (def (site-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props)
                :style (text-style
                    :font-size current-theme.text-theme.headline-large.font-size
                    :color current-theme.color-scheme.on-primary-container
                )
            )
        )
    )

    (def (system props)
        (selected-button
            :label (select-locale props.label)
            :icon props.icon
            :selected-color current-theme.color-scheme.tertiary-container
            :unselected-color current-theme.color-scheme.surface-container
            :selected false
            :on-pressed (\ () ())
        )
    )
    
    (def (head props)
        (single-child-scroll-view
            :scroll-direction axis.horizontal
            :child (row
                :spacing 4
                :cross-axis-alignment cross-axis-alignment.center
                :children (prepend
                    (site-title props)
                    (map system (#
                            light
                            curtains
                            heating
                            cooling
                            wetting
                            ventilation
                            water
                            cameras
                        ))
                )
            )
        )
    )

    (def (right-panel props)
        (site-title props)
    )

    (def (main-panel props)
        (center
            :child (text
                :text (select-locale i18n-systems)
                :style current-theme.text-theme.display-medium
            )
        )
    )

    (def (body props)
        (padding
            :padding (edge-insets-only :top 128)
            :child (row
                :children (
                    (right-panel props)
                    (main-panel props)
                )
            )
        )
    )

    (def (md-systems-layout props constraints)
        (md-screen-layout
            :bottom 80
            :header (head props)
            :body (body props)
        )
    )
)
