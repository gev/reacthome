(module  layout.systems-md
    (export md-systems-layout)

    (import i18n.dict)
    (import i18n.system)

    (import lib.i18n)
    (import lib.data)
    (import lib.system)

    (import layout.screen-md)

    (import widget.selected-list-tile)

    (def systems (#
            light
            curtains
            heating
            cooling
            wetting
            ventilation
            water
            cameras
        ))

    (def (site-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props)
                :style (text-style
                    :font-size current-theme.text-theme.headline-medium.font-size
                    :color current-theme.color-scheme.on-primary-container
                )
            )
        )
    )

    (def (system props)
        (selected-list-tile
            :label (select-locale props.label)
            :icon props.icon
            :selected-color current-theme.color-scheme.tertiary-container
            :unselected-color current-theme.color-scheme.surface-container
            :selected false
            :on-tap (\ () ())
        )
    )
    
    (def (right-panel props)
        (filled-card
            :clip-behavior clip.anti-alias
            :color (current-theme.color-scheme.surface.with :a 0.4)
            :child (single-child-scroll-view
                :padding (edge-insets-symmetric :vertical 16)
                :child (column
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (flatten
                        (
                            (site-title props)
                            (divider _)
                            (map system systems)
                        )
                    )
                )
            )
        )
    )

    (def (main-panel props)
        (center
            :child (text
                :text (select-locale i18n-systems)
                :style current-theme.text-theme.display-medium
            )
        )
    )

    (def (body props)
        (row
            :cross-axis-alignment cross-axis-alignment.stretch
            :children (
                (expanded
                    :flex 1
                    :child (right-panel props)
                )
                (expanded
                    :flex 3
                    :child (main-panel props)
                )
            )
        )
    )

    (def (md-systems-layout props constraints)
        (md-screen-layout
            :app-bar (site-title props)
            :body (body props)
        )
    )
)
