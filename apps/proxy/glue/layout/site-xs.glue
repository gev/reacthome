(module layout.site-xs
    (export xs-site-layout)

    (import layout.screen-xs)
    (import widget.site-header)
    (import widget.site-body)

    (def (xs-site-layout palette props)
        (screen-layout-xs
            :body (single-child-scroll-view
                :padding (edge-insets-only :bottom 128)
                :child (column
                    :spacing 16
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (site-header props)
                        (site-body palette props)
                    )
                )
            )
        )
    )
)
