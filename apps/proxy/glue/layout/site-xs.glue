(module layout.site-xs
    (export xs-site-layout)

    (import widget.app-bar)
    (import widget.background)
    (import layout.screen-xs)
    (import widget.site-header)
    (import widget.site-body)
    

    (def (xs-site-layout palette props constraints)
        (xs-screen-layout
            :app-bar (app-bar _)
            :background (background _)
            :body (single-child-scroll-view
                :padding (edge-insets-only :bottom 128)
                :child (column
                    :spacing 16
                    :cross-axis-alignment cross-axis-alignment.start
                    :children (
                        (site-header props.site)
                        (site-body palette props.site)
                    )
                )
            )
        )
    )
)
