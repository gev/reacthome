(module layout.site-md
    (export md-site-layout)

    (import layout.screen-md)
    (import widget.site-header)
    (import widget.site-body)

    (def (md-site-layout palette props constraints)
        (screen-layout-md
            :header (site-header (concat props (:height constraints.height)))
            :body (single-child-scroll-view
                :padding (edge-insets-only :bottom 128)
                :child (site-body palette props)
            )
        )
    )
)
