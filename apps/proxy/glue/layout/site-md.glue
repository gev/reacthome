(module layout.site-md
    (export md-site-layout)

    (import lib.action)
    (import lib.data)
    (import lib.navigation)

    (import layout.screen-md)

    (import widget.site-breadcrumbs)
    (import widget.site-card)
    (import widget.site-info)
    (import widget.site-brief)
    (import widget.light-regulator-active-card)
    (import widget.curtain-regulator-active-card)
    (import widget.camera-card)
    (import widget.temperature-regulator-active-card)
    (import widget.humidity-regulator-active-card)
    (import widget.ventilation-regulator-active-card)

    (def (scrolled-column props)
        (single-child-scroll-view
            :child (container
                :width props.width
                :margin (edge-insets-all 16)
                :child (column
                    :spacing 8
                    :children props.children
                )
            )
        )
    )

    (def (camera palette props)
        (camera-card palette
            (concat props
                (:width 360 :height 200)
            )
        )
    )

    (def (scene props)
        (def label (text :text (title props)))
        (if (exists? props.action)
            (elevated-button
                :style (button-style
                    :foreground-color current-theme.color-scheme.on-surface
                    :background-color current-theme.color-scheme.surface
                )
                :on-pressed  (run-script props.id)
                :child label
            )
            (text-button
                :style (button-style
                    :elevation 0
                    :foreground-color current-theme.color-scheme.on-surface-variant
                )
                :child label
            )
        )
    )

    (def (site-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props)
                :style (text-style
                    :font-size current-theme.text-theme.headline-large.font-size
                    :color current-theme.color-scheme.on-tertiary-container
                )
            )
        )
    )

    (def (head props)
        (def scenes
            (select-collection scene props.site.scene)
        )
        (single-child-scroll-view
            :scroll-direction axis.horizontal
            :child (row
                :spacing 32
                :children (
                    (row
                        :main-axis-size main-axis-size.min
                        :children (
                            (site-title props.site)
                            (site-breadcrumbs
                                :color current-theme.color-scheme.on-tertiary-container
                                :site props.site.parent
                                :action go-site
                            )
                        )
                    )
                    (if (exists? scenes)
                        (row
                            :spacing 4
                            :main-axis-size main-axis-size.min
                            :children scenes
                        )
                    )
                )
            )
        )
    )

    (def (body palette props)
        (def info
            (site-info :site props.site.id)
        )
        (def light-220
            (select-collection light-regulator-active-card props.site.light_220)
        )
        (def light-led
            (select-collection light-regulator-active-card props.site.light_LED)
        )
        (def curtains
            (select-collection curtain-regulator-active-card props.site.curtains)
        )
        (def cameras
            (select-collection (camera palette) props.site.camera)
        )
        (def temperature-regulator
            (select-collection (temperature-regulator-active-card props.site) props.site.thermostat)
        )
        (def humidity-regulator
            (select-collection (humidity-regulator-active-card props.site) props.site.hygrostat)
        )
        (def ventilation-regulator
            (select-collection (ventilation-regulator-active-card props.site) props.site.co2_stat)
        )
        (def sites
            (select-collection site-card props.site.site)
        )

        (def has-any (not (empty? (filter exists? (#
                            light-220
                            light-led
                            curtains
                            cameras
                            temperature-regulator
                            humidity-regulator
                            temperature-regulator
                        )))))

        (single-child-scroll-view
            :scroll-direction axis.horizontal
            :child (row
                :spacing 32
                :cross-axis-alignment cross-axis-alignment.start
                :children (
                    (scrolled-column
                        :width 360
                        :children (prepend info (?? cameras ()))
                    )
                    (if (|| (exists? light-220) (exists? light-led))
                        (scrolled-column
                            :width 200
                            :children (concat light-220 light-led)
                        )
                    )
                    (if (exists? temperature-regulator)
                        (scrolled-column
                            :width 360
                            :children temperature-regulator
                        )
                    )
                    (if (exists? humidity-regulator)
                        (scrolled-column
                            :width 360
                            :children humidity-regulator
                        )
                    )
                    (if (exists? ventilation-regulator)
                        (scrolled-column
                            :width 360
                            :children ventilation-regulator
                        )
                    )
                    (if (exists? curtains)
                        (scrolled-column
                            :width 420
                            :children curtains
                        )
                    )
                    (if (exists? sites)
                        (scrolled-column
                            :children sites
                        )
                    )
                )
            )
        )
    )
    
    (def (md-site-layout palette props constraints)
        (md-screen-layout
            :top 48
            :header (head props)
            :body (body palette props)
        )
    )
)
