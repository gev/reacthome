(module layout.ring
    (export ring-layout)

    (import lib.data)
    (import widget.ink-well-overlay)

    (def (camera props)
        (video-player
            :width media-query.size.width
            :height media-query.size.height
            :url (?? props.main_URL props.preview_URL)
        )

    )

    (def (ring-layout props)
        (print props)
        (stack
            :children (
                (if (exists? props.camera)
                    (select camera props.camera)
                )
                (positioned
                    :top 0 :bottom 0 :left 0 :right 0
                    :child (ink-well-overlay
                        :color colors.black
                        :title (title props)
                    )
                )
            )
        )
    )
)
