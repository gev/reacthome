(module layout.site
    (export site-layout)

    (import lib.layout)

    (def (xs-layout props)
        (import layout.site-xs)
        (xs-site-layout props)
    )

    (def (sm-layout props)
        (import layout.site-sm)
        (sm-site-layout props)
    )

    (def (md-layout props)
        (import layout.site-md)
        (md-site-layout props)
    )

    (def (lg-layout props)
        (import layout.site-lg)
        (lg-site-layout props)
    )

    (def (xl-layout props)
        (import layout.site-xl)
        (xl-site-layout props)
    )

    (def site-layout
        (select-layout
            :xs xs-layout
            :sm sm-layout
            :md md-layout
            :lg lg-layout
            :xl xl-layout
        )
    )
)
