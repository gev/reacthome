(module layout.site
    (export site-layout)

    (import lib.layout)
    (import widget.site-theme)

    (def (xs-layout props)
        (import layout.site-xs)
        (site-theme xs-site-layout props)
    )

    (def (sm-layout props)
        (import layout.site-sm)
        (site-theme sm-site-layout props)
    )

    (def (md-layout props)
        (import layout.site-md)
        (site-theme md-site-layout props)
    )

    (def (lg-layout props)
        (import layout.site-lg)
        (site-theme lg-site-layout props)
    )

    (def (xl-layout props)
        (import layout.site-xl)
        (site-theme xl-site-layout props)
    )

    (def site-layout
        (select-layout
            :xs xs-layout
            :sm sm-layout
            :md md-layout
            :lg lg-layout
            :xl xl-layout
        )
    )
)
