(module layout.site
    (export site-layout)

    (import lib.layout)
    (import widget.site-theme)

    (def (xs-layout props)
        (import layout.site-xs)
        (site-theme xs-site-layout props)
    )

    (def site-layout
        (select-layout
            :xs xs-layout
            :sm xs-layout
            :md xs-layout
            :lg xs-layout
            :xl xs-layout
        )
    )
)
