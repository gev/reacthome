(module  layout.systems
    (export systems-layout)

    (import lib.layout)

    (def (xs-layout props constraints)
        (import layout.system-xs)
        (xs-systems-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.systems-md)
        (md-systems-layout props constraints)
    )

    (def (systems-layout props project)
        (def props
            (concat props (:project project))
        )
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )
)
