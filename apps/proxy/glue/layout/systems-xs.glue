(module  layout.systems-xs
    (export xs-systems-layout)

    (import i18n.dict)
    (import i18n.system)

    (import lib.i18n)
    (import lib.data)
    (import lib.system)

    (import layout.screen-xs)

    (import widget.selected-button)

    (def (project-title props)
        (padding
            :padding (edge-insets-symmetric :horizontal 16)
            :child (text
                :text (title props.project)
                :style (text-style
                    :font-size current-theme.text-theme.headline-medium.font-size
                    :color current-theme.color-scheme.on-surface-container
                )
            )
        )
    )

    (def (system props system index)
        (selected-button
            :label (select-locale system.label)
            :icon system.icon
            :selected-color current-theme.color-scheme.tertiary-container
            :unselected-color current-theme.color-scheme.surface-container
            :selected (== props.current-screen index)
            :on-select (props.select-screen index)
        )
    )
    
    (def (header props)
        (column
            :cross-axis-alignment cross-axis-alignment.start
            :children(
                (project-title props)
                (single-child-scroll-view
                    :scroll-direction axis.horizontal
                    :child (padding
                        :padding (edge-insets-symmetric :vertical 16)
                        :child (row
                            :children (zip-with (system props) systems (range (length systems)))
                        )
                    )
                )
            )
        )
    )

    (def (xs-systems-layout body props constraints)
        (xs-screen-layout
            :top 128
            :bottom 128
            :header (header props)
            :footer (sized-box :height 80)
            :body body
        )
    )
)
