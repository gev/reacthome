(module  layout.systems-xs
    (export xs-systems-layout)

    (import lib.i18n)

    (import i18n.dict)
    (import i18n.systems)
    
    (import widget.screen)

    (def (xs-systems-layout props constraints)
        (screen
            :body (center
                :child (text
                    :text (select-locale i18n-systems)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )
)
