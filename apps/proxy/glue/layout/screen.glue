(module layout.screen
    (export screen-layout)

    (import widget.app-bar)
    (import widget.floating-bar)


    (def (screen-size props)
        (def size (media-query.size))
        (floating-bar
            :child (padding
                :padding (edge-insets-all 8)
                :child (row
                    :spacing 4
                    :children (
                        (text :text (round size.width))
                        (text :text "x")
                        (text :text (round size.height))
                    )
                )
            )
        )
    )

    (def (screen-layout props)
        (material
            :color current-theme.color-scheme.surface-container
            :child (stack
                :children (
                    (props.body)
                    (positioned
                        :top (+ media-query.padding.top 20)
                        :right 16
                        :child (screen-size _)
                    )
                    (positioned
                        :top (+ media-query.padding.top 16)
                        :left 16
                        :right 16
                        :child (app-bar _)
                    )
                )
            )
        )
    )
)
