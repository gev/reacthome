(module layout.project-xs
    (export xs-project-layout)

    (import screen.home)
    (import screen.systems)
    (import screen.weather)

    (import widget.compact-nav-bar)

    (def (xs-project-layout props constraints)
        (material
            :color current-theme.color-scheme.surface-container
            :child (container
                :child (stack
                    :children(
                        (indexed-stack
                            :index props.current-screen
                            :children (
                                (weather-screen props)
                                (home-screen props)
                                (systems-screen props)
                            )
                        )
                        (positioned
                            :bottom 16
                            :left 16
                            :right 16
                            :child (container
                                :alignment alignment.center
                                :child (nav-bar props)
                            )
                        )
                    )
                )
            )
        )
    )
)
