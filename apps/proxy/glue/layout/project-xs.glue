(module layout.project-xs
    (export xs-project-layout)

    (import widget.compact-nav-bar)

    (def (xs-project-layout props constraints)
        (material
            :color current-theme.color-scheme.surface-container
            :child (container
                :child (stack
                    :children (
                        (props.screens)
                        (positioned
                            :bottom 16
                            :left 16
                            :right 16
                            :child (container
                                :alignment alignment.center
                                :child (nav-bar props)
                            )
                        )
                    )
                )
            )
        )
    )
)
