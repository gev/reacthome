(module screen.curtain
    (export
        positioned-curtain-screen
        non-positioned-curtain-screen
    )

    (import lib.data)
    (import widget.screen)
    (import widget.curtain)

    (def (curtain-screen body args)
        (with-seed-color
            :seed-color args.palette.seed-color
            :dynamic-scheme-variant args.palette.dynamic-scheme-variant
            :child (select
                (\ (props)
                    (select (body props) props.bind)
                ) args.id
            )
        )
    )

    (def (positioned-curtain-screen args)
        (curtain-screen positioned-curtain args)
    )

    (def (non-positioned-curtain-screen args)
        (curtain-screen non-positioned-curtain args)
    )
)
