(module screen.curtain
    (export curtain-screen)

    (import lib.data)
    (import widget.screen)
    (import widget.curtain)

    (def (curtain-screen args)
        (with-theme
            :data args.theme
            :child         (select
                (\ (props)
                    (select (curtain props) props.bind)
                ) args.id
            )
        )
    )
)
