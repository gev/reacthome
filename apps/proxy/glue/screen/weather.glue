(module  screen.weather
    (export weather-screen)

    (import lib.layout)

    (def (xs-layout props constraints)
        (import layout.weather-xs)
        (xs-weather-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.weather-md)
        (md-weather-layout props constraints)
    )

    (def (weather-screen props)
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )
)
