(module  screen.weather
    (export weather-screen)

    (import lib.i18n)
    (import i18n.dict)
    (import layout.screen)

    (def (weather-screen args)
        (screen-layout
            :body (center
                :child (text
                    :text (select-locale i18n-weather)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )
)
