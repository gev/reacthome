(module screen.heater-regulator
    (export heater-regulator-screen)

    (import lib.data)
    (import widget.heater-regulator)

    (def (heater-regulator-screen args)
        (with-seed-color
            :seed-color args.palette.seed-color
            :dynamic-scheme-variant args.palette.dynamic-scheme-variant
            :child (select
                (\ (props)
                    (select (heater-regulator props) props.bind)
                ) args.id
            )
        )
    )
)
