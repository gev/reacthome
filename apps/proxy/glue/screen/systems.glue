(module  screen.systems
    (export systems-screen)

    (import lib.i18n)
    (import i18n.dict)
    (import widget.app-bar)
    (import widget.compact-nav-bar)
    (import widget.screen)

    (def (systems-screen props)
        (screen
            :app-bar (app-bar _)
            :nav-bar (nav-bar props)
            :body (center
                :child (text
                    :text (select-locale i18n-systems)
                    :style current-theme.text-theme.display-medium
                )
            )
        )
    )
)
