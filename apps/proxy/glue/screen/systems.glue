(module  screen.systems
    (export systems-screen)

    (import lib.data)
    (import lib.layout)

    (def (xs-layout props constraints)
        (import layout.systems-xs)
        (xs-systems-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.systems-md)
        (md-systems-layout props constraints)
    )

    (def (show props)
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )

    (def (systems-screen props)
        (select show props.id)
    )
)
