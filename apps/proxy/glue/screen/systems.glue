(module  screen.systems
    (export systems-screen)

    (import lib.data)
    
    (import layout.systems)

    (def screen
        (local-state 0)
    )

    (def (select-screen current)
        (\ ()
            (write screen current)
        )
    )

    (def (systems props current-screen)
        (def props
            (concat props (
                    :current-screen current-screen
                    :select-screen select-screen
                )
            )
        )
        (select (systems-layout props) props.id)
    )

    (def (systems-screen props)
        (listen (systems props) screen)
    )
)
