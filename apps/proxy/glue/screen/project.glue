(module screen.project
    (export project-screen)

    (import screen.home)

    (import widget.compact-nav-bar)
    (import widget.session)

    (def (show args screen)
        (screen args)
    )

    (def (project-screen args)
        (def screen (local-state home-screen))
        (material
            :color current-theme.color-scheme.surface-container
            :child (container
                :child (stack
                    :children (
                        (listen (show args) screen)
                        (positioned
                            :bottom 16
                            :left 16
                            :right 16
                            :child (container
                                :alignment alignment.center
                                :child (container :child(nav-bar _))
                            )
                        )
                        (session-status
                            :connected-position -48
                            :disconnected-position 12
                        )
                    )
                )
            )
        )
    )
)
