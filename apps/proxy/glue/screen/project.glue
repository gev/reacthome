(module screen.project
    (export project-screen)

    (import lib.layout)

    (def (xs-layout props constraints)
        (import layout.project-xs)
        (xs-project-layout props constraints)
    )

    (def (md-layout props constraints)
        (import layout.project-md)
        (md-project-layout props constraints)
    )

    (def (project-screen props args)
        (select-layout
            :xs (xs-layout props)
            :sm (xs-layout props)
            :md (md-layout props)
            :lg (md-layout props)
            :xl (md-layout props)
        )
    )
)
