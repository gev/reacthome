(module screen.project
    (export project-screen)

    (import screen.home)
    (import screen.site)

    (def (home-route args)
        (route
            :screen (home-screen 'proxy.b9b35b14-2d39-492c-ae72-48adfef50b8e)
        )
    )

    (def (site-route args)
        (route
            :screen (site-screen args)
        )
    )

    (def (project-screen args)
        (navigator
            :routes (
                :index home-route
                :site site-route
            )
        )
    )
)
