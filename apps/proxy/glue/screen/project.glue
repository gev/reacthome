(module screen.project
    (export project-screen)

    (import lib.data)

    (import layout.project)

    (import screen.project.home)
    (import screen.project.weather)
    (import screen.project.systems)

    (def screen
        (local-state 1)
    )

    (def (select-screen current)
        (\ ()
            (write screen current)
        )
    )

    (def (project props current-screen)
        (def props
            (concat props (
                    :current-screen current-screen
                    :select-screen select-screen
                )
            )
        )
        (def body (indexed-stack
                :index current-screen
                :children (
                    (project-weather-screen props)
                    (project-home-screen props)
                    (project-systems-screen props)
                )
            )
        )
        (project-layout body props)
    )

    (def (home props daemon)
        (def props
            (concat props (:id daemon.project))
        )
        (listen (project props) screen)
    )

    (def (project-screen props args)
        (def id (concat "proxy." props.home.id))
        (select (home props) id)
    )
)
