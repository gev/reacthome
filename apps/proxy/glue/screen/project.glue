(module screen.project
    (export project-screen)

    (import screen.home)
    (import screen.dashboard)
    (import screen.weather)

    (import widget.compact-nav-bar)
    (import widget.session)

    (def (show args select screen)
        (material
            :color current-theme.color-scheme.surface-container
            :child (container
                :child (stack
                    :children(
                        (indexed-stack
                            :index screen
                            :children (
                                (weather-screen _)
                                (home-screen _)
                                (dashboard-screen _)
                            )
                        )
                        (positioned
                            :bottom 16
                            :left 16
                            :right 16
                            :child (container
                                :alignment alignment.center
                                :child (nav-bar
                                    :screen screen
                                    :select select
                                )
                            )
                        )
                        (session-status
                            :connected-position -48
                            :disconnected-position 12
                        )
                    )
                )
            )
        )
    )

    (def (project-screen home args)
        (def screen
            (local-state 1)
        )
        (def (select current)
            (\ ()
                (write screen current)
            )
        )
        (listen (show args select) screen)
    )
)
