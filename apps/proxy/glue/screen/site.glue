(module screen.site
    (export site-screen)

    (import widget.site.list)
    (import lib.vision)

    (def (site-screen props)
        (screen
            :body (list-view
                :children (
                    (padding
                        :padding (edge-insets-all 16)
                        :child (text :content props.title)
                    )
                    (select-persistent
                        (\ (props) (site-list props.site))
                        'proxy.b9b35b14-2d39-492c-ae72-48adfef50b8e
                    )
                )
            )
        )
    )
)
