(module screen.site
    (export site-screen)

    (import widget.site.card)

    (def (site-screen props)
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :spacing 32
                    :children (
                        (listen
                            (lookup store.persistent "proxy.b9b35b14-2d39-492c-ae72-48adfef50b8e" ())
                            (\ (props)
                                (map
                                    (\ (site) (
                                            (listen
                                                (lookup store.persistent site ())
                                                site-card
                                            )
                                        )
                                    )
                                    props.site
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
