(module screen.site
    (export site-screen)

    (import widget.site.card)

    (def (site-screen props)
        (screen
            :body (column
                :main-axis-size main-axis-size.min
                :spacing 32
                :children (
                    (column
                        :spacing 16
                        :children (
                            (text
                                :content "Site!!!"
                            )
                            (text
                                :content "A site is a collection of pages and content that can be accessed by users."
                            )
                        )
                    )
                )
            )
        )
    )
)
