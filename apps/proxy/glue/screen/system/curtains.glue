(module screen.system.curtains
    (export system-curtains-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.curtain-regulator-active-card)

    (def (curtains-card props)
        (sized-box
            :width 300
            :child (curtain-regulator-active-card props)
        )
    )

    (def (curtains props)
        (wrap
            :spacing 8
            :run-spacing 8
            :children (select-collection curtains-card props.curtains)
        )
    )

    (def (system-curtains-screen props)
        (systems-aggregate
            :id props.id
            :systems ("curtains")
            :build (systems i18n-curtains curtains)
        )
    )
)
