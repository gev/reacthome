(module screen.system.curtains
    (export system-curtains-screen)

    (import i18n.system)

    (import lib.i18n)

    (def (system-curtains-screen props)
        (center
            :child (text
                :text (select-locale i18n-curtains)
                :style current-theme.text-theme.display-medium
            )
        )
    )
)
