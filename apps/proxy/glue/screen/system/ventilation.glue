(module screen.system.ventilation
    (export system-ventilation-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.ventilation-regulator-active-card)

    (def (ventilation-card site props)
        (sized-box
            :width 360
            :child (ventilation-regulator-active-card site props)
        )
    )

    (def (ventilation props)
        (wrap
            :children (select-collection (ventilation-card props) props.co2_stat)
        )
    )

    (def (system-ventilation-screen props)
        (systems-aggregate
            :id props.id
            :systems ("co2_stat")
            :build (systems i18n-ventilation ventilation)
        )
    )
)
