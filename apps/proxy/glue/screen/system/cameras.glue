(module screen.system.cameras
    (export system-cameras-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.camera-card)

    (def (camera-card props)
        (camera-card _
            (concat props
                (:width 360 :height 200)
            )
        )
    )

    (def (cameras props)
        (wrap
            :children (select-collection camera-card props.camera)
        )
    )

    (def (system-cameras-screen props)
        (systems-aggregate
            :id props.id
            :systems ("camera")
            :build (systems i18n-cameras cameras)
        )
    )
)
