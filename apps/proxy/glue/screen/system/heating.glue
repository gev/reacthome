(module screen.system.heating
    (export system-heating-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.heating-regulator-system-card)

    (def (heating props)
        (wrap
            :children (select-collection (heating-regulator-system-card props) props.thermostat)
        )
    )

    (def (system-heating-screen props)
        (systems-aggregate
            :id props.id
            :systems ("thermostat")
            :build (systems i18n-heating heating)
        )
    )
)
