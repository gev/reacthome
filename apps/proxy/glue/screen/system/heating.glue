(module screen.system.heating
    (export system-heating-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.temperature-regulator-active-card)

    (def (heating-card site props)
        (sized-box
            :width 360
            :child (temperature-regulator-active-card site props)
        )
    )

    (def (heating props)
        (wrap
            :children (select-collection (heating-card props) props.thermostat)
        )
    )

    (def (system-heating-screen props)
        (systems-aggregate
            :id props.id
            :systems ("thermostat")
            :build (systems i18n-heating heating)
        )
    )
)
