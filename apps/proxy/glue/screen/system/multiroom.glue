(module screen.system.multiroom
    (export system-multiroom-screen)

    (import i18n.system)

    (import lib.i18n)

    (def (system-multiroom-screen props)
        (center
            :child (text
                :text (select-locale i18n-multiroom)
                :style current-theme.text-theme.display-medium
            )
        )
    )
)
