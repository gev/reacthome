(module screen.system.multiroom
    (export system-multiroom-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.multiroom-regulator-card)

    (def (multiroom props)
        (wrap
            :children (select-collection
                multiroom-regulator-card props.multiroom)
        )
    )

    (def (system-multiroom-screen props)
        (systems-aggregate
            :id props.id
            :systems ("multiroom")
            :build (systems i18n-light multiroom)
        )
    )
)
