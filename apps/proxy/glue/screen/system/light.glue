(module screen.system.light
    (export system-light-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.light-regulator-active-card)

    (def (light-card props)
        (sized-box
            :width 180
            :child (light-regulator-active-card props)
        )
    )

    (def (light props)
        (column
            :children (
                (wrap
                    :children (select-collection light-card props.light_220)
                )
                (wrap
                    :children (select-collection light-card props.light_LED)
                )
            )
        )
    )

    (def (system-light-screen props)
        (systems-aggregate
            :id props.id
            :systems ("light_220" "light_LED")
            :build (systems i18n-light light)
        )
    )
)
