(module screen.system.water
    (export system-water-screen)

    (import i18n.system)

    (import lib.i18n)

    (def (system-water-screen props)
        (center
            :child (text
                :text (select-locale i18n-water)
                :style current-theme.text-theme.display-medium
            )
        )
    )
)
