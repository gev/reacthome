(module screen.system.water
    (export system-water-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.water-regulator-active-card)

    (def (water props)
        (column
            :spacing 16
            :children (water-regulator-card water-card props.leakage)
        )
    )

    (def (system-water-screen props)
        (systems-aggregate
            :id props.id
            :systems ("leakage")
            :build (systems i18n-water water)
        )
    )
)
