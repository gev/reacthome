(module screen.system.wetting
    (export system-wetting-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.humidity-regulator-active-card)

    (def (wetting-card site props)
        (sized-box
            :width 360
            :child (humidity-regulator-active-card site props)
        )
    )

    (def (wetting props)
        (wrap
            :children (select-collection (wetting-card props) props.hygrostat)
        )
    )

    (def (system-wetting-screen props)
        (systems-aggregate
            :id props.id
            :systems ("hygrostat")
            :build (systems i18n-light wetting)
        )
    )
)
