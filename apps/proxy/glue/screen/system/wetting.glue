(module screen.system.wetting
    (export system-wetting-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.humidity-regulator-system-card)

    (def (wetting props)
        (wrap
            :children (select-collection (humidity-regulator-system-card props) props.hygrostat)
        )
    )

    (def (system-wetting-screen props)
        (systems-aggregate
            :id props.id
            :systems ("hygrostat")
            :build (systems i18n-wetting wetting)
        )
    )
)
