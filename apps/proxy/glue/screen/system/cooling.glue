(module screen.system.cooling
    (export system-cooling-screen)

    (import i18n.system)

    (import lib.data)

    (import widget.systems)
    (import widget.systems-aggregate)
    (import widget.cooling-regulator-system-card)

    (def (cooling props)
        (wrap
            :spacing 8
            :run-spacing 8
            :children (select-collection (cooling-regulator-system-card props) props.thermostat)
        )
    )

    (def (system-cooling-screen props)
        (systems-aggregate
            :id props.id
            :systems ("thermostat")
            :build (systems i18n-cooling cooling)
        )
    )
)
