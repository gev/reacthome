(module screen.system.cooling
    (export system-cooling-screen)

    (import i18n.system)

    (import lib.i18n)

    (def (system-cooling-screen props)
        (center
            :child (text
                :text (select-locale i18n-cooling)
                :style current-theme.text-theme.display-medium
            )
        )
    )
)
