(module screen.curtain-demo
    (export curtain-demo-screen)

    (import lib.actions)
    (import lib.data)
    (import lib.log)

    (import widget.curtain)

    (def (show props)
        (props.curtain
            :value props.value
            :width 400
            :height props.height
            :active-color props.color
            :translucent true
            :jump-to-tap false
        )
    )

    (def (curtain-demo-screen props)
        (screen
            :body (stack
                :children (
                    (show
                        :value 0.75
                        :height 360
                        :curtain vertical-curtain
                        :color (rgba 0 155 155 200)
                    )
                    (show
                        :value 0.8
                        :height 330
                        :curtain double-horizontal-curtain
                        :color (rgba 255 255 255 100)
                    )
                    (show
                        :value 0.2
                        :height 300
                        :curtain right-curtain
                        :color (rgba 155 0 155 200)
                    )
                    (show
                        :value 0.2
                        :height 300
                        :curtain left-curtain
                        :color (rgba 155 155 0 230)
                    )
                )
            )
        )
    )
)
