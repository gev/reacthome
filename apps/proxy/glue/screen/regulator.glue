(module screen.regulator
    (export
        temperature-regulator-screen
        humidity-regulator-screen
        ventilation-regulator-screen
    )

    (import widget.temperature-regulator)
    (import widget.humidity-regulator)
    (import widget.ventilation-regulator)

    (def (regulator-screen handle args)
        (def regulator (remote-persistent-state args.id))
        (def site (remote-persistent-state args.site))
        (listen handle site regulator)
    )

    (def (temperature-regulator-screen args)
        (regulator-screen temperature-regulator args)
    )

    (def (humidity-regulator-screen args)
        (regulator-screen humidity-regulator args)
    )

    (def (ventilation-regulator-screen args)
        (regulator-screen ventilation-regulator args)
    )
)
