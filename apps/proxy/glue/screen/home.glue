(module screen.home
    (export home-screen)

    (import lib.vision)

    (def (home-screen props)
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :spacing 32
                    :children (
                        (listen
                            (lookup store.persistent 'proxy.b9b35b14-2d39-492c-ae72-48adfef50b8e (:title "test"))
                            (\ (props)
                                (
                                    (def title (if (props.title != "") (props.title) (props.code)))
                                    (column :spacing 16 :children (
                                            (text :content props.type)
                                            (text :content props.code)
                                            (text :content props.title)
                                            (text :content 1)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
