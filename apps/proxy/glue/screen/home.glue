(module screen.home
    (export home-screen)

    (import screen.daemon)
    (import screen.site)

    (def (daemon-route home args)
        (def id (concat "proxy." home.id))
        (route
            :screen (daemon-screen :id id)
        )
    )

    (def (site-route args)
        (route
            :screen (site-screen args)
        )
    )

    (def (home-screen home args)
        (navigator
            :routes (
                :index (daemon-route home)
                :site site-route
            )
        )
    )

)
