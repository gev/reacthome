(module screen.home
    (export home-screen)

    (import lib.data)
    (import layout.site)

    (def (project props args)
        (select (site-layout props) args.project)
    )

    (def (daemon props)
        (def id (concat "proxy." props.home.id))
        (select (project props) id)
    )

    (def (index-route props args)
        (route
            :screen (daemon props)
        )
    )

    (def (site-screen props args)
        (select (site-layout props) args.id)
    )

    (def (site-route props args)
        (route
            :screen (site-screen props args)
        )
    )

    (def (home-screen props)
        (navigator
            :routes (
                :index (index-route props)
                :site (site-route props)
            )
        )
    )
)
