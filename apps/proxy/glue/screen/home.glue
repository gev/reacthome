(module screen.home
    (export home-screen)


    (import lib.navigation)

    (import widget.screen)
    (import widget.iconic)

    (import iconic.sign)
    (import iconic.heater)
    (import iconic.arrow)

    (def icons (
            'iconic-arrow
            'iconic-heater
            'iconic-plus
            'iconic-cross
        ))

    (def (icon i)
        (iconic
            :icon i
            :size 60
        )
    )

    (def (home-screen props)
        (scaffold
            :body (single-child-scroll-view
                :child (wrap
                    :spacing 40
                    :run-spacing 40
                    :children (map icon icons)
                )
            )
        )
    )
)
