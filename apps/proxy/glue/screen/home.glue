(module screen.home
    (export home-screen)

    (import lib.navigation)
    (import widget.iconic)
    (import iconic.sign)

    (def (home-screen props args)
        (screen
            :body (column
                :spacing 80
                :children(
                    (text
                        :content props.title
                        :style theme.text-theme.headline-large
                    )
                    (iconic
                        :icon iconic-plus
                        :size 160
                    )
                    (iconic
                        :icon iconic-cross
                        :color theme.color-scheme.error
                        :size 160
                    )
                    (filled-button
                        :child (text :content "Press me")
                        :on-pressed (go :route 'project)
                    )
                )
            )
        )
    )
)
