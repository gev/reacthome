(module screen.light-dimmer
    (export light-dimmer-screen)

    (import lib.data)
    (import lib.log)
    (import widget.light-dimmer)

    (def (light-dimmer-screen args)
        (select
            (\ (props)
                (select (light-dimmer props) props.bind)
            ) args.id
        )
    )
)
