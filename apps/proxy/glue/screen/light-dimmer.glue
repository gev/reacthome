(module screen.light-regulator
    (export light-regulator-screen)

    (import lib.data)
    (import widget.light-regulator)

    (def (light-regulator-screen args)
        (with-seed-color
            :seed-color args.palette.seed-color
            :dynamic-scheme-variant args.palette.dynamic-scheme-variant
            :child (select
                (\ (props)
                    (select (light-regulator props) props.bind)
                ) args.id
            )
        )
    )
)
