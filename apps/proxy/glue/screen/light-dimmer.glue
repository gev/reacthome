(module screen.light-dimmer
    (export light-dimmer-screen)

    (import lib.data)
    (import widget.light-dimmer)

    (def (light-dimmer-screen args)
        (with-seed-color
            :seed-color args.palette.seed-color
            :dynamic-scheme-variant args.palette.dynamic-scheme-variant
            :child (select
                (\ (props)
                    (select (light-dimmer props) props.bind)
                ) args.id
            )
        )
    )
)
