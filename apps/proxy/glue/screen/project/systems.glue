(module  screen.project.systems
    (export project-systems-screen)

    (import lib.data)
    
    (import layout.systems)

    (import screen.system.light)
    (import screen.system.curtains)
    (import screen.system.cameras)
    (import screen.system.multiroom)
    (import screen.system.heating)
    (import screen.system.cooling)
    (import screen.system.wetting)
    (import screen.system.ventilation)
    (import screen.system.water)

    (def screen
        (local-state 0)
    )

    (def (select-screen current)
        (\ ()
            (write screen current)
        )
    )

    (def (systems props current-screen)
        (def props
            (concat props (
                    :current-screen current-screen
                    :select-screen select-screen
                )
            )
        )
        (def body (indexed-stack
                :index current-screen
                :children (
                    (system-light-screen props)
                    (system-curtains-screen props)
                    (system-cameras-screen props)
                    (system-multiroom-screen props)
                    (system-heating-screen props)
                    (system-cooling-screen props)
                    (system-wetting-screen props)
                    (system-ventilation-screen props)
                    (system-water-screen props)
                )
            )
        )
        (select (systems-layout body props) props.id)
    )

    (def (project-systems-screen props)
        (listen (systems props) screen)
    )
)
