(module  screen.project.weather
    (export project-weather-screen)

    (import i18n.weather)
    (import i18n.parameter)
    
    (import lib.i18n)
    (import lib.data)
    (import lib.conversion)
    (import lib.weather)
    (import lib.parameter)

    (import widget.screen)

    (def (background props constraints)
        (weather-background
            :width constraints.width
            :height constraints.height
            :weather-type props.appearance.background
        )
    )

    (def (title-style props)
        (text-style
            :font-size 100
            :font-weight font-weight.w700
            :color (props.appearance.foreground.with :a 0.75)
        )
    )

    (def (subtitle-style props)
        (text-style
            :font-size 100
            :font-weight font-weight.w100
            :color (props.appearance.foreground.with :a 0.4)
        )
    )

    (def (caption-style props)
        (text-style
            :font-size current-theme.text-theme.headline-large.font-size
            :color (props.appearance.foreground.with :a 0.9)
        )
    )

    (def (body-style props)
        (text-style
            :font-size current-theme.text-theme.headline-medium.font-size
            :color (props.appearance.foreground.with :a 0.9)
        )
    )

    (def (value props)
        (def value-style (?? props.value-style props.style))
        (def unit-style (?? props.unit-style props.style))
        (row
            :main-axis-size main-axis-size.min
            :cross-axis-alignment cross-axis-alignment.end
            :children (
                (if (< props.value 0)
                    (text
                        :text "−"
                        :style value-style
                    )
                )
                (if (> props.value 0)
                    (text
                        :text "+"
                        :style value-style
                    )
                )
                (text
                    :text (abs (round props.value))
                    :style value-style
                )
                (text
                    :text props.unit
                    :style unit-style
                )
            )
        )
    )

    (def (label props)
        (text
            :text (select-locale props.text)
            :style props.style
        )
    )
    
    (def (body location props)
        (def body-style (body-style props))
        (def caption-style (caption-style props))
        (def title-style (title-style props))
        (def subtitle-style (subtitle-style props))
        (column
            :spacing 32
            :main-axis-alignment main-axis-alignment.center
            :children (
                (if (exists? location)
                    (text
                        :text location
                        :style body-style
                    )
                )
                (value
                    :value props.temperature
                    :value-style title-style
                    :unit temperature.unit
                    :unit-style subtitle-style
                )
                (label
                    :text props.description
                    :style caption-style
                )
            )
        )
    )

    (def (show props)
        (def weather (weather props.weather))
        (screen
            :background (layout (background weather))
            :body (center
                :child (body (title props) weather)
            )
        )
    )

    (def (project-weather-screen props)
        (select show props.id)
    )
)
