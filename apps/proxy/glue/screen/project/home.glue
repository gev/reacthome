(module screen.project.home
    (export project-home-screen)

    (import lib.data)
    (import lib.navigation)
    
    (import layout.site)

    (def (project props)
        (select (site-layout props) props.id)
    )

    (def (index-route props args)
        (route
            :screen (project props)
        )
    )

    (def (site-screen props args)
        (select (site-layout props) args.id)
    )

    (def (site-route props args)
        (route
            :screen (site-screen props args)
        )
    )

    (def (project-home-screen props)
        (navigator
            :navigator-key project-navigator
            :routes (
                :index (index-route props)
                :site (site-route props)
            )
        )
    )
)
