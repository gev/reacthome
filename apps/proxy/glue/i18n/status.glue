(module i18n.status
    (export
        i18n-on
        i18n-off
        i18n-closed
        i18n-opened
        i18n-not-available
    )

    (def i18n-on (
            :en "On"
            :ru "Включено"
        ))

    (def i18n-off (
            :en "Off"
            :ru "Выключено"
        ))

    (def i18n-opened (
            :en "Opened"
            :ru "Открыто"
        ))

    (def i18n-closed (
            :en "Closed"
            :ru "Закрыто"
        ))

    (def i18n-not-available (
            :en "N/A"
            :ru "Н/Д"
        ))
)
