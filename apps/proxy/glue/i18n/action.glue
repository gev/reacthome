(module i18n.action
    (export
        i18n-turn-on
        i18n-turn-off
        i18n-close
        i18n-open
        i18n-stop
    )

    (def i18n-turn-on (
            :en "Turn on"
            :ru "Включить"
        ))

    (def i18n-turn-off (
            :en "Turn off"
            :ru "Выключить"
        ))

    (def i18n-open (
            :en "Open"
            :ru "Открыть"
        ))

    (def i18n-close (
            :en "Close"
            :ru "Закрыть"
        ))

    (def i18n-stop (
            :en "Stop"
            :ru "Остановить"
        ))
)
