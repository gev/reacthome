(let
    (
        :tile (\ (child color) (card
                :color color
                :child (container
                    :padding (padding-all 16)
                    :width 400
                    :child child
                )
            )
        )
    )
    (let
        (
            :send (\ () (back))
        )
    
        (screen
            :app-bar (app-bar :title (text :content "Чат с владельцем"))
            :body (column
                :main-axis-alignment main-axis-alignment.spaceAround
                :children (
                    (card :child (container
                            :max-width 400
                            :padding (padding-all 16)
                            :child (column :children (
                                    (text :content "Выбрать готовый шаблон")
                                    (tile (text :content "Вызвать скорую помощь") (rgba 128 255 128 100))
                                    (tile (text :content "Устройство не работает") (rgba 255 128 128 100))
                                    (tile (text :content "Нужна помощь") (rgba 255 255 128 100))
                                ))
                        ))
                    (search-bar
                        :hint-text "Напишите сообщение..."
                        :trailing (filled-button
                            :child (text :content "Отправить")
                            :on-pressed send)
                    )
                )
            )
        )
    )
)
