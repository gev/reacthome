(let
    (
        :go (\(r) (\() (push (route r))))
        :add-user
        (listen
            (lookup store.tmp "next" (screen placeholder))
            (\ (next) next))
        :edit-user
        (listen
            (lookup store.tmp "next" (screen placeholder))
            (\ (next) next))
        :delete-user
        (listen
            (lookup store.tmp "next" (screen placeholder))
            (\ (next) next))
        :tile (\ (child) (card
                :child (container
                    :padding (padding-all 16)
                    :width 320
                    :height 160
                    :child child
                )
            )
        )
    )
    (let
        (
            :user-tile
            (\
                (name e-mail role)
                (tile (column
                        :main-axis-alignment main-axis-alignment.spaceBetween
                        :cross-axis-alignment cross-axis-alignment.start
                        :children (
                            (row
                                :main-axis-alignment main-axis-alignment.spaceBetween
                                :children (
                                    (text :content "U")
                                    (badge :label (text :content role))
                                )
                            )
                            (text
                                :content name)
                            (text
                                :content e-mail)
                            (row
                                :main-axis-alignment main-axis-alignment.spaceBetween
                                :children (
                                    (outlined-button
                                        :child (text :content "Изменить")
                                        :on-pressed (go edit-user))
                                    (outlined-button
                                        :child (text :content "Удалить")
                                        :on-pressed (go delete-user))
                                )
                            )
                        )
                    ))
            )
        )
    
        (screen
            :app-bar (app-bar :title (text :content "Пользователи и роли"))
            :body (wrap
                :children (
                    (user-tile "Бондарев Алексей Николаевич" "bondar@gmail.com" "Владелец")
                    (user-tile "Бондарева Наталья Ивановна" "natasha83@gmail.com" "Владелец")
                    (user-tile "Бондарев Пётр Алексеевич" "petralex@gmail.com" "Ребёнок")
                    (user-tile "Бондарев Николай Сергеевич" "bondarev@gmail.com" "Пользователь")
                    (tile (center :child (filled-button
                                :child (text :content "Добавить")
                                :on-pressed (go add-user)))
                    )
                )
            )
        )
    )
)
