(listen (lookup store.tmp 'vision ()) (\ (vision) (
    (screen
        :body (center
            :child (
                column
                :main-axis-size main-axis-size.min
                :children (
                    (text :content "Салют, мир!!!")
                    (listen
                        (lookup store.tmp 'counter 0)
                        (\ (counter) (text :content counter))
                    )
                    (row
                        :main-axis-size main-axis-size.min
                        :children (
                            (filled-button
                                :child (text :content "Вперед >>")
                                :on-pressed (vision.go 'next))
                        )
                    )
                )
            )
        )
    )
)))
