(module screen.main
    (export main)

    (import lib.vision)
    (def main
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :children (
                        (text :content "Салют, мир!!!")
                        (listen
                            (lookup store.tmp 'data.counter 0)
                            (\ (counter) (text :content counter))
                        )
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (filled-button
                                    :child (text :content "Вперед >>")
                                    :on-pressed (go 'screen.next))
                            )
                        )
                    )
                )
            )
        )
    )
)
