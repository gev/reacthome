(module screen.next
    (export next)

    (import lib.vision)
    (def next
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :children (
                        (text :content "Привет, мир!")
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (button
                                    :child (text :content "< Назад")
                                    :on-pressed (\() (pop ())))
                                (filled-button
                                    :child (text :content "Далее >>")
                                    :on-pressed (go 'screen.next))
                            )
                        )
                    )
                )
            )
        )
    )
)
