(module screen.next
    (export next)

    (import lib.vision)

    (def (next go-back go-next)
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :children (
                        (text :content "Привет, мир!!!")
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (button
                                    :child (text :content "< Назад")
                                    :on-pressed go-back)
                                (filled-button
                                    :child (text :content "Далее >>")
                                    :on-pressed go-next)
                            )
                        )
                    )
                )
            )
        )
    )
)
