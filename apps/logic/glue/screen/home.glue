(module screen.home
    (export home-screen)

    (import lib.vision)

    (def (home-screen props)
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :children (
                        (text :content props.title)
                        (listen
                            (lookup store.tmp 'data.counter 0)
                            (\ (counter) (text :content counter))
                        )
                        (text :content (foo 100))
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (filled-button
                                    :child (text :content "Вперед >>")
                                    :on-pressed (go 'next))
                            )
                        )
                    )
                )
            )
        )
    )
)
