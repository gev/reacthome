(module screen.home
    (export home-screen)

    (import lib.vision)

    (def (home-screen props)
        (screen
            :body (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :spacing 32
                    :children (
                        (image
                            :image (asset-image :src "icon.png")
                            :width 100)
                        (text :text props.title)
                        (listen
                            (\ (counter) (text :text counter))
                            (lookup store.persistent 'data.counter 0)
                        )
                        (text :text (foo 100))
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (filled-button
                                    :child (text :text "Вперед >")
                                    :on-pressed (go 'next))
                            )
                        )
                    )
                )
            )
        )
    )
)
