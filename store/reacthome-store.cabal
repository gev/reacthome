cabal-version: 3.8
name: reacthome-store
version: 0.1.0.0
synopsis: Reacthome Store
description: Reacthome Store Server
license: BSD-3-Clause
author: ReactHome Team
maintainer: gazdovsky@gmail.com
category: Web
build-type: Simple

common common-options
  build-depends:
    base,
    ws,

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    ImplicitParams
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards

library
  import:
    common-options

  -- cabal-gild: discover src
  exposed-modules:
    Reacthome.Store.App

  build-depends:
    text,
    uuid,

  hs-source-dirs: src

executable reacthome-store
  import:
    common-options

  build-depends:
    reacthome-store

  hs-source-dirs: app
  main-is: Main.hs
