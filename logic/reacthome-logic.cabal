cabal-version: 3.8
name: reacthome-logic
version: 0.1.0.0
synopsis: Reacthome Logic
description: Reacthome Logic Server
license: BSD-3-Clause
author: ReactHome Team
maintainer: gazdovsky@gmail.com
category: Web
build-type: Simple

common common-options
  build-depends:
    base,
    ws,

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    ImplicitParams
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards

library
  import:
    common-options

  -- cabal-gild: discover src
  exposed-modules:
    Reacthome.Logic
    Reacthome.Logic.App
    Reacthome.Logic.Capabilities.Adjustable
    Reacthome.Logic.Capabilities.Switchable
    Reacthome.Logic.Core.Capabilities
    Reacthome.Logic.Core.Connector
    Reacthome.Logic.Core.Device
    Reacthome.Logic.Core.Net
    Reacthome.Logic.Core.Site
    Reacthome.Logic.Core.Store
    Reacthome.Logic.Error
    Reacthome.Logic.Server

  build-depends:
    async,
    bytestring,
    containers,
    text,
    unagi-chan,
    uuid,

  hs-source-dirs: src

executable reacthome-logic
  import:
    common-options

  build-depends:
    reacthome-logic

  hs-source-dirs: app
  main-is: Main.hs
