(
    (def prev (\ () (pop ())))
    (def next (\ ()
            (push
                (route
                    (listen
                        (lookup store.cache "next" placeholder)
                        (\ (main) main))))))
    (center
        :child (
            column
            :main-axis-size main-axis-size.min
            :children (
                (text :content "Привет, мир!")
                (row
                    :main-axis-size main-axis-size.min
                    :children (
                        (button
                            :child (text :content "< Назад")
                            :on-pressed prev)
                        (filled-button
                            :child (text :content "Далее >")
                            :on-pressed next)
                    )
                )
            )
        )
    )
)
