(let
    (
        :next-screen
        (listen
            (lookup store.cache "next" placeholder)
            (\ (next) next))
    )
    (let
        (
            :go-next (\ () (push (route next-screen)))
        )
        (screen
            (center
                :child (
                    column
                    :main-axis-size main-axis-size.min
                    :children (
                        (text :content "Привет, мир!")
                        (row
                            :main-axis-size main-axis-size.min
                            :children (
                                (filled-button
                                    :child (text :content "Далее >")
                                    :on-pressed go-next)
                            )
                        )
                    )
                )
            )
        )
    )
)
